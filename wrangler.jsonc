{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "seanbehan-ca",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],

	// Production traffic must arrive on the custom domains below (or their
	// www aliases) so the zone WAF, cache rules and redirects apply to every
	// request. A workers.dev or preview host reaches the Worker without the
	// zone, and both are inherited by the named `codebam` environment, so one
	// pair here turns them off for both deployments.
	"workers_dev": false,
	"preview_urls": false,

	// One database, both origins. The default environment is the writing and
	// commercial home; the `codebam` environment below is the handle portfolio
	// and redirects writing and commercial paths to seanbehan.ca rather than
	// publishing a second indexable copy.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "seanbehan-ca",
			"database_id": "39e5ca60-d101-4b0e-856b-85fa5d986cb0",
			"migrations_dir": "migrations/site",
			"migrations_table": "site_migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "seanbehan-ca-media"
		},
		// The résumé's home, and the reason /resume.pdf is a path rather than a
		// hostname: `private` has no public domain of its own, so the Worker is
		// the only way to resume.pdf and resume.html. Both are written by
		// .github/workflows/resume.yml from resume/resume.md — see docs/resume.md.
		{
			"binding": "RESUME",
			"bucket_name": "private"
		},
		// The paid product's immutable archive. The bucket keeps its historical
		// `codebam-product-downloads` name because the object keys inside it are
		// what old fulfillment links and the release manifest point at; the name
		// is internal and never reaches a buyer.
		{
			"binding": "DOWNLOADS",
			"bucket_name": "codebam-product-downloads"
		}
	],
	"images": {
		"binding": "IMAGES"
	},

	// Worker Loader for plugin sandboxing
	"worker_loaders": [
		{
			"binding": "LOADER"
		}
	],

	// Drives scheduled publishing, plugin cron, and maintenance (see src/worker.ts)
	"triggers": {
		"crons": ["* * * * *"]
	},

	// Cloudflare Email Sending: transport for EmDash's mail-dependent auth flows
	// (magic-link login, invites, password recovery), consumed by the
	// cloudflareEmail() provider in astro.config.mjs, plus the paid-order
	// fulfillment mail sent from the Stripe webhook. Both sending domains have
	// to be verified in the dashboard (Email → Email Sending) before anything
	// sends.
	"send_email": [
		{ "name": "EMAIL" },
		{
			"name": "ORDER_EMAIL",
			"allowed_sender_addresses": ["products@seanbehan.ca"]
		}
	],

	"observability": {
		"enabled": true,
		// Automatic invocation logs include URLs. Keep auth and download bearer
		// credentials out while retaining the application's sanitized logs.
		"logs": { "invocation_logs": false }
	},

	// `custom_domain` rather than a route pattern: Cloudflare then owns the DNS
	// record and certificate. The middleware permanently redirects www to the
	// apex, but both hostnames have to reach the Worker for it to do so.
	"routes": [
		{ "pattern": "seanbehan.ca", "custom_domain": true },
		{ "pattern": "www.seanbehan.ca", "custom_domain": true }
	],

	/*
	 * The handle-portfolio origin. Deployed with `wrangler deploy --env codebam`,
	 * which is what `npm run deploy:codebam` runs after building with
	 * PUBLIC_SITE=codebam. It serves the project case studies and 301s writing,
	 * the résumé and every commercial path to the default origin; it needs no
	 * Stripe secrets or order sender. The DOWNLOADS binding below is retained
	 * only because wrangler does not inherit bindings into a named environment,
	 * and the route guards return before any read can reach it.
	 *
	 * Shared bindings are repeated rather than inherited: wrangler does not carry
	 * d1_databases, r2_buckets or worker_loaders into a named environment.
	 */
	"env": {
		"codebam": {
			"name": "codebam-ca",
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "seanbehan-ca",
					"database_id": "39e5ca60-d101-4b0e-856b-85fa5d986cb0",
					"migrations_dir": "migrations/site",
					"migrations_table": "site_migrations"
				}
			],
			"r2_buckets": [
				{
					"binding": "MEDIA",
					"bucket_name": "seanbehan-ca-media"
				},
				// Inert on this Worker: the commerce routes 404 before touching it.
				{
					"binding": "DOWNLOADS",
					"bucket_name": "codebam-product-downloads"
				},
				// Not needed here — /resume is the seanbehan variant's page, and
				// codebam 301s it. Bound anyway, so that the two Workers describe
				// the same bucket the same way if the résumé ever does move.
				{
					"binding": "RESUME",
					"bucket_name": "private"
				}
			],
			"images": {
				"binding": "IMAGES"
			},
			"worker_loaders": [
				{
					"binding": "LOADER"
				}
			],
			"triggers": {
				"crons": ["* * * * *"]
			},
			"send_email": [{ "name": "EMAIL" }],
			"observability": {
				"enabled": true,
				"logs": { "invocation_logs": false }
			},
			"routes": [
				{ "pattern": "codebam.ca", "custom_domain": true },
				{ "pattern": "www.codebam.ca", "custom_domain": true }
			]
		}
	}
}

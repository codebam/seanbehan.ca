---
/**
 * Search over the archive.
 *
 * The list itself is rendered by the server and this only reorders it: a
 * reader with no JS, and any crawler, still gets all twenty-odd posts.
 *
 * The matching now happens on the server, at /search.json: the ranking wants
 * the post bodies, and those should not be downloaded just to be searched.
 * What the browser keeps is the list, the input and the act of reordering —
 * and an archive it can read in full without any of it.
 */
---

<div class="relative mb-2">
	<svg
		class="pointer-events-none absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2 text-[var(--dim)]"
		fill="none"
		viewBox="0 0 24 24"
		stroke="currentColor"
		stroke-width="2"
		aria-hidden="true"
	>
		<path
			stroke-linecap="round"
			stroke-linejoin="round"
			d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"></path>
	</svg>
	<input
		type="search"
		id="post-search"
		placeholder="Search titles, tags and full text…"
		aria-label="Search posts"
		class="input pl-9"
	/>
</div>

<!-- Off-screen rather than hidden: `display: none` would take it out of the
     accessibility tree and nothing would be announced at all. -->
<p class="sr-only" role="status" aria-live="polite" id="post-search-status"></p>

<p
	class="border-t border-[var(--line)] py-10 text-[var(--muted)]"
	role="status"
	aria-live="polite"
	id="post-search-empty"
	hidden
>
</p>

<script>
	interface Row {
		el: HTMLElement;
		slug: string;
	}

	const input = document.querySelector<HTMLInputElement>('#post-search');
	const status = document.querySelector<HTMLElement>('#post-search-status');
	const empty = document.querySelector<HTMLElement>('#post-search-empty');
	const list = document.querySelector<HTMLElement>('[data-post-list]');

	if (input && status && empty && list) {
		const rows: Row[] = [...list.querySelectorAll<HTMLElement>('[data-post]')].map((el) => ({
			el,
			slug: el.dataset.slug ?? ''
		}));
		const bySlug = new Map(rows.map((row) => [row.slug, row]));

		/** The unsearched list: everything visible, in the order the server drew it. */
		function showAll() {
			for (const row of rows) row.el.hidden = false;
			empty!.hidden = true;
			status!.textContent = '';
		}

		/**
		 * Ask the server for the surviving order.
		 *
		 * Returns null rather than throwing when the request itself failed,
		 * because that is not the same as "no posts match": the empty state
		 * must not claim the archive is empty on account of the network being
		 * down. An empty query needs no round trip at all — the unsearched
		 * archive is precisely the whole list — so it is answered locally.
		 */
		async function fetchOrder(query: string): Promise<string[] | null> {
			if (!query) {
				showAll();
				return null;
			}
			try {
				const response = await fetch(`/search.json?q=${encodeURIComponent(query)}`, {
					headers: { Accept: 'application/json' }
				});
				if (!response.ok) throw new Error(`search answered ${response.status}`);
				const body: { slugs: string[] } = await response.json();
				return body.slugs;
			} catch {
				return null;
			}
		}

		function commit(query: string, slugs: string[] | null) {
			if (slugs === null) {
				showAll();
				if (query) {
					status!.textContent = `Search is not reachable right now; showing all ${rows.length} posts.`;
				}
				return;
			}

			const kept = slugs.map((slug) => bySlug.get(slug)).filter((row): row is Row => Boolean(row));

			for (const row of rows) row.el.hidden = !kept.includes(row);
			// Rank order, not publication order, once a query narrows the list.
			for (const row of kept) list!.append(row.el);

			empty!.hidden = kept.length > 0;
			empty!.textContent = kept.length > 0 ? '' : `No posts match “${query}”.`;

			/*
			 * Announced rather than only drawn: the list swaps out under a screen
			 * reader with nothing said about it otherwise. Left empty when nothing
			 * matched — the visible empty state above is itself a live region, and
			 * two of them would say the same thing twice.
			 */
			status!.textContent =
				!query || kept.length === 0
					? ''
					: `${kept.length} ${kept.length === 1 ? 'post matches' : 'posts match'} ${query}`;
		}

		/**
		 * The query lives in the URL as `?q=`, so a search survives a reload, can
		 * be linked to, and comes back when a reader follows a result and returns.
		 * Written on the debounced value with replaceState rather than pushState: a
		 * search is one destination that keeps changing, so it should take one
		 * history entry, not one per letter.
		 */
		function syncUrl(query: string) {
			const url = new URL(location.href);
			if ((url.searchParams.get('q') ?? '') === query) return;
			if (query) url.searchParams.set('q', query);
			else url.searchParams.delete('q');
			history.replaceState(history.state, '', url);
		}

		// A burst of keystrokes has more requests in flight than there are
		// answers, and a slow answer for the older query can land after the
		// fast one for the newer. The ticket numbers them so only the newest
		// is allowed to arrange the list.
		let latest = 0;
		const search = (query: string) => {
			const ticket = ++latest;
			fetchOrder(query).then((slugs) => {
				if (ticket === latest) commit(query, slugs);
			});
		};

		let timer: ReturnType<typeof setTimeout>;
		input.addEventListener('input', () => {
			clearTimeout(timer);
			timer = setTimeout(() => {
				const query = input!.value.trim();
				syncUrl(query);
				search(query);
			}, 300);
		});

		// A query in the URL is a search the reader arrived with, so run it
		// immediately rather than waiting for a keystroke that may never come.
		const initial = new URL(location.href).searchParams.get('q') ?? '';
		if (initial) {
			input.value = initial;
			search(initial);
		}
	}
</script>

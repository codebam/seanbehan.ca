---
/**
 * Animated grainy gradient rendered by the platform's WebGL2 API.
 *
 * The canvas is enhanced by a single page script; the host's CSS gradient is
 * the complete fallback when JavaScript or WebGL2 is unavailable.
 */
interface Props {
	timeSpeed?: number;
	warpFrequency?: number;
	warpSpeed?: number;
	warpAmplitude?: number;
	grainAmount?: number;
	grainScale?: number;
	contrast?: number;
	saturation?: number;
	zoom?: number;
	/** Hex literal or the name of a custom property to resolve, e.g. `--accent`. */
	color1?: string;
	color2?: string;
	color3?: string;
	class?: string;
}

const {
	timeSpeed = 0.12,
	warpFrequency = 5,
	warpSpeed = 2,
	warpAmplitude = 50,
	grainAmount = 0.1,
	grainScale = 2,
	contrast = 1.15,
	saturation = 1,
	zoom = 0.9,
	color1 = '--accent',
	color2 = '--surface-alt',
	color3 = '--bg',
	class: className
} = Astro.props;

const config = {
	timeSpeed,
	warpFrequency,
	warpSpeed,
	warpAmplitude,
	grainAmount,
	grainScale,
	contrast,
	saturation,
	zoom,
	color1,
	color2,
	color3
};
---

<div class:list={['grainient', className]} data-grainient data-config={JSON.stringify(config)}>
	<canvas aria-hidden="true"></canvas>
</div>

<script>
	import '../../scripts/grainient';
</script>

<style>
	.grainient {
		position: absolute;
		inset: 0;
		overflow: hidden;
		/* Paints before — and behind — the canvas, so the hero is never a bare
		   rectangle on a slow connection or without WebGL2. */
		background: linear-gradient(180deg, var(--surface-alt), var(--bg) 70%);
	}
	.grainient canvas {
		display: block;
		width: 100%;
		height: 100%;
	}
</style>

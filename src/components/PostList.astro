---
/**
 * The list of posts, shared by the archive, the tag pages and the related
 * reading under a post.
 *
 * Entries are cards in a grid. The search script in PostSearch reorders these
 * server-rendered cards, so the data attributes and the `[data-post-list]` root
 * are load-bearing, not decorative.
 */
import { writingHref } from '../lib/site';
import { displayTag, slugifyTag } from '../lib/tags';
import type { PostSummary } from '../lib/types';

interface Props {
	posts: PostSummary[];
	/** 2 for the archive's paired grid, 1 for a single column */
	columns?: 1 | 2;
	/** Topic tags are noise next to six posts, useful across twenty-four */
	showTags?: boolean;
	/** Kept for callers; cards are the only shape now. */
	carded?: boolean;
	/**
	 * Heading level for an entry title. The default suits the home page, where
	 * the list sits under an h2 section heading. A page whose list is the
	 * content itself — the archive, a tag — follows its h1 directly and must
	 * pass 2, or the document skips a level.
	 */
	headingLevel?: 2 | 3;
}

const { posts, columns = 1, showTags = false, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';

/** "Apr 2026" — the day is never what a reader is after in a list. */
const monthYear = (date: string) =>
	new Date(date).toLocaleDateString('en-CA', { month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<div class:list={['post-list', columns === 2 && 'post-list-paired']} data-post-list>
	{posts.map((post) => (
		<article
			class="post-card card"
			data-post
			data-slug={post.slug}
			data-title={post.meta.title}
			data-description={post.meta.description}
			data-tags={post.meta.tags.join(',')}
		>
			<a class="post-card-link" href={writingHref(post.path)}>
				<p class="post-card-meta">
					<time datetime={post.meta.date}>{monthYear(post.meta.date)}</time>
					{post.readingMinutes && <span>· {post.readingMinutes} min read</span>}
				</p>
				<Heading class="post-card-title">{post.meta.title}</Heading>
				{post.meta.description && <p class="post-card-desc">{post.meta.description}</p>}
			</a>
			{showTags && post.meta.tags.length > 0 && (
				<p class="post-card-tags">
					{post.meta.tags.map((tag) => (
						<a class="tag" href={writingHref(`/posts/tag/${slugifyTag(tag)}`)}>
							{displayTag(tag)}
						</a>
					))}
				</p>
			)}
		</article>
	))}
</div>

<style>
	.post-list {
		display: grid;
		gap: 1.25rem;
	}
	@media (width >= 48rem) {
		.post-list-paired {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	.post-card {
		padding: 1.5rem;
	}
	.post-card-link {
		display: block;
	}
	.post-card-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.4rem;
		font-size: 0.8rem;
		font-weight: 500;
		color: var(--muted);
	}
	/* Selector is the class, not the tag: the level varies with where the list
	   sits in the document outline, the styling does not. */
	.post-card-title {
		margin-top: 0.5rem;
		font-family: var(--font-sans);
		font-size: 1.2rem;
		font-weight: 600;
		letter-spacing: -0.015em;
		line-height: 1.3;
		color: var(--text);
		transition: color 0.2s ease;
	}
	.post-card:hover .post-card-title,
	.post-card:focus-within .post-card-title {
		color: var(--accent);
	}
	.post-card-desc {
		margin-top: 0.5rem;
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--body);
	}
	.post-card-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 1rem;
	}
</style>

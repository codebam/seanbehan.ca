---
/**
 * The list of posts, shared by the home page's writing index, the archive and
 * the tag pages.
 *
 * Entries are rows of text separated by hairlines — the search script in
 * PostSearch reorders these server-rendered rows, so the data attributes and
 * the `[data-post-list]` root are load-bearing, not decorative.
 *
 * The rows carry the broadsheet grammar: a tracked folio line, a serif title,
 * a serif deck, and no cards or pills. Tags are set as tracked text rather
 * than Kumo badges, because a pill is a dashboard's shape and this page is a
 * printed sheet.
 */
import { writingHref } from '../lib/site';
import { displayTag, slugifyTag } from '../lib/tags';
import type { PostSummary } from '../lib/types';

interface Props {
	posts: PostSummary[];
	/** 2 for the archive's paired grid, 1 for a single ruled column */
	columns?: 1 | 2;
	/** Topic tags are noise next to six posts, useful across twenty-four */
	showTags?: boolean;
	/** Enclose entries in quiet ruled blocks (related reading). */
	carded?: boolean;
	/**
	 * Heading level for an entry title. The default suits the home page, where
	 * the list sits under an h2 section heading. A page whose list is the
	 * content itself — the archive, a tag — follows its h1 directly and must
	 * pass 2, or the document skips a level.
	 */
	headingLevel?: 2 | 3;
}

const { posts, columns = 1, showTags = false, carded = false, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';

/** "Apr 2026" — the day is never what a reader is after in a list. */
const monthYear = (date: string) =>
	new Date(date).toLocaleDateString('en-CA', { month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<div class:list={['list', columns === 2 && 'paired', carded && 'carded']} data-post-list>
	{
		posts.map((post) => (
			<div
				class="item post-card"
				data-post
				data-slug={post.slug}
				data-title={post.meta.title}
				data-description={post.meta.description}
				data-tags={post.meta.tags.join(',')}
			>
				{/* Tags sit outside the link so they can be links without nesting
				    anchors. The paired grid still takes these wrappers as children. */}
				<a class="entry" href={writingHref(post.path)}>
					<p class="meta">
						<time datetime={post.meta.date}>{monthYear(post.meta.date)}</time>
						{post.readingMinutes && <span class="read">&middot; {post.readingMinutes} min</span>}
					</p>
					<Heading class="title">{post.meta.title}</Heading>
					{post.meta.description && <p class="desc">{post.meta.description}</p>}
				</a>
				{showTags && post.meta.tags.length > 0 && (
					<p class="tags">
						{post.meta.tags.map((tag, i) => (
							<>
								{i > 0 && (
									<span class="dot" aria-hidden="true">
										·
									</span>
								)}
								<a href={writingHref(`/posts/tag/${slugifyTag(tag)}`)}>{displayTag(tag)}</a>
							</>
						))}
					</p>
				)}
			</div>
		))
	}
</div>

<style>
	/* ── Plain rows ── */
	.list {
		border-top: 1px solid var(--line-strong);
	}
	.post-card {
		border-bottom: 1px solid var(--line);
	}
	.entry {
		display: block;
		padding: 1.4rem 0;
	}
	.meta {
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.entry time {
		transition: color 0.25s ease;
	}
	.entry:hover time {
		color: var(--accent);
	}
	/* Same eyebrow treatment as the date. It reads as the secondary fact on the
	   line through size and tracking rather than colour: --dim does not clear
	   the 4.5:1 bar for type on any of our surfaces. */
	.entry .read {
		color: var(--muted);
	}
	/* Selector is the class, not the tag: the level varies with where the list
	   sits in the document outline, the styling does not. */
	.entry .title {
		margin-top: 0.45rem;
		font-family: var(--font-serif);
		font-size: 1.35rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		line-height: 1.2;
		color: var(--text);
		transition: color 0.2s ease;
	}
	.entry:hover .title,
	.entry:focus-visible .title {
		color: var(--accent);
	}
	.entry .desc {
		max-width: 62ch;
		margin-top: 0.4rem;
		font-family: var(--font-serif);
		color: var(--body);
		font-size: 0.98rem;
		line-height: 1.6;
	}

	/* ── Paired grid: two columns of rows, reading across then down ── */
	.paired {
		display: grid;
		gap: 0 3.5rem;
	}
	@media (width >= 48rem) {
		.paired {
			grid-template-columns: 1fr 1fr;
		}
	}

	/* ── Carded: related reading under a post ──
	   Ruled blocks, not boxes: the top rule is the same one every other index
	   entry wears, and the hover cue is the title taking the accent rather
	   than the frame lighting up. */
	.carded {
		display: grid;
		gap: 0 3.5rem;
		border-top: 0;
	}
	@media (width >= 48rem) {
		.carded {
			grid-template-columns: 1fr 1fr;
		}
	}
	.carded .post-card {
		border-top: 1px solid var(--line-strong);
		border-bottom: 0;
	}
	.carded .entry {
		height: 100%;
		padding: 1.4rem 0;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.15rem 0.55rem;
		padding-bottom: 1.25rem;
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.tags .dot {
		color: var(--line-strong);
	}
	.tags a {
		color: inherit;
		transition: color 0.2s ease;
	}
	.tags a:hover,
	.tags a:focus-visible {
		color: var(--accent);
	}
</style>

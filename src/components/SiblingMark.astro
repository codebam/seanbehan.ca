---
/**
 * The mark on a chrome link that leaves this origin, or opens a new tab.
 *
 * Writing and the commercial pages (services, products, checkout, legal) live
 * on seanbehan.ca, while the project case studies live on codebam.ca, so some
 * header and footer links silently change origin on one variant. The
 * arrow says so where the eye is; the host in a visually-hidden span says so
 * where only the ear is. Content links stay unmarked — flagging every post
 * row would be noise, and the destination page identifies itself.
 *
 * `newTab` is the second case: a link with `target="_blank"` takes the
 * reader's back button away without saying anything, which a sighted reader
 * learns from the new window and a screen-reader user learns from nowhere.
 * Anything that opens a tab passes it, and the note is spoken, not drawn —
 * the visible arrow on those links is already the page's own.
 *
 * `overlay` is the third case: an image link has no text line for the arrow to
 * follow, so it parks the mark over the media instead of adding a line below
 * it. The parent needs `position: relative`, and the host note is unchanged.
 */
import { isSiblingHref, siblingHost } from '../lib/site';

interface Props {
	href: string;
	/** The anchor carries target="_blank". */
	newTab?: boolean;
	/** Park the visible arrow over media rather than after a text label. */
	overlay?: boolean;
}

const { href, newTab = false, overlay = false } = Astro.props;
const sibling = isSiblingHref(href);
---

{sibling && (
	<span class={`sibling-mark${overlay ? ' sibling-mark-overlay' : ''}`} aria-hidden="true">
		&#8599;
	</span>
)}
{sibling && <span class="sr-only"> (on {siblingHost(href)})</span>}
{newTab && <span class="sr-only"> (opens in a new tab)</span>}

<style>
	/* Quieter than the label it follows: the destination is a detail, not the
	   point, and it must never shift the row — inline, muted, no layout. */
	.sibling-mark {
		margin-left: 0.3em;
		font-size: 0.85em;
		color: var(--muted);
	}
	/* The media-link variant: a small quiet badge the anchor can position.
	   Square, like every other mark: the design has no round pills. */
	.sibling-mark-overlay {
		position: absolute;
		right: 0.65rem;
		bottom: 0.65rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.75rem;
		height: 1.75rem;
		margin-left: 0;
		font-size: 1rem;
		line-height: 1;
		color: var(--text);
		border: 1px solid var(--line-strong);
		border-radius: var(--radius-sm);
		background: color-mix(in srgb, var(--panel) 88%, transparent);
		pointer-events: none;
	}
</style>

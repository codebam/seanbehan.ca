---
/**
 * The hiring status, stated where a reader will see it.
 *
 * It renders on the home page and on the résumé — the two pages a hiring
 * reader lands on — and renders nothing at all on the variant that has no
 * status to declare. The copy is data (`site.availability`), so the two front
 * doors differ by what they say rather than by a branch here.
 *
 * The dot is a mark, not an indicator: it does not pulse. A live status light
 * is a dashboard's grammar, and the site is deliberately calm.
 */
import type { SiteConfig } from '../lib/site';

interface Props {
	availability: SiteConfig['availability'];
}

const { availability } = Astro.props;
---

{availability && (
	<p class="availability">
		<span class="availability-dot" aria-hidden="true" />
		<span class="availability-text">
			<strong>{availability.label}</strong>
			<span class="availability-detail">{availability.detail}</span>
		</span>
	</p>
)}

<style>
	/* A status line, not a panel: a dot and a sentence on the page's own
	   ground. It was a tinted box with a border, which put a container around
	   two lines of text that the dot already marks. */
	.availability {
		display: flex;
		align-items: flex-start;
		gap: 0.65rem;
	}
	/* Green is the one signal a reader already knows for "available"; the warm
	   accent stays for editorial emphasis. 6:1 on either ground, because a
	   status a reader has to perceive is a mark, not decoration. */
	.availability-dot {
		width: 0.5rem;
		height: 0.5rem;
		margin-top: 0.42rem;
		flex-shrink: 0;
		border-radius: 50%;
		background: var(--positive);
	}
	.availability-text {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		min-width: 0;
	}
	.availability strong {
		font-size: 0.9375rem;
		font-weight: 600;
		color: var(--text);
	}
	.availability-detail {
		font-size: 0.875rem;
		line-height: 1.5;
		color: var(--muted);
	}
</style>

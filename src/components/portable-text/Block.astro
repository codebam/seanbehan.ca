---
/**
 * Paragraphs, headings and blockquotes in a post body.
 *
 * The only reason to override EmDash's version is the heading id: the table of
 * contents links to `#some-section`, and both sides have to agree on every id.
 * They are computed once by `prepareBody` in lib/posts.ts — which also re-bases
 * the level, so a body stored entirely as `###` renders `h2` sections under the
 * page's `h1` instead of skipping a level — and travel on the block as
 * `headingId` and a rewritten `style`.
 *
 * Every heading wraps its text in a link to itself, the `#` mark in app.css's
 * `.heading-anchor` rules, so a section URL is one click away with no script
 * involved. There is no `h1` branch: a stray one in a body is re-based to `h2`
 * before it gets here, because a second page title is not a section.
 */
import type { BlockProps } from 'astro-portabletext/types';

type Props = Omit<BlockProps, 'node'> & { node: BlockProps['node'] & { headingId?: string } };

const { node, index: _index, isInline: _isInline, ...attrs } = Astro.props as Props;
const style = node.style ?? 'normal';
const id = node.headingId;

const HEADINGS = { h2: 'h2', h3: 'h3', h4: 'h4', h5: 'h5', h6: 'h6' } as const;
const Tag = HEADINGS[style as keyof typeof HEADINGS] ?? null;
---

{Tag ? (
	<Tag id={id} {...attrs}>
		{id ? (
			<a class="heading-anchor" href={`#${id}`}>
				<slot />
			</a>
		) : (
			<slot />
		)}
	</Tag>
) : style === 'blockquote' ? (
	<blockquote {...attrs}>
		<slot />
	</blockquote>
) : (
	<p {...attrs}>
		<slot />
	</p>
)}

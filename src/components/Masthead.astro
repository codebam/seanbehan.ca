---
/**
 * The page opening shared by every non-home page: a small label/meta row, one
 * headline, then the deck. Kept deliberately quiet — the header above it is
 * the chrome, and this is where the page states what it is.
 */
interface Props {
	label: string;
	meta: string;
}

const { label, meta } = Astro.props;
---

<section class="page-hero panel">
	<div class="shell">
		<p class="page-hero-kicker">
			<span>{label}</span>
			<span class="page-hero-meta">{meta}</span>
		</p>

		<h1 class="display display-xl page-hero-title">
			<slot name="title" />
		</h1>
		<div class="page-hero-copy enter" style="--enter-delay:60ms">
			<slot />
		</div>
	</div>
</section>

<style>
	.page-hero {
		padding-block: clamp(2.75rem, 5vw, 4rem) clamp(2.5rem, 5vw, 4rem);
		border-bottom: 1px solid var(--line);
	}
	.page-hero-kicker {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.page-hero-title {
		max-width: 20ch;
		margin-top: clamp(1.5rem, 3.5vw, 2.25rem);
	}
	.page-hero-title :global(em) {
		font-style: italic;
		color: var(--accent-warm);
	}
	.page-hero-copy {
		max-width: 60ch;
		margin-top: clamp(1.25rem, 3vw, 1.75rem);
		font-size: clamp(1.05rem, 1.5vw, 1.2rem);
		line-height: 1.65;
		color: var(--body);
	}
	/* Shared action rows inside the hero, so pages do not each restate them. */
	.page-hero-copy :global(.masthead-actions) {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.25rem;
		margin-top: 1.75rem;
	}
	.page-hero-copy :global(.masthead-availability) {
		margin-top: 1.5rem;
	}
	.page-hero-copy :global(.masthead-blurb) {
		max-width: 60ch;
	}
	.page-hero-copy :global(.masthead-profile) {
		display: grid;
		grid-template-columns: 5rem 1fr;
		align-items: start;
		gap: 1.25rem;
	}
	.page-hero-copy :global(.masthead-profile img) {
		width: 5rem;
		aspect-ratio: 1;
		border-radius: var(--radius);
		border: 1px solid var(--line);
		object-fit: cover;
	}
	@media (width < 48rem) {
		.page-hero-kicker {
			flex-wrap: wrap;
			gap: 0.35rem 1rem;
		}
	}
</style>

---
/**
 * SELECTED WORK — one editorial row per project: a hairline, the picture,
 * the story. The rows alternate sides so a page of them reads as a
 * conversation rather than a feed.
 */
import { projectHref } from '../../lib/site';
import type { FeaturedProject } from '../../lib/types';
import { Badge } from '@cloudflare/kumo/components/badge';

interface Props {
	projects: FeaturedProject[];
}

const { projects } = Astro.props;
---

<section id="work" class="work-panel panel scroll-mt-4">
	<div class="shell">
		<div class="work-heading" data-reveal>
			<h2 class="display display-lg">Selected work</h2>
			<a
				href="https://github.com/codebam?tab=repositories"
				target="_blank"
				rel="noopener noreferrer"
				class="link-accent whitespace-nowrap">All repositories <span class="arrow">&rarr;</span></a
			>
		</div>

		<div class="work-list">
			{
				projects.map((project, i) => (
					<article class="work-row" data-reveal data-reveal-delay={Math.min(i, 3) * 70}>
						<a class="row-media" href={projectHref(`/projects/${project.slug}`)} tabindex="-1">
							<img
								src={project.mockup}
								alt={project.mockupAlt}
								width="1600"
								height="1000"
								loading="lazy"
								decoding="async"
							/>
						</a>

						<div class="row-body">
							<p class="row-meta">
								<span>{project.since} &mdash;</span>
								{project.stars > 0 && (
									<span
										class="row-stars"
										title={`${project.stars} ${project.stars === 1 ? 'star' : 'stars'} on GitHub`}
									>
										&#9733; {project.stars}
									</span>
								)}
							</p>

							<h3 class="title">
								<a href={projectHref(`/projects/${project.slug}`)}>{project.title}</a>
							</h3>
							<p class="row-copy">{project.description}</p>

							<p class="row-tags">
								<Badge variant="blue">{project.language}</Badge>
								{project.tags.map((tag) => (
									<Badge variant="outline">{tag}</Badge>
								))}
							</p>

							<p class="row-links">
								<a
									href={`https://github.com/codebam/${project.repo}`}
									target="_blank"
									rel="noopener noreferrer"
									class="link-quiet"
								>
									Source
								</a>
								{project.homepage && (
									<a
										href={project.homepage}
										target="_blank"
										rel="noopener noreferrer"
										class="link-accent"
									>
										{project.homepageLabel} <span class="arrow">&rarr;</span>
									</a>
								)}
							</p>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.work-panel {
		padding-block: clamp(5rem, 10vw, 9rem);
	}
	.work-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 2rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--line-strong);
	}
	.work-list {
		display: grid;
	}
	.work-row {
		display: grid;
		gap: clamp(2rem, 4vw, 4rem);
		padding-block: clamp(3rem, 6vw, 5rem);
		border-bottom: 1px solid var(--line);
	}
	@media (width >= 48rem) {
		.work-row {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			align-items: center;
		}
		/* The picture trades sides down the page. */
		.work-row:nth-child(even) .row-media {
			order: 2;
		}
	}
	.row-media {
		display: block;
		overflow: hidden;
		border: 1px solid var(--line-strong);
		border-radius: 3px;
		background: var(--panel);
	}
	.row-media img {
		display: block;
		width: 100%;
		height: auto;
	}
	.row-meta {
		display: flex;
		align-items: baseline;
		gap: 1.25rem;
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.row-stars {
		color: var(--accent-warm);
	}
	.title {
		margin-top: 1rem;
		font-family: var(--font-serif);
		font-size: clamp(1.8rem, 3vw, 2.5rem);
		font-weight: 500;
		letter-spacing: -0.02em;
		line-height: 1.1;
	}
	.title a {
		color: var(--text);
		text-decoration: none;
		transition: color 0.2s ease;
	}
	.title a:hover,
	.title a:focus-visible {
		color: var(--accent);
	}
	.row-copy {
		max-width: 52ch;
		margin-top: 1rem;
		font-family: var(--font-serif);
		font-size: 1.08rem;
		line-height: 1.65;
		color: var(--body);
	}
	.row-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 1.25rem;
	}
	.row-links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.75rem;
		margin-top: 1.5rem;
		font-size: 0.95rem;
	}
	@media (width < 48rem) {
		.work-heading {
			flex-wrap: wrap;
			gap: 0.5rem 2rem;
		}
	}
</style>

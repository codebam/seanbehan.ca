---
/**
 * SELECTED WORK
 *
 * The first project gets a wide feature card — plate and story side by side.
 * The rest run as a two-column card grid, each with its mockup, so the section
 * can be scanned by picture rather than read line by line.
 */
import { projectHref } from '../../lib/site';
import SiblingMark from '../SiblingMark.astro';
import type { FeaturedProject } from '../../lib/types';

interface Props {
	projects: FeaturedProject[];
}

const { projects } = Astro.props;
const [lead, ...rest] = projects;

/** "2026 · ★ 324" — only the facts a row actually has. The count is the
 *  row's one live number (github.ts refreshes it), which is why no other
 *  line on the card is allowed to quote a star count of its own. */
const metaLine = (project: FeaturedProject) =>
	[project.since, project.stars > 0 ? `★ ${project.stars}` : null].filter(Boolean).join(' · ');
---

<section id="work" class="section work shell">
	<header class="section-head" data-reveal>
		<div>
			<h2 class="display display-lg">Selected work</h2>
			<p class="section-sub">Open-source projects and shipped services.</p>
		</div>
		<a
			href="https://github.com/codebam?tab=repositories"
			target="_blank"
			rel="noopener noreferrer"
			class="link-accent"
		>
			All repositories <span class="arrow">&rarr;</span>
			<SiblingMark href="https://github.com/codebam?tab=repositories" newTab />
		</a>
	</header>

	{lead && (
		<article class="project-feature card" data-reveal>
			<a class="project-media" href={projectHref(`/projects/${lead.slug}`)}>
				<img
					src={lead.mockup}
					alt={lead.mockupAlt}
					width="1600"
					height="1000"
					loading="lazy"
					decoding="async"
				/>
			</a>
			<div class="project-body">
				<p class="project-meta">{metaLine(lead)}</p>
				<h3 class="project-title">
					<a href={projectHref(`/projects/${lead.slug}`)}>{lead.title}</a>
				</h3>
				<p class="project-copy">{lead.description}</p>
				<p class="project-tags">
					<span class="tag tag-lang">{lead.language}</span>
					{lead.tags.map((tag) => (
						<span class="tag">{tag}</span>
					))}
				</p>
				<p class="project-links">
					{lead.homepage && (
						<a class="link-accent" href={lead.homepage} target="_blank" rel="noopener noreferrer">
							{lead.homepageLabel} <span class="arrow">&rarr;</span>
							<SiblingMark href={lead.homepage} newTab />
						</a>
					)}
					{lead.repo && (
						<a
							class="link-quiet"
							href={`https://github.com/codebam/${lead.repo}`}
							target="_blank"
							rel="noopener noreferrer"
						>
							Source
							<SiblingMark href={`https://github.com/codebam/${lead.repo}`} newTab />
						</a>
					)}
				</p>
			</div>
		</article>
	)}

	<div class="project-grid">
		{rest.map((project, i) => (
			<article class="project-card card" data-reveal data-reveal-delay={Math.min(i, 3) * 60}>
				<a class="project-media" href={projectHref(`/projects/${project.slug}`)}>
					<img
						src={project.mockup}
						alt={project.mockupAlt}
						width="1600"
						height="1000"
						loading="lazy"
						decoding="async"
					/>
				</a>
				<div class="project-body">
					<p class="project-meta">{metaLine(project)}</p>
					<h3 class="project-title">
						<a href={projectHref(`/projects/${project.slug}`)}>{project.title}</a>
					</h3>
					<p class="project-copy">{project.description}</p>
					<p class="project-tags">
						<span class="tag tag-lang">{project.language}</span>
						{project.tags.map((tag) => (
							<span class="tag">{tag}</span>
						))}
					</p>
					<p class="project-links">
						{project.homepage && (
							<a
								class="link-accent"
								href={project.homepage}
								target="_blank"
								rel="noopener noreferrer"
							>
								{project.homepageLabel} <span class="arrow">&rarr;</span>
								<SiblingMark href={project.homepage} newTab />
							</a>
						)}
						{project.repo && (
							<a
								class="link-quiet"
								href={`https://github.com/codebam/${project.repo}`}
								target="_blank"
								rel="noopener noreferrer"
							>
								Source
								<SiblingMark href={`https://github.com/codebam/${project.repo}`} newTab />
							</a>
						)}
					</p>
				</div>
			</article>
		))}
	</div>
</section>

<style>
	.work {
		scroll-margin-top: 5rem;
	}
	.section-sub {
		margin-top: 0.35rem;
		font-size: 0.95rem;
		color: var(--muted);
	}

	.project-feature {
		display: grid;
		overflow: hidden;
	}
	@media (width >= 48rem) {
		.project-feature {
			grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
		}
	}
	.project-feature .project-body {
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: clamp(1.5rem, 3vw, 2.5rem);
	}
	.project-feature .project-title {
		font-size: clamp(1.5rem, 2.5vw, 2rem);
	}

	.project-media {
		display: block;
		height: 100%;
		overflow: hidden;
		background: var(--surface-alt);
	}
	.project-media img {
		display: block;
		width: 100%;
		height: 100%;
		aspect-ratio: 16 / 10;
		object-fit: cover;
		transition: transform 0.35s var(--ease-out-soft);
	}
	.card:hover .project-media img {
		transform: scale(1.02);
	}

	.project-card {
		display: flex;
		flex-direction: column;
		overflow: hidden;
	}
	.project-card .project-body {
		padding: 1.5rem;
	}

	.project-meta {
		font-size: 0.8rem;
		font-weight: 500;
		color: var(--muted);
	}
	.project-title {
		margin-top: 0.4rem;
		font-size: 1.3rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.25;
	}
	.project-title a {
		color: var(--text);
		text-decoration: none;
		transition: color 0.2s ease;
	}
	.project-title a:hover,
	.project-title a:focus-visible {
		color: var(--accent);
	}
	.project-copy {
		margin-top: 0.6rem;
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--body);
	}
	.project-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 1rem;
	}
	.project-links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.25rem;
		margin-top: 1.25rem;
	}

	.project-grid {
		display: grid;
		gap: 1.5rem;
		margin-top: 1.5rem;
	}
	@media (width >= 48rem) {
		.project-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>

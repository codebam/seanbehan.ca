---
/**
 * SELECTED WORK
 *
 * Projects are directory rows: path and metadata in the left gutter, title,
 * description, tags and links in the main column. The case-study pages keep
 * the pictures; the home page spends its space on what each project does.
 *
 * On the hiring variant every case study lives on codebam.ca. Both the row and
 * its title carry the sibling mark the header uses, so the origin change is
 * never silent; on codebam's own build the hrefs stay relative and
 * SiblingMark renders nothing.
 */
import { Image } from 'astro:assets';
import { projectHref } from '../../lib/site';
import SiblingMark from '../SiblingMark.astro';
import type { FeaturedProject } from '../../lib/types';

interface Props {
	projects: FeaturedProject[];
}

const { projects } = Astro.props;
const [lead, ...rest] = projects;

/** "2026 · ★ 324" — only the facts a row actually has. The count is the
 *  row's one live number (github.ts refreshes it), which is why no other
 *  line on the card is allowed to quote a star count of its own. */
const metaLine = (project: FeaturedProject) =>
	[project.since, project.stars > 0 ? `★ ${project.stars}` : null].filter(Boolean).join(' · ');
---

<section id="work" class="section work shell project-list">
	<header class="section-head" data-reveal>
		<div>
			<h2 class="display display-lg">
				<span class="terminal-prompt" aria-hidden="true">
					$
				</span>{' '}
				ls ~/projects
			</h2>
			<p class="section-sub">Open-source projects and shipped services.</p>
		</div>
		<a
			href="https://github.com/codebam?tab=repositories"
			target="_blank"
			rel="noopener noreferrer"
			class="link-accent"
		>
			All repositories <span class="arrow">&rarr;</span>
			<SiblingMark href="https://github.com/codebam?tab=repositories" newTab />
		</a>
	</header>

	{lead && (
		<article class="project-feature card" data-reveal>
			<a class="project-media" href={projectHref(`/projects/${lead.slug}`)}>
				<Image
					src={lead.mockup}
					alt={lead.mockupAlt}
					widths={[400, 640, 960, 1280]}
					sizes="(min-width: 72rem) 560px, (min-width: 48rem) 52vw, calc(100vw - 2.5rem)"
					loading="lazy"
					decoding="async"
				/>
				<SiblingMark href={projectHref(`/projects/${lead.slug}`)} overlay />
			</a>
			<div class="project-body">
				<p class="project-meta">
					<span class="terminal-prompt" aria-hidden="true">
						$
					</span>{' '}
					{metaLine(lead)} <span class="project-path">~/projects/{lead.slug}</span>
				</p>
				<h3 class="project-title">
					<a href={projectHref(`/projects/${lead.slug}`)}>
						{lead.title}
						<SiblingMark href={projectHref(`/projects/${lead.slug}`)} />
					</a>
				</h3>
				<p class="project-copy">{lead.description}</p>
				<p class="project-tags">
					<span class="tag tag-lang">{lead.language}</span>
					{lead.tags.map((tag) => (
						<span class="tag">{tag}</span>
					))}
				</p>
				<p class="project-links">
					{lead.homepage && (
						<a class="link-accent" href={lead.homepage} target="_blank" rel="noopener noreferrer">
							{lead.homepageLabel} <span class="arrow">&rarr;</span>
							<SiblingMark href={lead.homepage} newTab />
						</a>
					)}
					{lead.repo && (
						<a
							class="link-quiet"
							href={`https://github.com/codebam/${lead.repo}`}
							target="_blank"
							rel="noopener noreferrer"
						>
							Source
							<SiblingMark href={`https://github.com/codebam/${lead.repo}`} newTab />
						</a>
					)}
				</p>
			</div>
		</article>
	)}

	<div class="project-grid">
		{rest.map((project, i) => (
			<article class="project-card card" data-reveal data-reveal-delay={Math.min(i, 3) * 60}>
				<a class="project-media" href={projectHref(`/projects/${project.slug}`)}>
					<Image
						src={project.mockup}
						alt={project.mockupAlt}
						widths={[400, 520, 760, 1040]}
						sizes="(min-width: 72rem) 520px, (min-width: 48rem) 50vw, calc(100vw - 2.5rem)"
						loading="lazy"
						decoding="async"
					/>
					<SiblingMark href={projectHref(`/projects/${project.slug}`)} overlay />
				</a>
				<div class="project-body">
					<p class="project-meta">
						<span class="terminal-prompt" aria-hidden="true">
							$
						</span>{' '}
						{metaLine(project)} <span class="project-path">~/projects/{project.slug}</span>
					</p>
					<h3 class="project-title">
						<a href={projectHref(`/projects/${project.slug}`)}>
							{project.title}
							<SiblingMark href={projectHref(`/projects/${project.slug}`)} />
						</a>
					</h3>
					<p class="project-copy">{project.description}</p>
					<p class="project-tags">
						<span class="tag tag-lang">{project.language}</span>
						{project.tags.map((tag) => (
							<span class="tag">{tag}</span>
						))}
					</p>
					<p class="project-links">
						{project.homepage && (
							<a
								class="link-accent"
								href={project.homepage}
								target="_blank"
								rel="noopener noreferrer"
							>
								{project.homepageLabel} <span class="arrow">&rarr;</span>
								<SiblingMark href={project.homepage} newTab />
							</a>
						)}
						{project.repo && (
							<a
								class="link-quiet"
								href={`https://github.com/codebam/${project.repo}`}
								target="_blank"
								rel="noopener noreferrer"
							>
								Source
								<SiblingMark href={`https://github.com/codebam/${project.repo}`} newTab />
							</a>
						)}
					</p>
				</div>
			</article>
		))}
	</div>
</section>

<style>
	.work {
		scroll-margin-top: 5rem;
	}
	.section-sub {
		margin-top: 0.35rem;
		font-size: 0.95rem;
		color: var(--muted);
	}

	.project-feature,
	.project-card {
		display: grid;
		grid-template-columns: minmax(12rem, 0.55fr) minmax(0, 1.45fr);
		align-items: start;
		gap: 1.5rem;
		padding-block: 1.4rem;
		overflow: visible;
		border: 0;
		border-bottom: 1px solid var(--line-strong);
		border-radius: 0;
		background: transparent;
		box-shadow: none;
	}
	.project-feature + .project-grid {
		margin-top: 0;
	}
	.project-feature .project-body,
	.project-card .project-body {
		display: contents;
	}
	.project-media {
		display: none;
	}
	.project-meta {
		grid-column: 1;
		grid-row: 1;
		font-family: var(--font-mono);
		font-size: 0.72rem;
	}
	.project-path {
		display: block;
		margin-top: 0.2rem;
		color: var(--muted);
		overflow-wrap: anywhere;
	}
	.project-title {
		grid-column: 2;
		grid-row: 1;
		margin: 0;
		font-size: 1.15rem;
	}
	.project-copy {
		grid-column: 2;
		grid-row: 2;
		margin: 0.45rem 0 0;
	}
	.project-tags {
		grid-column: 2;
		grid-row: 3;
		margin-top: 0.75rem;
	}
	.project-links {
		grid-column: 2;
		grid-row: 4;
		margin-top: 0.85rem;
	}
	.terminal-prompt {
		margin-right: 0.4rem;
		color: var(--accent);
	}
	.project-title {
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.25;
	}
	.project-title a {
		color: var(--text);
		text-decoration: none;
		transition: color 0.2s ease;
	}
	.project-title a:hover,
	.project-title a:focus-visible {
		color: var(--accent);
	}
	.project-copy {
		margin-top: 0.45rem;
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--body);
	}
	.project-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 0.75rem;
	}
	.project-links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.25rem;
		margin-top: 0.85rem;
	}

	.project-grid {
		display: block;
		margin-top: 0;
	}
	@media (width < 48rem) {
		.project-feature,
		.project-card {
			grid-template-columns: 1fr;
			gap: 0.55rem;
		}
		.project-meta,
		.project-title,
		.project-copy,
		.project-tags,
		.project-links {
			grid-column: 1;
			grid-row: auto;
		}
	}
</style>

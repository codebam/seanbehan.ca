---
/**
 * The numbers, as a quiet strip under the hero.
 *
 * Four plain figures on the page's own ground, separated by hairlines rather
 * than boxed into dashboard cards. The fourth cell is still a word, so it is
 * still spelled out rather than forced into the shape of the three counts.
 */
import type { FeaturedProject } from '../../lib/types';

interface Props {
	postCount: number;
	projects: FeaturedProject[];
	/**
	 * The B-owned home page still passes the table's years-since-2014 number.
	 * This strip cannot print it: resume/resume.md's first dated entry is May
	 * 2018, so four of those years have no evidence behind them (fix-plan H3).
	 * Kept optional until B removes the call; the strip reports the start year
	 * the document can prove instead.
	 */
	yearsBuilding?: number;
}

const { postCount, projects } = Astro.props;

/** Stars across the featured repos, rounded down to a round number. */
const starTotal = projects.reduce((sum, project) => sum + project.stars, 0);
const starCount = starTotal >= 100 ? Math.floor(starTotal / 50) * 50 : starTotal;
const starSuffix = starTotal >= 100 ? '+' : '';

const facts = [
	// The start year every dated entry sits after, rather than an elapsed
	// count the document cannot trace back past May 2018.
	{ value: '2018', label: 'professional experience since' },
	{ value: String(postCount), label: 'technical posts' },
	{ value: `${starCount}${starSuffix}`, label: 'GitHub stars' },
	{ value: 'Rust', label: '+ TypeScript, Nix' }
];
---

<section class="stats" aria-label="By the numbers">
	<div class="shell stats-grid">
		{facts.map((fact, i) => (
			<div data-reveal data-reveal-delay={i * 50}>
				<span class="stat-value">{fact.value}</span>
				<span class="stat-label">{fact.label}</span>
			</div>
		))}
	</div>
</section>

<style>
	.stats {
		border-top: 1px solid var(--line);
	}
	.stats-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.5rem 2rem;
		padding-block: var(--pad-stats-grid);
	}
	@media (width >= 48rem) {
		.stats-grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
	.stat-value {
		display: block;
		font-size: clamp(1.375rem, 2vw, 1.625rem);
		font-weight: 600;
		letter-spacing: -0.01em;
		line-height: 1.15;
		font-variant-numeric: tabular-nums;
		color: var(--text);
	}
	.stat-label {
		display: block;
		margin-top: 0.35rem;
		font-size: 0.875rem;
		line-height: 1.45;
		color: var(--muted);
	}
</style>

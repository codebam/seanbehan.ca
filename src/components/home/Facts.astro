---
/**
 * FACTS — a compact editorial strip over the static blueprint grid.
 *
 * The fourth cell is a word rather than a number, so it is spelled out instead
 * of being forced into the same shape as the three counts beside it.
 */
import type { FeaturedProject } from '../../lib/types';

interface Props {
	postCount: number;
	projects: FeaturedProject[];
	yearsBuilding: number;
}

const { postCount, projects, yearsBuilding } = Astro.props;

/** Stars across the featured repos, rounded down to a round number. */
const starTotal = projects.reduce((sum, project) => sum + project.stars, 0);
const starCount = starTotal >= 100 ? Math.floor(starTotal / 50) * 50 : starTotal;
const starSuffix = starTotal >= 100 ? '+' : '';

const facts = [
	{ value: `${yearsBuilding}+`, label: 'years building software' },
	{ value: String(postCount), label: 'technical posts' },
	{ value: `${starCount}${starSuffix}`, label: 'GitHub stars' },
	{ value: 'Rust', label: '+ TypeScript, Nix' }
];
---

<section class="facts panel-alt relative overflow-hidden">
	<div class="facts-row shell relative grid grid-cols-2 md:grid-cols-4">
		{
			facts.map((fact, i) => (
				<div class="fact" data-reveal data-reveal-delay={i * 60}>
					<span class="fact-index" aria-hidden="true">
						{String(i + 1).padStart(2, '0')}
					</span>
					<div class="fact-value display tabular-nums">{fact.value}</div>
					<div class="fact-label">{fact.label}</div>
				</div>
			))
		}
	</div>
</section>

<style>
	.facts {
		background-image:
			linear-gradient(color-mix(in srgb, var(--accent) 8%, transparent) 1px, transparent 1px),
			linear-gradient(90deg, color-mix(in srgb, var(--accent) 8%, transparent) 1px, transparent 1px);
		background-size: 32px 32px;
		border-top: 1px solid color-mix(in srgb, var(--accent) 22%, var(--line));
	}
	.facts-row {
		max-width: 1240px;
		gap: clamp(2rem, 5vw, 5rem);
		padding-block: clamp(3.5rem, 7vw, 6rem);
	}
	.fact {
		min-width: 0;
	}
	.fact-index {
		display: block;
		margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		color: var(--accent-warm);
	}
	.fact-value {
		font-size: clamp(2.75rem, 5vw, 4.5rem);
		transition: color 0.25s ease;
	}
	.fact-label {
		max-width: 17ch;
		margin-top: 0.65rem;
		font-size: 0.85rem;
		line-height: 1.45;
		color: var(--muted);
	}
	.fact:hover .fact-value {
		color: var(--accent-warm);
	}
	@media (width < 48rem) {
		.facts-row {
			row-gap: 4rem;
		}
	}
</style>

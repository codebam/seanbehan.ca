---
/**
 * FACTS — tinted cards over a static blueprint grid.
 *
 * The fourth cell is a word rather than a number, so it is spelled out instead
 * of being forced into the same shape as the three counts beside it.
 */
import type { FeaturedProject } from '../../lib/types';
import { LayerCard } from '@cloudflare/kumo/components/layer-card';

interface Props {
	postCount: number;
	projects: FeaturedProject[];
	yearsBuilding: number;
}

const { postCount, projects, yearsBuilding } = Astro.props;

/** Stars across the featured repos, rounded down to a round number. */
const starTotal = projects.reduce((sum, project) => sum + project.stars, 0);
const starCount = starTotal >= 100 ? Math.floor(starTotal / 50) * 50 : starTotal;
const starSuffix = starTotal >= 100 ? '+' : '';

const facts = [
	{ value: `${yearsBuilding}+`, label: 'years building software' },
	{ value: String(postCount), label: 'technical posts' },
	{ value: `${starCount}${starSuffix}`, label: 'GitHub stars' },
	{ value: 'Rust', label: '+ TypeScript, Nix' }
];
---

<section class="facts panel-alt relative overflow-hidden py-12 md:py-14">
	<div class="shell relative grid grid-cols-2 gap-x-8 gap-y-8 md:grid-cols-4">
		{
			facts.map((fact, i) => (
				<LayerCard className="blueprint-card fact p-4" data-reveal data-reveal-delay={i * 60}>
					<div class="fact-value display text-[2.4rem] tabular-nums md:text-[2.9rem]">
						{fact.value}
					</div>
					<div class="mt-1 text-sm text-[var(--muted)]">{fact.label}</div>
				</LayerCard>
			))
		}
	</div>
</section>

<style>
	.facts {
		background-image:
			linear-gradient(color-mix(in srgb, var(--accent) 13%, transparent) 1px, transparent 1px),
			linear-gradient(
				90deg,
				color-mix(in srgb, var(--accent) 13%, transparent) 1px,
				transparent 1px
			);
		background-size: 32px 32px;
	}
	.fact {
		background: color-mix(in srgb, var(--accent) 10%, var(--panel));
		border: 1px solid color-mix(in srgb, var(--accent) 28%, var(--line));
		box-shadow: none;
		transition: transform 0.35s var(--ease-out-soft);
	}
	.fact-value {
		transition:
			color 0.25s ease,
			transform 0.35s var(--ease-out-soft),
			text-shadow 0.35s ease;
	}
	.fact:hover {
		transform: translateY(-3px);
	}
	.fact:hover .fact-value {
		color: var(--accent);
		transform: scale(1.035);
		transform-origin: left bottom;
		text-shadow: 0 8px 22px color-mix(in srgb, var(--accent) 18%, transparent);
	}
	@media (prefers-reduced-motion: reduce) {
		.fact:hover,
		.fact:hover .fact-value {
			transform: none;
		}
	}
</style>

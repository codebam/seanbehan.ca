---
/**
 * The numbers, as a folio line rather than a band.
 *
 * On the broadsheet front page these are not a section — they are the line a
 * paper runs under the masthead to say what is in the issue. So they take a
 * rule above and below, sit on the page's own ground, and read across as one
 * sentence instead of four stat cards. The fourth cell is still a word, so it
 * is still spelled out rather than forced into the shape of the three counts.
 */
import type { FeaturedProject } from '../../lib/types';

interface Props {
	postCount: number;
	projects: FeaturedProject[];
	yearsBuilding: number;
}

const { postCount, projects, yearsBuilding } = Astro.props;

/** Stars across the featured repos, rounded down to a round number. */
const starTotal = projects.reduce((sum, project) => sum + project.stars, 0);
const starCount = starTotal >= 100 ? Math.floor(starTotal / 50) * 50 : starTotal;
const starSuffix = starTotal >= 100 ? '+' : '';

const facts = [
	{ value: `${yearsBuilding}+`, label: 'years building software' },
	{ value: String(postCount), label: 'technical posts' },
	{ value: `${starCount}${starSuffix}`, label: 'GitHub stars' },
	{ value: 'Rust', label: '+ TypeScript, Nix' }
];
---

<section class="folio" aria-label="By the numbers">
	<div class="shell folio-row">
		<span class="folio-label">By the numbers</span>
		<ul class="folio-list">
			{
				facts.map((fact, i) => (
					<li class="folio-item" data-reveal data-reveal-delay={i * 50}>
						<span class="folio-value">{fact.value}</span>
						<span class="folio-text">{fact.label}</span>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.folio {
		border-block: 1px solid var(--line);
	}
	.folio-row {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.6rem 2.5rem;
		padding-block: 1.15rem;
	}
	.folio-label {
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.folio-list {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.4rem 2.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	/* A rule between the items, drawn as a border on everything after the
	   first, so the line reads as one run rather than four separate cells. */
	.folio-item {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
	}
	.folio-item + .folio-item {
		padding-left: 2.25rem;
		border-left: 1px solid var(--line-strong);
	}
	/* Oldstyle numerals where the face has them — the value set with the
	   page's voice, not with a dashboard's tabular figures. */
	.folio-value {
		font-family: var(--font-serif);
		font-size: 1.35rem;
		font-weight: 500;
		line-height: 1;
		font-variant-numeric: oldstyle-nums;
		color: var(--text);
	}
	.folio-text {
		font-size: 0.82rem;
		line-height: 1.4;
		color: var(--muted);
	}
	@media (width < 48rem) {
		.folio-item + .folio-item {
			padding-left: 0;
			border-left: 0;
		}
	}
</style>

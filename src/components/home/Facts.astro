---
/**
 * The numbers, as a quiet strip under the hero.
 *
 * Four plain figures on the page's own ground, separated by hairlines rather
 * than boxed into dashboard cards. The fourth cell is still a word, so it is
 * still spelled out rather than forced into the shape of the three counts.
 */
import type { FeaturedProject } from '../../lib/types';

interface Props {
	postCount: number;
	projects: FeaturedProject[];
	yearsBuilding: number;
}

const { postCount, projects, yearsBuilding } = Astro.props;

/** Stars across the featured repos, rounded down to a round number. */
const starTotal = projects.reduce((sum, project) => sum + project.stars, 0);
const starCount = starTotal >= 100 ? Math.floor(starTotal / 50) * 50 : starTotal;
const starSuffix = starTotal >= 100 ? '+' : '';

const facts = [
	{ value: `${yearsBuilding}+`, label: 'years building software' },
	{ value: String(postCount), label: 'technical posts' },
	{ value: `${starCount}${starSuffix}`, label: 'GitHub stars' },
	{ value: 'Rust', label: '+ TypeScript, Nix' }
];
---

<section class="stats" aria-label="By the numbers">
	<div class="shell stats-grid">
		{facts.map((fact, i) => (
			<div data-reveal data-reveal-delay={i * 50}>
				<span class="stat-value">{fact.value}</span>
				<span class="stat-label">{fact.label}</span>
			</div>
		))}
	</div>
</section>

<style>
	.stats {
		border-block: 1px solid var(--line);
	}
	.stats-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.5rem 2rem;
		padding-block: clamp(1.75rem, 3vw, 2.5rem);
	}
	@media (width >= 48rem) {
		.stats-grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
	.stat-value {
		display: block;
		font-size: clamp(1.5rem, 2.5vw, 1.9rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.1;
		color: var(--text);
	}
	.stat-label {
		display: block;
		margin-top: 0.3rem;
		font-size: 0.875rem;
		line-height: 1.4;
		color: var(--muted);
	}
</style>

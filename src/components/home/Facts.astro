---
/**
 * Four numbers that stand for the work, set as one hairline-ruled line.
 *
 * The fourth cell is a word rather than a number, so it is spelled out instead
 * of being forced into the same shape as the three counts beside it.
 */
import type { FeaturedProject } from '../../lib/types';

interface Props {
	postCount: number;
	projects: FeaturedProject[];
	yearsBuilding: number;
}

const { postCount, projects, yearsBuilding } = Astro.props;

/** Stars across the featured repos, rounded down to a round number. */
const starTotal = projects.reduce((sum, project) => sum + project.stars, 0);
const starCount = starTotal >= 100 ? Math.floor(starTotal / 50) * 50 : starTotal;
const starSuffix = starTotal >= 100 ? '+' : '';

const facts = [
	{ value: `${yearsBuilding}+`, label: 'years building software' },
	{ value: String(postCount), label: 'technical posts' },
	{ value: `${starCount}${starSuffix}`, label: 'GitHub stars' },
	{ value: 'Rust', label: '+ TypeScript, Nix' }
];
---

<section class="facts">
	<div class="facts-row shell">
		{
			facts.map((fact, i) => (
				<div class="fact" data-reveal data-reveal-delay={i * 60}>
					<div class="fact-value">{fact.value}</div>
					<div class="fact-label">{fact.label}</div>
				</div>
			))
		}
	</div>
</section>

<style>
	.facts {
		border-block: 1px solid var(--line);
	}
	.facts-row {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(2rem, 5vw, 4rem);
		padding-block: clamp(3rem, 6vw, 4.5rem);
	}
	.fact {
		min-width: 0;
		padding-left: 1.25rem;
		border-left: 1px solid var(--line-strong);
	}
	/* Oldstyle numerals where the face has them — the value set with the
	   page's voice, not with a dashboard's tabular figures. */
	.fact-value {
		font-family: var(--font-serif);
		font-size: clamp(2.4rem, 4.5vw, 3.6rem);
		font-weight: 500;
		letter-spacing: -0.02em;
		line-height: 1;
		font-variant-numeric: oldstyle-nums;
		transition: color 0.25s ease;
	}
	.fact-label {
		max-width: 18ch;
		margin-top: 0.75rem;
		font-size: 0.85rem;
		line-height: 1.45;
		color: var(--muted);
	}
	.fact:hover .fact-value {
		color: var(--accent-warm);
	}
	@media (width >= 48rem) {
		.facts-row {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
</style>

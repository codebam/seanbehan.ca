---
/**
 * LATEST WRITING, as a lead essay and an index.
 *
 * The newest post is the lead — its title set at the size a front-page story
 * gets, with its own description under it. Everything after it runs as a
 * stacked index in the next column, ruled entry to ruled entry. The archive
 * still uses PostList; this is the front page's own arrangement, not a second
 * list component pretending to be one.
 */
import { writingHref } from '../../lib/site';
import type { PostSummary } from '../../lib/types';

interface Props {
	posts: PostSummary[];
	/** Every published post, for the "All N posts" link — `posts` is the front page's slice. */
	total: number;
}

const { posts, total } = Astro.props;
const [lead, ...rest] = posts;

/** "Apr 2026" — the day is never what a reader is after in a list. */
const monthYear = (date: string) =>
	new Date(date).toLocaleDateString('en-CA', { month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<section class="writing shell">
	<header class="section-head" data-reveal>
		<h2 class="display display-lg">Latest writing</h2>
		<a href={writingHref('/posts')} class="link-accent whitespace-nowrap"
			>All {total} posts <span class="arrow">&rarr;</span></a
		>
	</header>

	{
		lead && (
			<div class="writing-grid">
				<article class="writing-lead" data-reveal>
					<p class="entry-meta">
						<time datetime={lead.meta.date}>{monthYear(lead.meta.date)}</time>
						{lead.readingMinutes && <span>· {lead.readingMinutes} min read</span>}
					</p>
					<h3 class="lead-title">
						<a href={writingHref(lead.path)}>{lead.meta.title}</a>
					</h3>
					{lead.meta.description && <p class="lead-deck">{lead.meta.description}</p>}
					<p class="lead-more">
						<a href={writingHref(lead.path)} class="link-accent">
							Read the post <span class="arrow">&rarr;</span>
						</a>
					</p>
				</article>

				<div class="writing-list">
					{rest.map((post, i) => (
						<article class="writing-item" data-reveal data-reveal-delay={Math.min(i, 3) * 60}>
							<p class="entry-meta">
								<time datetime={post.meta.date}>{monthYear(post.meta.date)}</time>
							</p>
							<h3 class="entry-title">
								<a href={writingHref(post.path)}>{post.meta.title}</a>
							</h3>
							{post.meta.description && <p class="entry-copy">{post.meta.description}</p>}
						</article>
					))}
				</div>
			</div>
		)
	}
</section>

<style>
	.writing {
		padding-block: clamp(2.5rem, 5vw, 4rem) clamp(4rem, 8vw, 7rem);
	}

	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 2rem;
		padding-bottom: 0.9rem;
		border-bottom: 2px solid var(--text);
	}

	.writing-grid {
		display: grid;
		gap: 0 clamp(2rem, 5vw, 4rem);
	}
	@media (width >= 48rem) {
		.writing-grid {
			grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
		}
	}

	.writing-lead {
		padding-block: clamp(1.75rem, 3.5vw, 2.5rem);
		border-bottom: 1px solid var(--line);
	}
	@media (width >= 48rem) {
		.writing-lead {
			border-bottom: 0;
		}
	}

	.entry-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.55rem;
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.lead-title,
	.entry-title {
		font-family: var(--font-serif);
		font-weight: 500;
		letter-spacing: -0.02em;
		text-wrap: balance;
	}
	.lead-title {
		margin-top: 0.6rem;
		font-size: clamp(1.9rem, 3.4vw, 2.7rem);
		line-height: 1.08;
	}
	.entry-title {
		margin-top: 0.35rem;
		font-size: 1.3rem;
		line-height: 1.2;
	}
	.lead-title a,
	.entry-title a {
		color: var(--text);
		text-decoration: none;
		transition: color 0.2s ease;
	}
	.lead-title a:hover,
	.lead-title a:focus-visible,
	.entry-title a:hover,
	.entry-title a:focus-visible {
		color: var(--accent);
	}

	.lead-deck {
		max-width: 52ch;
		margin-top: 0.9rem;
		font-family: var(--font-serif);
		font-size: 1.08rem;
		line-height: 1.65;
		color: var(--body);
		text-wrap: pretty;
	}
	.lead-more {
		margin-top: 1.1rem;
	}
	.entry-copy {
		margin-top: 0.5rem;
		font-family: var(--font-serif);
		font-size: 0.95rem;
		line-height: 1.55;
		color: var(--body);
		text-wrap: pretty;
	}

	.writing-item {
		padding-block: clamp(1.35rem, 3vw, 1.9rem);
		border-top: 1px solid var(--line);
	}

	@media (width < 48rem) {
		.section-head {
			flex-wrap: wrap;
			gap: 0.5rem 2rem;
		}
	}
</style>

---
/**
 * LATEST WRITING
 *
 * The newest post is the lead card; the rest run as a grid of smaller cards.
 * The archive still uses PostList; this is the front page's own arrangement.
 */
import { writingHref } from '../../lib/site';
import type { PostSummary } from '../../lib/types';

interface Props {
	posts: PostSummary[];
	/** Every published post, for the "All N posts" link — `posts` is the front page's slice. */
	total: number;
}

const { posts, total } = Astro.props;
const [lead, ...rest] = posts;

/** "Apr 2026" — the day is never what a reader is after in a list. */
const monthYear = (date: string) =>
	new Date(date).toLocaleDateString('en-CA', { month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<section class="writing shell">
	<header class="section-head" data-reveal>
		<div>
			<h2 class="display display-lg">Latest writing</h2>
			<p class="section-sub">Notes from whatever I am taking apart.</p>
		</div>
		<a href={writingHref('/posts')} class="link-accent">
			All {total} posts <span class="arrow">&rarr;</span>
		</a>
	</header>

	{lead && (
		<article class="writing-lead card" data-reveal>
			<p class="entry-meta">
				<time datetime={lead.meta.date}>{monthYear(lead.meta.date)}</time>
				{lead.readingMinutes && <span>· {lead.readingMinutes} min read</span>}
			</p>
			<h3 class="writing-lead-title">
				<a href={writingHref(lead.path)}>{lead.meta.title}</a>
			</h3>
			{lead.meta.description && <p class="writing-lead-desc">{lead.meta.description}</p>}
			<p class="writing-lead-more">
				<a href={writingHref(lead.path)} class="link-accent">
					Read the post <span class="arrow">&rarr;</span>
				</a>
			</p>
		</article>
	)}

	<div class="writing-grid">
		{rest.map((post, i) => (
			<article class="writing-card card" data-reveal data-reveal-delay={Math.min(i, 3) * 60}>
				<p class="entry-meta">
					<time datetime={post.meta.date}>{monthYear(post.meta.date)}</time>
				</p>
				<h3 class="writing-card-title">
					<a href={writingHref(post.path)}>{post.meta.title}</a>
				</h3>
				{post.meta.description && <p class="writing-card-desc">{post.meta.description}</p>}
			</article>
		))}
	</div>
</section>

<style>
	.writing {
		padding-block: clamp(3.5rem, 7vw, 5.5rem) clamp(4.5rem, 9vw, 7rem);
	}
	.section-sub {
		margin-top: 0.35rem;
		font-size: 0.95rem;
		color: var(--muted);
	}

	.entry-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.4rem;
		font-size: 0.8rem;
		font-weight: 500;
		color: var(--muted);
	}

	.writing-lead {
		padding: clamp(1.5rem, 3vw, 2.5rem);
	}
	.writing-lead-title {
		max-width: 30ch;
		margin-top: 0.6rem;
		font-size: clamp(1.5rem, 2.8vw, 2rem);
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.2;
	}
	.writing-lead-title a,
	.writing-card-title a {
		color: var(--text);
		text-decoration: none;
		transition: color 0.2s ease;
	}
	.writing-lead-title a:hover,
	.writing-lead-title a:focus-visible,
	.writing-card-title a:hover,
	.writing-card-title a:focus-visible {
		color: var(--accent);
	}
	.writing-lead-desc {
		max-width: 62ch;
		margin-top: 0.75rem;
		font-size: 1.02rem;
		line-height: 1.65;
		color: var(--body);
	}
	.writing-lead-more {
		margin-top: 1.25rem;
	}

	.writing-grid {
		display: grid;
		gap: 1.25rem;
		margin-top: 1.25rem;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
	}
	.writing-card {
		padding: 1.5rem;
	}
	.writing-card-title {
		margin-top: 0.5rem;
		font-size: 1.15rem;
		font-weight: 600;
		letter-spacing: -0.015em;
		line-height: 1.3;
	}
	.writing-card-desc {
		margin-top: 0.5rem;
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--body);
	}
</style>

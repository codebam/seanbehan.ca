---
import Base from '../../layouts/Base.astro';
import Masthead from '../../components/Masthead.astro';
import { Button } from '@cloudflare/kumo/components/button';
import { PRODUCT } from '../../lib/product';
import { site } from '../../lib/site';
import { SITES } from '../../lib/site.data.js';

const PRODUCT_NAME = PRODUCT.name;
const PRICE = PRODUCT.price;
const CURRENCY = PRODUCT.currency;
const canonical = PRODUCT.url;

const release = PRODUCT.currentRelease;
const releasedAt = new Date(release.releasedAt * 1000);
const releaseDate = releasedAt.toLocaleDateString('en-CA', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
	timeZone: 'UTC'
});
const archiveSize = `${Math.ceil(release.size / 1024)} KiB`;
const ogImage = `${SITES.seanbehan.url}/og/${PRODUCT.id}.png`;

/** Sanitized from `unzip -l` of releases/…-v1.0.0.zip; lockfiles elided. */
const fileTree = [
	'cloudflare-workers-production-kit/',
	'├─ .github/workflows/   ci.yml · deploy.yml',
	'├─ docs/                architecture · configuration · deployment · security · operations',
	'├─ migrations/          0001_initial.sql',
	'├─ public/              favicon.svg',
	'├─ scripts/             release-check.mjs',
	'├─ src/',
	'│  ├─ layouts/          Base.astro',
	'│  ├─ lib/              auth · config · crypto · db · github · http · validation',
	'│  ├─ pages/            api/files · api/health · auth · dashboard.astro · index.astro',
	'│  ├─ styles/           global.css',
	'│  ├─ env.d.ts · middleware.ts',
	'├─ test/                crypto.test.ts · validation.test.ts',
	'├─ CHANGELOG.md · PRODUCT-LICENSE.md · THIRD-PARTY-NOTICES.md · README.md',
	'└─ astro.config.mjs · package.json · tsconfig.json · vitest.config.ts · wrangler.jsonc'
].join('\n');

/** The v1.0.0 entry from the archive's CHANGELOG.md. */
const changelog = [
	'Initial Astro and Cloudflare Worker reference application.',
	'D1 users, hashed sessions and owner-scoped file metadata.',
	'GitHub OAuth with state, PKCE and an optional numeric-ID allowlist.',
	'Private R2 upload, download and delete flow.',
	'Origin checks, security headers and rate-limit bindings.',
	'CI, deployment workflow, tests, release scan and operations handbook.'
];

/** Trust-boundary notes from the archive's docs/architecture.md. */
const handbookSample = [
	'GitHub numeric ID is durable identity. Login name is display metadata.',
	'D1 is the authorization record. R2 metadata never grants access.',
	'The R2 bucket stays private; downloads pass through the owner check in the Worker.',
	'APP_ORIGIN is deployment configuration, never inferred from request headers.'
];

const modules = [
	{
		title: 'Worker foundation',
		copy: 'Astro server rendering on Cloudflare Workers, strict TypeScript, local development and production configuration.'
	},
	{
		title: 'D1 data layer',
		copy: 'Schema, migrations, typed queries and transaction patterns with fixtures that make local work repeatable.'
	},
	{
		title: 'R2 uploads',
		copy: 'Validated uploads, object metadata, safe download responses and cleanup paths for abandoned files.'
	},
	{
		title: 'Authentication',
		copy: 'Session handling, protected routes and authorization boundaries that stay explicit at the edge.'
	},
	{
		title: 'Abuse controls',
		copy: 'Rate limiting, input validation, cache rules and security headers with notes on the tradeoffs.'
	},
	{
		title: 'Operations',
		copy: 'CI deployment, environment separation, structured errors, monitoring hooks and a practical release runbook.'
	}
];

const steps = [
	[
		'Clone',
		'Start from a small working application rather than a directory of disconnected examples.'
	],
	[
		'Configure',
		'Set bindings and secrets from one documented inventory for local, preview and production.'
	],
	['Adapt', 'Remove sample features and keep the production boundaries your service needs.'],
	['Ship', 'Run checks, migrate D1 and deploy through the included GitHub Actions workflow.']
];

const schema = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'Product',
	'@id': `${canonical}#product`,
	name: PRODUCT_NAME,
	description:
		'A deployment-ready Astro and Cloudflare Workers reference starter with D1, R2, authentication, security, deployment and operations guidance.',
	url: canonical,
	image: ogImage,
	brand: { '@type': 'Brand', name: 'Sean Behan' },
	offers: {
		'@type': 'Offer',
		url: canonical,
		price: PRICE,
		priceCurrency: CURRENCY,
		availability: 'https://schema.org/InStock',
		category: 'Digital product'
	}
}).replace(/</g, '\\u003c');
---

<Base
	title={PRODUCT_NAME}
	description="Ship an Astro service on Cloudflare Workers with D1, R2, authentication, security and deployment already wired together."
	ogTitle={`${PRODUCT_NAME} — Sean Behan`}
	canonical={canonical}
	image={`/og/${PRODUCT.id}.png`}
>
	<script slot="head" type="application/ld+json" is:inline set:html={schema}></script>
	<Masthead
		label="Digital product / Production kit"
		meta={`$${PRICE} ${CURRENCY} / one-time · v${release.version}`}
	>
		<Fragment slot="title">
			Ship the service. <em>Skip the plumbing.</em>
		</Fragment>
		<p>
			A deployment-ready Astro and Cloudflare Workers reference starter with D1, R2, authentication,
			security, deployment and operating notes wired into one coherent system.
		</p>
		<div class="masthead-actions">
			<form method="post" action={PRODUCT.checkoutPath}>
				<Button type="submit" variant="primary" size="lg" className="flat-control site-cta">
					Buy the production kit
				</Button>
			</form>
			<span class="eyebrow checkout-note">Immediate download</span>
		</div>
		<p class="purchase-terms masthead-terms">
			Questions or delivery trouble: <a href={`mailto:${site.email}`}>{site.email}</a> — email
			support, no guaranteed response time.
		</p>
		<p class="purchase-terms masthead-terms">
			By purchasing, you agree to the <a href="/legal/terms-of-sale">Terms of Sale</a>,{' '}
			<a href="/legal/refund-policy">Refund Policy</a>, and{' '}
			<a href="/legal/product-license">Product License</a>. See the{' '}
			<a href="/legal/privacy">Privacy Policy</a>.
		</p>
		<!-- The kit is intangible, so the hero carries exactly one figure: the
		     mark, drawn in the line colour because the headline already spends the
		     page's warm accent. Both schemes get a plate of their own ground. -->
		<figure slot="figure" class="kit-figure">
			<picture>
				<source
					media="(prefers-color-scheme: dark)"
					srcset="/img/brand/figure-product-dark.webp"
					width="320"
					height="320"
				/>
				<img
					src="/img/brand/figure-product-light.webp"
					alt=""
					width="320"
					height="320"
					decoding="async"
				/>
			</picture>
			<figcaption>Fig. 1 — One archive, {modules.length} modules, one deploy path.</figcaption>
		</figure>
	</Masthead>

	<!-- Not `contents`: that is a Tailwind utility (display:contents), emitted
	     because Kumo markup uses the class too, and it would dissolve the
	     section's box — padding, background and border all lost. -->
	<section class="panel modules">
		<div class="shell">
			<div class="section-heading" data-reveal>
				<h2 class="display display-lg">What ships</h2>
				<p>{modules.length} production modules</p>
			</div>

			<div class="module-grid">
				{modules.map((module, i) => (
					<article data-reveal data-reveal-delay={Math.min(i, 4) * 45}>
						<h3>{module.title}</h3>
						<p>{module.copy}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<!-- OPERATOR CONTENT: the product has no stills today — public/img holds
	     marketing ads, not screenshots — so this section shows the real archive
	     structure and text instead of a stand-in image. Add 2–3 real stills
	     (handbook page, code, dashboard) here with alt text and dimensions. -->
	<section class="section inside panel">
		<div class="shell">
			<div class="section-heading" data-reveal>
				<h2 class="display display-lg">What&rsquo;s inside</h2>
				<p>
					v{release.version} · released {releaseDate}
				</p>
			</div>

			<div class="inside-grid">
				<div data-reveal>
					<h3>Sanitized file tree</h3>
					<pre class="file-tree"><code>{fileTree}</code></pre>
					<p class="inside-note">
						44 files in 16 directories; {archiveSize} archive. Lockfiles elided above. SHA-256
						<code>{release.sha256}</code>.
					</p>
				</div>
				<div data-reveal data-reveal-delay="60">
					<h3>Changelog — v{release.version}</h3>
					<ul class="changelog-list">
						{changelog.map((item) => (
							<li>{item}</li>
						))}
					</ul>
					<details class="handbook-sample">
						<summary>Sample the handbook: trust boundaries</summary>
						<p>
							From <code>docs/architecture.md</code> in the archive:
						</p>
						<ul>
							{handbookSample.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</details>
				</div>
			</div>
		</div>
	</section>

	<section class="section workflow panel-alt">
		<div class="shell">
			<div class="section-heading" data-reveal>
				<h2 class="display display-lg">Clone to deploy</h2>
				<p>One documented path</p>
			</div>

			<ol class="workflow-list">
				{steps.map(([title, copy], i) => (
					<li data-reveal data-reveal-delay={i * 50}>
						<span class="step-index">{String(i + 1).padStart(2, '0')}</span>
						<h3>{title}</h3>
						<p>{copy}</p>
					</li>
				))}
			</ol>
		</div>
	</section>

	<section class="section offer panel-alt">
		<div class="shell">
			<div class="offer-grid">
				<div data-reveal>
					<p class="eyebrow">One-time purchase</p>
					<h2 class="display display-lg mt-4">Own the foundation.</h2>
					<p class="offer-copy">
						Get the complete release for{' '}
						<strong>
							${PRICE} {CURRENCY}
						</strong>
						. Buyers receive the source tree, written handbook, example application and one year of
						product updates.
					</p>
				</div>

				<aside class="price-card" data-reveal data-reveal-delay="70" aria-label="Purchase terms">
					<p class="price">
						<span>$</span>
						{PRICE}
						<small> {CURRENCY}</small>
					</p>
					<p class="refund-note">
						Digital download, delivered immediately. Refunds cover duplicate purchase, failed
						delivery and material defects — not a change of mind. See the{' '}
						<a href="/legal/refund-policy">Refund Policy</a>.
					</p>
					<ul>
						<li>Commercial license for one purchaser and their team</li>
						<li>Complete source tree and downloadable archive</li>
						<li>Setup handbook and deployment runbook</li>
						<li>Updates for one year</li>
					</ul>
					<form method="post" action={PRODUCT.checkoutPath}>
						<Button type="submit" variant="primary" size="lg" className="flat-control site-cta">
							Buy the production kit
						</Button>
					</form>
					<p class="purchase-terms">
						Questions or delivery trouble: <a href={`mailto:${site.email}`}>{site.email}</a> — email
						support, no guaranteed response time.
					</p>
					<p class="purchase-terms terms">
						Secure checkout through Stripe. Immediate access after payment; applicable tax and local
						currency are shown at checkout. By purchasing, you agree to the{' '}
						<a href="/legal/terms-of-sale">Terms of Sale</a>,{' '}
						<a href="/legal/refund-policy">Refund Policy</a>, and{' '}
						<a href="/legal/product-license">Product License</a>. See the{' '}
						<a href="/legal/privacy">Privacy Policy</a>.
					</p>
				</aside>
			</div>
		</div>
	</section>

	<section class="section fit panel">
		<div class="shell">
			<div class="section-heading" data-reveal>
				<h2 class="display display-lg">Built for</h2>
				<p>Small teams / serious services</p>
			</div>

			<div class="fit-grid">
				<div data-reveal>
					<h3>Good fit</h3>
					<p>
						Developers shipping an API, SaaS, content service or internal tool on Cloudflare who
						want to own straightforward source instead of adopting a platform-sized framework.
						Cloudflare experience still helps.
					</p>
				</div>
				<div data-reveal data-reveal-delay="55">
					<h3>Not a fit</h3>
					<p>
						A visual page builder, managed backend, generic component library or promise that one
						architecture fits every workload.
					</p>
				</div>
			</div>
		</div>
	</section>
</Base>

<style>
	.checkout-note {
		align-self: center;
	}
	.kit-figure {
		margin: 0;
	}
	/* The caption is what makes it a figure rather than decoration. */
	.kit-figure figcaption {
		margin-top: 0.75rem;
		font-size: 0.8125rem;
		line-height: 1.55;
		color: var(--muted);
	}
	.masthead-terms {
		max-width: 66ch;
		margin-top: 1rem;
	}
	.purchase-terms {
		font-size: 0.8125rem;
		line-height: 1.6;
		color: var(--muted);
	}
	.purchase-terms a {
		color: var(--text);
		text-decoration: underline;
		text-decoration-color: var(--line-strong);
		text-underline-offset: 0.18em;
	}
	.purchase-terms a:hover {
		color: var(--accent);
	}
	.price-card form {
		display: flex;
	}
	.price-card form :global(button) {
		width: 100%;
	}
	.modules,
	.module-grid {
		display: grid;
		gap: 0 1.25rem;
	}
	.module-grid {
		margin-top: 2rem;
	}
	.module-grid article {
		padding-block: 1.25rem;
		border-top: 1px solid var(--line);
	}
	.module-grid h3,
	.workflow-list h3,
	.fit-grid h3 {
		font-size: 1.125rem;
		font-weight: 600;
		letter-spacing: -0.01em;
	}
	.module-grid p,
	.workflow-list p,
	.fit-grid p {
		margin-top: 0.55rem;
		font-size: 0.9375rem;
		line-height: 1.65;
		color: var(--body);
	}
	.workflow-list {
		display: grid;
		gap: 0 1.25rem;
		margin-top: 2rem;
		list-style: none;
	}
	.workflow-list li {
		padding-block: 1.25rem;
		border-top: 1px solid var(--line);
	}
	.step-index {
		display: block;
		font-size: 0.8125rem;
		font-weight: 500;
		font-variant-numeric: tabular-nums;
		color: var(--muted);
	}
	.workflow-list h3 {
		margin-top: 0.5rem;
	}
	.offer-grid {
		display: grid;
		align-items: start;
		gap: 2rem;
	}
	.offer-grid h2 {
		max-width: 14ch;
	}
	.offer-copy {
		max-width: 52ch;
		margin-top: 1.25rem;
		font-size: 1.0625rem;
		line-height: 1.7;
		color: var(--body);
	}
	/* The purchase panel is the page's one loud block, and it is loud by
	   contents — a large price over a ruled list — rather than by a fill. */
	.price-card {
		padding-top: 1.75rem;
		border-top: 1px solid var(--line);
	}
	.price {
		font-size: clamp(2.5rem, 4.5vw, 3.25rem);
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1;
	}
	.price span,
	.price small {
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--muted);
	}
	.price-card ul {
		display: grid;
		gap: 0.6rem;
		margin-block: 1.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--line);
		list-style: none;
		font-size: 0.9375rem;
		color: var(--body);
	}
	.price-card li::before {
		content: '—';
		margin-right: 0.65rem;
		color: var(--dim);
	}
	.terms {
		margin-top: 1.25rem;
	}
	.fit-grid {
		display: grid;
		gap: 0 1.25rem;
		margin-top: 2rem;
	}
	.fit-grid > div {
		padding-block: 1.25rem;
		border-top: 1px solid var(--line);
	}
	@media (width >= 48rem) {
		.module-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
		.workflow-list {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
		.fit-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.offer-grid {
			grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.7fr);
			gap: 4rem;
		}
	}
	.inside-grid {
		display: grid;
		gap: 2rem;
		margin-top: 1.5rem;
	}
	.inside-grid h3 {
		font-size: 1.15rem;
		font-weight: 600;
		letter-spacing: -0.015em;
	}
	.file-tree {
		margin-top: 1rem;
		overflow-x: auto;
		padding: 1.25rem;
		background: var(--surface-alt);
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		line-height: 1.7;
		color: var(--body);
	}
	.inside-note {
		margin-top: 0.85rem;
		font-size: 0.8125rem;
		line-height: 1.6;
		color: var(--muted);
	}
	.inside-note code {
		word-break: break-all;
	}
	.changelog-list {
		display: grid;
		gap: 0.5rem;
		margin-top: 1rem;
		list-style: none;
		font-size: 0.9375rem;
		line-height: 1.65;
		color: var(--body);
	}
	.changelog-list li::before {
		content: '—';
		margin-right: 0.65rem;
		color: var(--dim);
	}
	.handbook-sample {
		margin-top: 1.5rem;
		padding: 1.25rem;
		background: var(--surface-alt);
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
	}
	.handbook-sample summary {
		cursor: pointer;
		font-size: 0.9375rem;
		font-weight: 600;
		color: var(--text);
	}
	.handbook-sample p,
	.handbook-sample ul {
		margin-top: 0.85rem;
		font-size: 0.9375rem;
		line-height: 1.65;
		color: var(--body);
	}
	.handbook-sample ul {
		display: grid;
		gap: 0.45rem;
		list-style: none;
	}
	.handbook-sample li::before {
		content: '—';
		margin-right: 0.65rem;
		color: var(--dim);
	}
	.refund-note {
		margin-top: 0.75rem;
		font-size: 0.8125rem;
		line-height: 1.6;
		color: var(--muted);
	}
	.refund-note a {
		color: var(--text);
		text-decoration: underline;
		text-decoration-color: var(--line-strong);
		text-underline-offset: 0.18em;
	}
	@media (width >= 48rem) {
		.inside-grid {
			grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
			gap: 3rem;
		}
	}
</style>

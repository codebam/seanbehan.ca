---
import Base from '../../layouts/Base.astro';
import Masthead from '../../components/Masthead.astro';
import { Button } from '@cloudflare/kumo/components/button';
import { PRODUCT } from '../../lib/product';

const PRODUCT_NAME = PRODUCT.name;
const PRICE = PRODUCT.price;
const CURRENCY = PRODUCT.currency;
const canonical = PRODUCT.url;

const modules = [
	{
		title: 'Worker foundation',
		copy: 'Astro server rendering on Cloudflare Workers, strict TypeScript, local development and production configuration.'
	},
	{
		title: 'D1 data layer',
		copy: 'Schema, migrations, typed queries and transaction patterns with fixtures that make local work repeatable.'
	},
	{
		title: 'R2 uploads',
		copy: 'Validated uploads, object metadata, safe download responses and cleanup paths for abandoned files.'
	},
	{
		title: 'Authentication',
		copy: 'Session handling, protected routes and authorization boundaries that stay explicit at the edge.'
	},
	{
		title: 'Abuse controls',
		copy: 'Rate limiting, input validation, cache rules and security headers with notes on the tradeoffs.'
	},
	{
		title: 'Operations',
		copy: 'CI deployment, environment separation, structured errors, monitoring hooks and a practical release runbook.'
	}
];

const steps = [
	[
		'Clone',
		'Start from a small working application rather than a directory of disconnected examples.'
	],
	[
		'Configure',
		'Set bindings and secrets from one documented inventory for local, preview and production.'
	],
	['Adapt', 'Remove sample features and keep the production boundaries your service needs.'],
	['Ship', 'Run checks, migrate D1 and deploy through the included GitHub Actions workflow.']
];

const schema = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'Product',
	'@id': `${canonical}#product`,
	name: PRODUCT_NAME,
	description:
		'A deployment-ready Astro and Cloudflare Workers reference starter with D1, R2, authentication, security, deployment and operations guidance.',
	url: canonical,
	brand: { '@type': 'Brand', name: 'codebam' },
	offers: {
		'@type': 'Offer',
		url: canonical,
		price: PRICE,
		priceCurrency: CURRENCY,
		availability: 'https://schema.org/InStock',
		category: 'Digital product'
	}
}).replace(/</g, '\\u003c');
---

<Base
	title={PRODUCT_NAME}
	description="Ship an Astro service on Cloudflare Workers with D1, R2, authentication, security and deployment already wired together."
	ogTitle={`${PRODUCT_NAME} — codebam`}
	canonical={canonical}
>
	<script slot="head" type="application/ld+json" is:inline set:html={schema} />

	<Masthead label="Digital product / Production kit" meta={`$${PRICE} ${CURRENCY} / one-time`}>
		<Fragment slot="title">Ship the service. <em>Skip the plumbing.</em></Fragment>
		<p>
			A deployment-ready Astro and Cloudflare Workers reference starter with D1, R2, authentication,
			security, deployment and operating notes wired into one coherent system.
		</p>
		<div class="masthead-actions">
			<form method="post" action={PRODUCT.checkoutPath}>
				<Button type="submit" variant="primary" size="lg" className="flat-control">
					Buy the production kit
				</Button>
			</form>
			<span class="checkout-note">Immediate download</span>
		</div>
		<p class="purchase-terms masthead-terms">
			By purchasing, you agree to the <a href="/legal/terms-of-sale">Terms of Sale</a>, <a
				href="/legal/refund-policy">Refund Policy</a
			>, and <a href="/legal/product-license">Product License</a>. See the <a href="/legal/privacy"
				>Privacy Policy</a
			>.
		</p>
	</Masthead>

	<!-- Not `contents`: that is a Tailwind utility (display:contents), emitted
	     because Kumo markup uses the class too, and it would dissolve the
	     section's box — padding, background and border all lost. -->
	<section class="panel modules">
		<div class="shell">
			<div class="section-heading" data-reveal>
				<h2 class="display display-lg">What ships</h2>
				<p>{modules.length} production modules</p>
			</div>

			<div class="module-grid">
				{
					modules.map((module, i) => (
						<article data-reveal data-reveal-delay={Math.min(i, 4) * 45}>
							<h3>{module.title}</h3>
							<p>{module.copy}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="workflow panel-alt">
		<div class="shell">
			<div class="section-heading" data-reveal>
				<h2 class="display display-lg">Clone to deploy</h2>
				<p>One documented path</p>
			</div>

			<ol class="workflow-list">
				{
					steps.map(([title, copy], i) => (
						<li data-reveal data-reveal-delay={i * 50}>
							<span class="step-index">{String(i + 1).padStart(2, '0')}</span>
							<h3>{title}</h3>
							<p>{copy}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="offer panel-alt">
		<div class="shell">
			<div class="offer-grid">
				<div data-reveal>
					<p class="eyebrow">One-time purchase</p>
					<h2 class="display display-lg mt-4">Own the foundation.</h2>
					<p class="offer-copy">
						Get the complete release for <strong>${PRICE} {CURRENCY}</strong>. Buyers receive the
						source tree, written handbook, example application and one year of product updates.
					</p>
				</div>

				<aside class="price-card" data-reveal data-reveal-delay="70" aria-label="Purchase terms">
					<p class="price"><span>$</span>{PRICE}<small> {CURRENCY}</small></p>
					<ul>
						<li>Commercial license for one purchaser and their team</li>
						<li>Complete source tree and downloadable archive</li>
						<li>Setup handbook and deployment runbook</li>
						<li>Updates for one year</li>
					</ul>
					<form method="post" action={PRODUCT.checkoutPath}>
						<Button type="submit" variant="primary" size="lg" className="flat-control">
							Buy the production kit
						</Button>
					</form>
					<p class="purchase-terms terms">
						Secure checkout through Stripe. Immediate access after payment; applicable tax and local
						currency are shown at checkout. By purchasing, you agree to the <a
							href="/legal/terms-of-sale">Terms of Sale</a
						>, <a href="/legal/refund-policy">Refund Policy</a>, and <a
							href="/legal/product-license">Product License</a
						>. See the <a href="/legal/privacy">Privacy Policy</a>.
					</p>
				</aside>
			</div>
		</div>
	</section>

	<section class="fit panel">
		<div class="shell">
			<div class="section-heading" data-reveal>
				<h2 class="display display-lg">Built for</h2>
				<p>Small teams / serious services</p>
			</div>

			<div class="fit-grid">
				<div data-reveal>
					<h3>Good fit</h3>
					<p>
						Developers shipping an API, SaaS, content service or internal tool on Cloudflare who
						want to own straightforward source instead of adopting a platform-sized framework.
					</p>
				</div>
				<div data-reveal data-reveal-delay="55">
					<h3>Not a fit</h3>
					<p>
						A visual page builder, managed backend, generic component library or promise that one
						architecture fits every workload. Cloudflare experience still helps.
					</p>
				</div>
			</div>
		</div>
	</section>
</Base>

<style>
	.checkout-note,
	.section-heading > p {
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.checkout-note {
		align-self: center;
	}
	.masthead-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem;
		margin-top: 2rem;
	}
	.masthead-terms {
		max-width: 66ch;
		margin-top: 1rem;
	}
	.purchase-terms {
		font-family: var(--font-sans);
		font-size: 0.78rem;
		line-height: 1.55;
		color: var(--muted);
	}
	.purchase-terms a {
		color: var(--text);
		text-decoration: underline;
		text-decoration-color: var(--line-strong);
		text-underline-offset: 0.18em;
	}
	.purchase-terms a:hover {
		color: var(--accent);
	}
	.price-card form {
		display: flex;
	}
	.price-card form :global(button) {
		width: 100%;
	}
	.modules,
	.workflow,
	.offer,
	.fit {
		padding-block: clamp(4.5rem, 9vw, 8rem);
		border-top: 1px solid var(--line);
	}
	.section-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 2rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--line-strong);
	}
	.module-grid {
		display: grid;
		gap: 2.5rem 3.5rem;
		margin-top: clamp(2.5rem, 5vw, 4rem);
	}
	.module-grid article {
		min-width: 0;
		padding-left: 1.25rem;
		border-left: 1px solid var(--line-strong);
	}
	.module-grid h3,
	.workflow-list h3,
	.fit-grid h3 {
		font-family: var(--font-serif);
		font-size: clamp(1.35rem, 2.2vw, 1.8rem);
		font-weight: 500;
		letter-spacing: -0.01em;
	}
	.module-grid p,
	.workflow-list p,
	.fit-grid p {
		margin-top: 0.6rem;
		font-family: var(--font-serif);
		font-size: 1rem;
		line-height: 1.65;
		color: var(--body);
	}
	.workflow-list {
		display: grid;
		gap: 2.5rem 0;
		margin-top: clamp(2.5rem, 5vw, 4rem);
		list-style: none;
	}
	.workflow-list li {
		padding-left: 1.25rem;
		border-left: 1px solid var(--line-strong);
	}
	.step-index {
		display: block;
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		color: var(--accent-warm);
	}
	.workflow-list h3 {
		margin-top: 0.6rem;
	}
	.offer-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.7fr);
		align-items: start;
		gap: clamp(3rem, 8vw, 8rem);
	}
	.offer-grid h2 {
		max-width: 12ch;
	}
	.offer-copy {
		max-width: 52ch;
		margin-top: 1.5rem;
		font-family: var(--font-serif);
		font-size: 1.12rem;
		line-height: 1.7;
		color: var(--body);
	}
	.price-card {
		padding: clamp(1.5rem, 4vw, 2.5rem);
		border: 1px solid var(--line-strong);
		border-radius: 3px;
		background: var(--panel);
	}
	.price {
		font-family: var(--font-serif);
		font-size: clamp(3.2rem, 6vw, 4.8rem);
		font-weight: 500;
		letter-spacing: -0.03em;
		line-height: 1;
	}
	.price span,
	.price small {
		font-family: var(--font-sans);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		color: var(--accent-warm);
	}
	.price-card ul {
		display: grid;
		gap: 0.6rem;
		margin-block: 1.75rem;
		padding-top: 1.75rem;
		border-top: 1px solid var(--line);
		list-style: none;
		font-size: 0.92rem;
		color: var(--body);
	}
	.price-card li::before {
		content: '—';
		margin-right: 0.65rem;
		color: var(--accent);
	}
	.terms {
		margin-top: 1.25rem;
	}
	.fit-grid {
		display: grid;
		gap: 2.5rem 3.5rem;
		margin-top: clamp(2.5rem, 5vw, 4rem);
	}
	.fit-grid > div {
		padding-left: 1.25rem;
		border-left: 1px solid var(--line-strong);
	}
	@media (width >= 48rem) {
		.module-grid {
			grid-template-columns: repeat(3, 1fr);
		}
		.workflow-list {
			grid-template-columns: repeat(4, 1fr);
			gap: 0 3rem;
		}
		.fit-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (width < 48rem) {
		.section-heading {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.75rem;
		}
		.offer-grid {
			grid-template-columns: 1fr;
		}
	}
</style>

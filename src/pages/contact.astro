---
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import Availability from '../components/Availability.astro';
import { site, LINKEDIN_URL } from '../lib/site';

/**
 * Ordered by who is reading, not by how interesting the channel is.
 *
 * The list used to run Email, GitHub, Mastodon, Matrix, LinkedIn, PGP — which
 * is the order a fellow enthusiast would want, and puts the two channels a
 * hiring manager actually uses behind three they do not. Email and LinkedIn
 * lead on the variant that pitches the person; the rest keep their order,
 * because on the handle's front door they are the point.
 */
const channels = [
	{
		label: 'Email',
		value: site.email,
		href: `mailto:${site.email}`,
		note: 'Best for anything that needs a reply'
	},
	// Same reasoning as the résumé: a recruiter channel does not belong on the
	// variant that leads with the code.
	...(site.showResume
		? [
				{
					label: 'LinkedIn',
					value: 'Sean Behan',
					href: LINKEDIN_URL,
					note: 'Work history and references'
				}
			]
		: []),
	{
		label: 'GitHub',
		value: '@codebam',
		href: 'https://github.com/codebam',
		note: 'Issues and pull requests welcome'
	},
	{
		label: 'Mastodon',
		value: '@codebam@mstdn.ca',
		href: 'https://mstdn.ca/@codebam',
		note: 'Where I post the small stuff'
	},
	{
		label: 'Matrix',
		value: '@codebam:matrix.org',
		href: 'https://matrix.to/#/@codebam:matrix.org',
		note: 'End-to-end encrypted chat'
	},
	{
		label: 'PGP',
		value: 'publickey.txt',
		href: '/publickey.txt',
		note: 'Encrypt anything sensitive'
	}
];

/**
 * What to write in a first email, so the reply is useful on the first turn
 * rather than the third. Only on the hiring variant: a reader who came for the
 * code has nothing to fill in.
 *
 * No response time is promised anywhere in this section. A stated turnaround is
 * the kind of claim that ages badly — the first week it slips, the page is
 * lying to the person it is trying to convince. If a real figure is wanted it
 * belongs in site.data.js, beside the availability it would qualify.
 */
const askingFor = site.showResume
	? [
			'The role, and whether it is full-time or contract',
			'Remote, hybrid, or on-site — and where',
			'The stack, or the problem if the stack is not settled',
			'A link to the posting, if there is one'
		]
	: null;
---

<Base
	title="Contact"
	description={`Get in touch with ${site.name} — email${site.showResume ? ', LinkedIn' : ''}, GitHub.`}
	ogTitle={`Contact — ${site.name}`}
>
	<Masthead label="Ontario / Canada" meta="Replies by email">
		<Fragment slot="title">Say <em>hello.</em></Fragment>
		<div class="masthead-profile">
			<img src="/profile.webp" alt={site.name} width="180" height="180" />
			<p>
				{
					site.showResume
						? 'Email is the surest way to reach me. If you are hiring, contracting, or want to talk about something I built, say what you need and I will get back to you.'
						: 'Email is the surest way to reach me. Issues and pull requests go to GitHub; everything else can come here.'
				}
			</p>
		</div>
		<div class="masthead-availability">
			<Availability availability={site.availability} />
		</div>
		<p class="masthead-actions">
			<a class="link-accent" href={`mailto:${site.email}`}>{site.email}</a>
			<!-- Left empty on purpose: scripts/copy-address.ts fills it with a
			     button, so a reader without JS gets no control that cannot work
			     and the mailto link beside it is still the whole story. -->
			<span data-copy-text={site.email}></span>
		</p>
	</Masthead>

	{
		askingFor && (
			<section class="brief panel-alt">
				<div class="shell">
					<div class="section-heading" data-reveal>
						<h2 class="display display-lg">What to include</h2>
						<p>One email is enough</p>
					</div>
					<div class="brief-grid">
						<p class="brief-copy" data-reveal>
							A short note is all it takes. I read everything that is not a form-letter blast, and I
							would rather answer questions than have you guess.
						</p>
						<ul class="brief-list" data-reveal data-reveal-delay="60">
							{askingFor.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</div>
				</div>
			</section>
		)
	}

	<section class="channels panel">
		<div class="shell">
			<div class="section-heading" data-reveal>
				<h2 class="display display-lg">Open channels</h2>
				<p>{channels.length} ways to reach me</p>
			</div>

			<ul class="channel-list">
				{
					channels.map((channel, i) => (
						<li data-reveal data-reveal-delay={i * 55}>
							<a
								href={channel.href}
								target={channel.href.startsWith('http') ? '_blank' : undefined}
								rel={channel.href.startsWith('http') ? 'noopener noreferrer' : undefined}
							>
								<span class="channel-label">{channel.label}</span>
								<strong>{channel.value}</strong>
								<span class="channel-note">{channel.note}</span>
								<span class="channel-arrow" aria-hidden="true">
									&rarr;
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</Base>

<style>
	.masthead-profile {
		display: grid;
		grid-template-columns: 5rem 1fr;
		align-items: start;
		gap: 1.25rem;
	}
	.masthead-profile img {
		width: 5rem;
		aspect-ratio: 1;
		border: 1px solid var(--line-strong);
		border-radius: 3px;
		object-fit: cover;
	}
	.channels {
		padding-block: clamp(4.5rem, 9vw, 8rem);
		border-top: 1px solid var(--line);
	}
	.masthead-availability {
		margin-top: 1.5rem;
	}
	/* The one section on this page that asks something of the reader, so it
	   takes the alt fill the other pages give their closing brief. */
	.brief {
		padding-block: clamp(4.5rem, 9vw, 8rem);
		border-top: 1px solid var(--line);
	}
	.brief-grid {
		display: grid;
		gap: 2rem 3.5rem;
		margin-top: clamp(2.5rem, 5vw, 4rem);
	}
	.brief-copy {
		max-width: 46ch;
		font-family: var(--font-serif);
		font-size: 1.05rem;
		line-height: 1.7;
		color: var(--body);
	}
	.brief-list {
		display: grid;
		gap: 0.6rem;
		align-content: start;
		list-style: none;
		font-size: 0.95rem;
		line-height: 1.5;
		color: var(--body);
	}
	.brief-list li::before {
		content: '—';
		margin-right: 0.65rem;
		color: var(--accent);
	}
	@media (width >= 48rem) {
		.brief-grid {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		}
	}
	.section-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 2rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--line-strong);
	}
	.section-heading > p {
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.channel-list {
		margin-top: clamp(2.5rem, 5vw, 4rem);
		border-top: 1px solid var(--line-strong);
		list-style: none;
	}
	.channel-list li {
		min-width: 0;
		border-bottom: 1px solid var(--line);
	}
	.channel-list a {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		grid-template-rows: auto auto;
		column-gap: 1.5rem;
		row-gap: 0.35rem;
		padding: 1.5rem 0.25rem;
		transition: background-color 0.2s ease;
	}
	.channel-list a:hover,
	.channel-list a:focus-visible {
		background: color-mix(in srgb, var(--accent) 4%, transparent);
	}
	.channel-label {
		grid-column: 2;
		grid-row: 1;
		align-self: baseline;
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
		text-align: right;
	}
	.channel-list strong {
		grid-column: 1;
		grid-row: 1;
		min-width: 0;
		overflow-wrap: anywhere;
		font-family: var(--font-serif);
		font-size: clamp(1.4rem, 2.4vw, 1.9rem);
		font-weight: 500;
		letter-spacing: -0.01em;
		color: var(--text);
		transition: color 0.2s ease;
	}
	.channel-list a:hover strong,
	.channel-list a:focus-visible strong {
		color: var(--accent);
	}
	.channel-note {
		grid-column: 1;
		grid-row: 2;
		font-family: var(--font-serif);
		font-size: 0.98rem;
		line-height: 1.5;
		color: var(--muted);
	}
	.channel-arrow {
		grid-column: 2;
		grid-row: 2;
		align-self: end;
		justify-self: end;
		color: var(--accent-warm);
		transition: transform 0.2s ease;
	}
	.channel-list a:hover .channel-arrow,
	.channel-list a:focus-visible .channel-arrow {
		transform: translateX(3px);
	}
	@media (width < 48rem) {
		.section-heading {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.75rem;
		}
		.masthead-profile {
			grid-template-columns: 4.5rem 1fr;
		}
		.masthead-profile img {
			width: 4.5rem;
		}
	}
</style>

<script>
	import '../scripts/copy-address';
</script>

---
/**
 * Home: the front page of the broadsheet.
 *
 * A lead statement set across two columns, the numbers as a folio line, then
 * the work and the writing each led by one story and followed by an index. The
 * order of the middle two is still the difference between the variants —
 * seanbehan.ca leads with the numbers and reads as a profile, codebam.ca leads
 * with the work — but the numbers are now a rule rather than a band, so the
 * variant changes the sequence, not the grammar.
 */
import Base from '../layouts/Base.astro';
import Facts from '../components/home/Facts.astro';
import Work from '../components/home/Work.astro';
import Writing from '../components/home/Writing.astro';
import Availability from '../components/Availability.astro';
import { LinkButton } from '@cloudflare/kumo/components/button';
import { getPosts } from '../lib/posts';
import { withLiveStats } from '../lib/github';
import { featuredProjects } from '../lib/projects';
import { site, linkHref, writingHref, yearsBuilding as yearsSinceStart } from '../lib/site';

const [{ posts, cacheHint }, projects] = await Promise.all([
	getPosts({ includeBodies: false }),
	withLiveStats(featuredProjects)
]);
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const yearsBuilding = yearsSinceStart();
const intro = site.intro.replace('{years}', String(yearsBuilding));
const latest = posts.slice(0, 6);

/**
 * The lead's primary button comes from the variant's own table. Whichever
 * action is not the button stays in the quiet row below it, so "Read the
 * writing" is demoted on the hiring origin rather than lost — a reader who
 * came for the prose still finds it one click away, beside GitHub and email.
 */
const primary = site.primaryAction;
const primaryIsWriting = primary.via === 'writing' && primary.href === '/posts';
const quietLinks: { label: string; href: string; external: boolean }[] = [
	...(primaryIsWriting
		? []
		: [{ label: 'Read the writing', href: writingHref('/posts'), external: false }]),
	{ label: 'GitHub', href: 'https://github.com/codebam', external: true },
	{ label: site.email, href: `mailto:${site.email}`, external: false }
];
---

<Base broadsheet>
	<article class="front-page">
		<!-- The lead: the one oversized statement on the page, with the status
		     and the page's one imperative in the column beside it. The deck
		     below is set in two columns and opens on a drop cap — the printed
		     sheet's oldest way of saying "start here". -->
		<section class="lead shell">
			<div class="lead-top">
				<div class="lead-head">
					<h1 class="display lead-title">
						{site.headline.before}<em>{site.headline.emphasis}</em>{site.headline.after}
					</h1>
					<p class="lead-byline">
						<img
							src="/avatar.webp"
							alt=""
							width="40"
							height="40"
							fetchpriority="high"
							class="byline-avatar"
						/>
						<span>{site.byline} · {yearsBuilding} years building software</span>
					</p>
				</div>

				<aside class="lead-aside">
					<p class="aside-label">At a glance</p>
					<Availability availability={site.availability} />
					<div class="aside-actions">
						<LinkButton
							href={linkHref(primary)}
							variant="primary"
							size="lg"
							className="flat-control"
						>
							{primary.label}
						</LinkButton>
						{
							quietLinks.map((link) => (
								<a
									href={link.href}
									class="link-quiet"
									target={link.external ? '_blank' : undefined}
									rel={link.external ? 'noopener noreferrer' : undefined}
								>
									{link.label}
								</a>
							))
						}
					</div>
				</aside>
			</div>

			<p class="lead-deck">{intro}</p>
		</section>

		{
			site.leadWith === 'work' ? (
				<>
					<Work projects={projects} />
					<Facts postCount={posts.length} projects={projects} yearsBuilding={yearsBuilding} />
				</>
			) : (
				<>
					<Facts postCount={posts.length} projects={projects} yearsBuilding={yearsBuilding} />
					<Work projects={projects} />
				</>
			)
		}

		<Writing posts={latest} total={posts.length} />
	</article>
</Base>

<style>
	.front-page {
		padding-bottom: clamp(1rem, 3vw, 2rem);
	}

	.lead {
		padding-block: clamp(3rem, 7vw, 5.5rem) clamp(2.5rem, 5vw, 4rem);
	}
	.lead-top {
		display: grid;
		gap: clamp(2rem, 5vw, 3.5rem);
	}
	@media (width >= 60rem) {
		.lead-top {
			grid-template-columns: minmax(0, 2.15fr) minmax(15rem, 1fr);
			align-items: end;
		}
	}

	.lead-title {
		max-width: 20ch;
		font-size: clamp(2.9rem, 6.2vw, 5rem);
		line-height: 1.03;
		letter-spacing: -0.02em;
	}

	.lead-byline {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-top: clamp(1.75rem, 4vw, 2.5rem);
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.byline-avatar {
		width: 2.5rem;
		height: 2.5rem;
		flex-shrink: 0;
		border-radius: 50%;
		border: 1px solid var(--line-strong);
		object-fit: cover;
	}

	/* The status and the call to action, boxed by a warm rule: the page's own
	   voice marking what it wants the reader to do next. */
	.lead-aside {
		border-top: 2px solid var(--accent-warm);
		padding-top: 1.1rem;
	}
	.aside-label {
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.lead-aside :global(.availability) {
		margin-top: 0.75rem;
	}
	.aside-actions {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.9rem;
		margin-top: 1.5rem;
	}

	/* The deck: two columns of serif with the column rule the sheet would have
	   printed. No drop cap: the intro opens on a number, and a floated "1"
	   leaves the "2" of "12" behind on the baseline. */
	.lead-deck {
		margin-top: clamp(2rem, 4vw, 3rem);
		padding-top: clamp(1.5rem, 3vw, 2rem);
		border-top: 1px solid var(--line-strong);
		font-family: var(--font-serif);
		font-size: clamp(1.08rem, 1.4vw, 1.22rem);
		line-height: 1.72;
		color: var(--body);
		text-wrap: pretty;
	}
	@media (width >= 48rem) {
		.lead-deck {
			columns: 2;
			column-gap: clamp(2.5rem, 4vw, 3.5rem);
			column-rule: 1px solid var(--line);
		}
	}
</style>

---
/**
 * Home: hero, then the two variable sections, then the latest writing.
 *
 * The order of the middle two is the difference between the variants.
 * seanbehan.ca leads with the numbers band and reads as a profile; codebam.ca
 * leads with the project rows and reads as a body of work.
 */
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import Facts from '../components/home/Facts.astro';
import Work from '../components/home/Work.astro';
import { LinkButton } from '@cloudflare/kumo/components/button';
import { getPosts } from '../lib/posts';
import { withLiveStats } from '../lib/github';
import { featuredProjects } from '../lib/projects';
import { site, writingHref, yearsBuilding as yearsSinceStart } from '../lib/site';

const [{ posts, cacheHint }, projects] = await Promise.all([
	getPosts(),
	withLiveStats(featuredProjects)
]);
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const yearsBuilding = yearsSinceStart();
const intro = site.intro.replace('{years}', String(yearsBuilding));
const latest = posts.slice(0, 6);
---

<Base>
	<!-- One oversized statement gets the visual emphasis; supporting information
	     stays deliberately quiet so this reads as an introduction, not a dashboard. -->
	<section class="hero panel relative overflow-hidden">
		<div class="hero-shell shell relative">
			<!-- Byline: the photo identifies the author rather than decorating the
			     page, which leaves the headline the full column width. -->
			<div class="hero-kicker enter flex items-center gap-3.5">
				<!-- avatar.webp is the 2x crop of profile.webp at the size this
				     actually renders (1.4 kB against 13 kB). The full 460px
				     profile.webp is the contact photo and the Person image in JSON-LD. -->
				<img
					src="/avatar.webp"
					alt={site.name}
					width="56"
					height="56"
					fetchpriority="high"
					class="hero-avatar h-14 w-14 shrink-0 rounded-full object-cover"
				/>
				<div>
					<p class="eyebrow">{site.eyebrow}</p>
					<p class="mt-0.5 text-[0.95rem] text-[var(--muted)]">{site.byline}</p>
				</div>
			</div>

			<h1 class="hero-title display display-xl">
				{site.headline.before}<em>{site.headline.emphasis}</em>{site.headline.after}
			</h1>

			<p class="hero-intro enter" style="--enter-delay:80ms">
				{intro}
			</p>

			<div class="hero-actions enter" style="--enter-delay:140ms">
				<LinkButton
					href={writingHref('/posts')}
					variant="primary"
					size="lg"
					className="blueprint-control"
				>
					Read the writing
				</LinkButton>
				<a
					href="https://github.com/codebam"
					target="_blank"
					rel="noopener noreferrer"
					class="link-quiet">GitHub</a
				>
				<a href={`mailto:${site.email}`} class="link-quiet">{site.email}</a>
			</div>
		</div>
	</section>

	{
		site.leadWith === 'work' ? (
			<>
				<Work projects={projects} />
				<Facts postCount={posts.length} projects={projects} yearsBuilding={yearsBuilding} />
			</>
		) : (
			<>
				<Facts postCount={posts.length} projects={projects} yearsBuilding={yearsBuilding} />
				<Work projects={projects} />
			</>
		)
	}

	<!-- LATEST WRITING — back to the page surface -->
	<section class="latest-writing panel">
		<div class="shell">
			<div class="flex items-baseline justify-between gap-4" data-reveal>
				<h2 class="display display-lg"><span class="section-number">02 /</span> Latest writing</h2>
				<a href={writingHref('/posts')} class="link-accent whitespace-nowrap"
					>All {posts.length} posts <span class="arrow">&rarr;</span></a
				>
			</div>

			<div class="mt-10" data-reveal data-reveal-delay="60">
				<PostList posts={latest} columns={2} raised />
			</div>
		</div>
	</section>
</Base>

<style>
	.latest-writing {
		padding-block: clamp(7rem, 13vw, 12rem);
	}
	.latest-writing > .shell {
		max-width: 1240px;
	}
	.section-number {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		color: var(--accent-warm);
		vertical-align: middle;
	}
	.hero {
		min-height: min(860px, calc(100svh - 77px));
		display: grid;
		align-items: center;
		padding-block: clamp(6rem, 13vh, 10rem);
	}
	.hero::after {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background-image:
			linear-gradient(color-mix(in srgb, var(--accent) 11%, transparent) 1px, transparent 1px),
			linear-gradient(
				90deg,
				color-mix(in srgb, var(--accent) 11%, transparent) 1px,
				transparent 1px
			);
		background-size: 32px 32px;
		mask-image: radial-gradient(circle at 50% 48%, #000 0%, transparent 72%);
		z-index: 0;
	}
	.hero-shell {
		width: 100%;
		max-width: 1240px;
		text-align: center;
		z-index: 1;
	}
	.hero-kicker,
	.hero-actions {
		justify-content: center;
	}
	.hero-title {
		max-width: 19ch;
		margin: clamp(3.5rem, 8vh, 6rem) auto 0;
		font-size: clamp(3.2rem, 6.8vw, 6.5rem);
	}
	.hero-intro {
		max-width: 54ch;
		margin: 2.25rem auto 0;
		font-size: clamp(1.05rem, 1.7vw, 1.3rem);
		line-height: 1.6;
		color: var(--body);
	}
	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 2rem;
		margin-top: 2.5rem;
	}
	@media (width < 40rem) {
		.hero {
			min-height: auto;
			padding-block: 4rem 5.5rem;
		}
		.hero-shell {
			text-align: left;
		}
		.hero-kicker,
		.hero-actions {
			justify-content: flex-start;
		}
		.hero-title {
			margin-top: 3.5rem;
			font-size: clamp(2.75rem, 13vw, 4rem);
		}
		.hero-intro {
			margin-inline: 0;
		}
	}
</style>

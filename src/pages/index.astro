---
/**
 * Home: a clear front door.
 *
 * A two-column hero states who this is, what they build and how to reach them,
 * with the availability and one primary action beside it. Below it the numbers
 * and the project rows follow — or the work before the numbers on the variant
 * that leads with the code — with the condensed work history in between on the
 * hiring variant, because it is the question a résumé answers and the one an
 * employer asks before the projects mean anything.
 */
import Base from '../layouts/Base.astro';
import Facts from '../components/home/Facts.astro';
import Work from '../components/home/Work.astro';
import Experience from '../components/home/Experience.astro';
import Writing from '../components/home/Writing.astro';
import Newsletter from '../components/Newsletter.astro';
import Availability from '../components/Availability.astro';
import { LinkButton } from '@cloudflare/kumo/components/button';
import { getPosts } from '../lib/posts';
import { withLiveStats } from '../lib/github';
import { featuredProjects } from '../lib/projects';
import { site, linkHref, writingHref } from '../lib/site';
import { PRODUCT } from '../lib/product';
import SiblingMark from '../components/SiblingMark.astro';

const [{ posts, cacheHint }, projects] = await Promise.all([
	getPosts({ includeBodies: false }),
	withLiveStats(featuredProjects)
]);
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

/** The résumé's first dated professional role is May 2018; see H3. */
const PROFESSIONAL_START = Date.UTC(2018, 4, 1);
const MS_PER_YEAR = 365.2425 * 24 * 60 * 60 * 1000;
const yearsBuilding = Math.floor((Date.now() - PROFESSIONAL_START) / MS_PER_YEAR);

const intro = site.intro;

/**
 * B10: the archive keeps newest-first order; the home page leads with the
 * newest posts that are actually worth the click. A note that reads in one
 * minute is not what a senior engineer should meet first, so the six cards
 * prefer posts of two minutes or more. When fewer than six qualify — a young
 * archive, or a run of notes — the newest-first list is the fallback rather
 * than a short section.
 */
const MIN_READING_MINUTES = 2;
const HOME_POSTS = 6;
const substantive = posts.filter((post) => (post.readingMinutes ?? 1) >= MIN_READING_MINUTES);
const latest = (substantive.length >= HOME_POSTS ? substantive : posts).slice(0, HOME_POSTS);

/** B1: the commercial blocks belong to the legal-name front door. */
const commercial = site.id === 'seanbehan';
const productHref = `/products/${PRODUCT.id}`;

/**
 * The lead's primary button comes from the variant's own table. Whichever
 * action is not the button stays in the quiet row below it, so "Read the
 * writing" is demoted on the hiring origin rather than lost.
 */
const primary = site.primaryAction;
const primaryIsWriting = primary.via === 'writing' && primary.href === '/posts';
const quietLinks: { label: string; href: string; newTab: boolean }[] = [
	...(primaryIsWriting
		? []
		: [{ label: 'Read the writing', href: writingHref('/posts'), newTab: false }]),
	{ label: 'GitHub', href: 'https://github.com/codebam', newTab: true },
	{ label: site.email, href: `mailto:${site.email}`, newTab: false }
];
---

<Base>
	<article class="front-page">
		<section class="hero">
			<div class="shell hero-inner">
				<div class="hero-main">
					<div class="hero-meta">
						<p class="eyebrow hero-eyebrow">{site.eyebrow}</p>
						<p class="hero-byline">{site.byline}</p>
					</div>
					<h1 class="display display-xl hero-title">
						{site.headline.before}
						<em>{site.headline.emphasis}</em>
						{site.headline.after}
					</h1>
					<p class="hero-lead">{intro}</p>

					<div class="hero-actions">
						<LinkButton
							href={linkHref(primary)}
							variant="primary"
							size="lg"
							className="flat-control site-cta"
						>
							{primary.label}
						</LinkButton>
						{quietLinks.map((link) => (
							<a
								href={link.href}
								class="link-quiet"
								target={link.newTab ? '_blank' : undefined}
								rel={link.newTab ? 'noopener noreferrer' : undefined}
							>
								{link.label}
								{link.href.startsWith('http') && (
									<SiblingMark href={link.href} newTab={link.newTab} />
								)}
							</a>
						))}
					</div>

					{/* The status is a ruled line in the text column rather than a
					    box in the aside: it belongs above the portrait on every
					    screen, and DESIGN.md §3.4's measured fold only holds if
					    nothing tall sits between it and the top of the page. The
					    wrapper goes with the mark — the code-first variant has no
					    status to declare, so it renders no gap either. */}
					{site.availability && (
						<div class="hero-status">
							<Availability availability={site.availability} />
						</div>
					)}
				</div>

				<aside class="hero-aside">
					<img
						class="hero-photo"
						src="/profile.webp"
						alt={`Portrait of ${site.name}`}
						width="460"
						height="460"
						fetchpriority="high"
					/>
				</aside>
			</div>
		</section>

		{commercial && (
			<section class="section shell offers" aria-labelledby="offers-heading">
				<div class="section-head" data-reveal>
					<div>
						<h2 class="display display-lg" id="offers-heading">
							Work with me
						</h2>
						<p class="section-sub">Custom work, or the kit to build it yourself.</p>
					</div>
				</div>
				<div class="offer-grid">
					<article class="card offer-card" data-reveal>
						<p class="eyebrow">Services</p>
						<h3 class="offer-title">Websites and Telegram bots.</h3>
						<p class="offer-copy">
							Scoped per project and quoted by email; you work directly with the developer doing the
							work.
						</p>
						<a class="link-accent" href="/services">
							See services{' '}
							<span class="arrow" aria-hidden="true">
								&rarr;
							</span>
						</a>
					</article>
					<article class="card offer-card" data-reveal data-reveal-delay="60">
						<p class="eyebrow">Digital product</p>
						<h3 class="offer-title">
							<a href={productHref}>{PRODUCT.name}</a>
						</h3>
						<p class="offer-copy">
							A deployment-ready Astro and Cloudflare Workers starter with D1, R2, auth and
							operations guidance.{' '}
							<strong>
								${PRODUCT.price} {PRODUCT.currency}
							</strong>{' '}
							one-time.
						</p>
						<a class="link-accent" href={productHref}>
							See what&rsquo;s inside{' '}
							<span class="arrow" aria-hidden="true">
								&rarr;
							</span>
						</a>
					</article>
				</div>
			</section>
		)}

		{/* The numbers and the project rows keep the variant's order; the work
		    history sits between them on the hiring variant. The résumé is still
		    the full telling — these rows are what a reader gets before deciding to
		    open it. */}
		{site.leadWith === 'work' ? (
			<Work projects={projects} />
		) : (
			<Facts postCount={posts.length} projects={projects} yearsBuilding={yearsBuilding} />
		)}

		{site.experience && <Experience experience={site.experience} />}

		{site.leadWith === 'work' ? (
			<Facts postCount={posts.length} projects={projects} yearsBuilding={yearsBuilding} />
		) : (
			<Work projects={projects} />
		)}

		<Writing posts={latest} total={posts.length} />

		{/* The home page's one ask, after the writing has shown what arriving in
		    the inbox would look like. The footer form is for every other page. */}
		<Newsletter />
	</article>
</Base>

<style>
	.front-page {
		padding-bottom: clamp(1rem, 3vw, 2rem);
	}

	.hero {
		padding-block: var(--pad-hero);
	}
	/* Nine columns of statement, three of portrait: the grid is never drawn,
	   the asymmetry is what says it is there. */
	.hero-inner {
		display: grid;
		gap: clamp(2rem, 5vw, 3rem);
	}
	@media (width >= 60rem) {
		.hero-inner {
			grid-template-columns: minmax(0, 3fr) minmax(0, 1fr);
			column-gap: 1.5rem;
			align-items: start;
		}
	}

	/* Kind on the left, place on the right, one ink rule under both. */
	.hero-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.35rem 1.5rem;
		padding-bottom: 0.65rem;
		border-bottom: 1px solid var(--line-strong);
	}
	.hero-eyebrow {
		color: var(--muted);
	}
	.hero-title {
		max-width: 20ch;
		margin-top: clamp(1.75rem, 4vw, 2.75rem);
	}
	.hero-lead {
		max-width: 34.25rem;
		margin-top: clamp(1.25rem, 3vw, 1.75rem);
		font-size: 1.0625rem;
		line-height: 1.6;
		color: var(--body);
	}
	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 1.5rem;
		margin-top: clamp(1.75rem, 4vw, 2.5rem);
	}
	.hero-status {
		max-width: 34.25rem;
		margin-top: clamp(1.75rem, 4vw, 2.5rem);
	}

	.hero-aside {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	/* The portrait is an ink block on the paper: no frame, no radius, no
	   shadow — the one image the page spends. */
	.hero-photo {
		display: block;
		width: 100%;
		aspect-ratio: 1;
		object-fit: cover;
	}
	@media (width < 60rem) {
		.hero-photo {
			max-width: 11rem;
		}
	}

	.offers {
		scroll-margin-top: 5rem;
	}
	.offer-grid {
		display: grid;
		gap: 0 2.5rem;
		margin-top: 0;
	}
	.offer-card {
		padding-block: 1.5rem;
	}
	.offer-title {
		margin-top: 0.55rem;
		font-size: 1.375rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.2;
		text-wrap: balance;
	}
	.offer-title a {
		color: var(--text);
		text-decoration: none;
	}
	.offer-title a:hover,
	.offer-title a:focus-visible {
		color: var(--accent-hover);
	}
	.offer-copy {
		max-width: 34.25rem;
		margin-top: 0.6rem;
		font-size: 0.9375rem;
		line-height: 1.6;
		color: var(--body);
	}
	.offer-card .link-accent {
		display: inline-block;
		margin-top: 1rem;
	}
	@media (width >= 48rem) {
		.offer-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	/* Short phones (375x667 class): the first screen has to carry the location
	   and the full availability line, so the hero spends its space on the words
	   and not on the padding around them. */
	@media (width < 32rem) {
		.hero {
			padding-block: 0.75rem;
		}
		.hero-inner {
			gap: 0.6rem;
		}
		.hero-title {
			margin-top: 0.35rem;
		}
		.hero-lead {
			margin-top: 0.5rem;
			font-size: 1rem;
			line-height: 1.55;
		}
		.hero-actions {
			margin-top: 0.75rem;
			gap: 0.55rem 1.1rem;
		}
		.hero-status {
			margin-top: 0.75rem;
		}
		.hero-aside {
			gap: 0.75rem;
		}
		.hero-photo {
			max-width: 9rem;
		}
	}

	.hero-byline {
		font-size: 0.8125rem;
		color: var(--muted);
	}
</style>

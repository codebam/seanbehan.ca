---
/**
 * Home: a clear front door.
 *
 * A two-column hero states who this is, what they build and how to reach them,
 * with a current-focus command block and availability beside it. Below it the
 * numbers and the project directory follow — or the work before the numbers on the variant
 * that leads with the code — with the condensed work history in between on the
 * hiring variant, because it is the question a résumé answers and the one an
 * employer asks before the projects mean anything.
 */
import Base from '../layouts/Base.astro';
import Facts from '../components/home/Facts.astro';
import Work from '../components/home/Work.astro';
import Experience from '../components/home/Experience.astro';
import Writing from '../components/home/Writing.astro';
import Newsletter from '../components/Newsletter.astro';
import Availability from '../components/Availability.astro';
import { LinkButton } from '@cloudflare/kumo/components/button';
import { getPosts } from '../lib/posts';
import { withLiveStats } from '../lib/github';
import { featuredProjects } from '../lib/projects';
import { site, linkHref, writingHref, yearsBuilding } from '../lib/site';
import { PRODUCT } from '../lib/product';
import SiblingMark from '../components/SiblingMark.astro';

const [{ posts, cacheHint }, projects] = await Promise.all([
	getPosts({ includeBodies: false }),
	withLiveStats(featuredProjects)
]);
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const intro = site.intro;

/**
 * The home page leads with the newest posts outright — a "Latest writing"
 * section must not show older cards while newer posts exist, however short.
 * Reading length never gates the six cards.
 */
const HOME_POSTS = 6;
const latest = posts.slice(0, HOME_POSTS);

/** B1: the commercial blocks belong to the legal-name front door. */
const commercial = site.id === 'seanbehan';
const productHref = `/products/${PRODUCT.id}`;

/**
 * The lead's primary button comes from the variant's own table. Whichever
 * action is not the button stays in the quiet row below it, so "Read the
 * writing" is demoted on the hiring origin rather than lost.
 */
const primary = site.primaryAction;
const primaryIsWriting = primary.via === 'writing' && primary.href === '/posts';
const quietLinks: { label: string; href: string; newTab: boolean }[] = [
	...(primaryIsWriting
		? []
		: [{ label: site.writingLinkLabel, href: writingHref('/posts'), newTab: false }]),
	{ label: 'GitHub', href: 'https://github.com/codebam', newTab: true },
	{ label: site.email, href: `mailto:${site.email}`, newTab: false }
];
---

<Base>
	<article class="front-page">
		<section class="hero">
			<div class="shell hero-inner">
				<div>
					<p class="eyebrow hero-eyebrow">
						<span class="terminal-prompt" aria-hidden="true">
							$
						</span>{' '}
						{site.eyebrow}
					</p>
					<p class="hero-byline">{site.byline}</p>
					<h1 class="display display-xl hero-title">
						{site.headline.before}
						<em>{site.headline.emphasis}</em>
						{site.headline.after}
					</h1>
					<p class="hero-lead">{intro}</p>

					<div class="hero-actions">
						<LinkButton
							href={linkHref(primary)}
							variant="primary"
							size="lg"
							className="flat-control site-cta"
						>
							{primary.label}
						</LinkButton>
						<SiblingMark href={linkHref(primary)} />
						{quietLinks.map((link) => (
							<a
								href={link.href}
								class="link-quiet"
								target={link.newTab ? '_blank' : undefined}
								rel={link.newTab ? 'noopener noreferrer' : undefined}
							>
								{link.label}
								{link.href.startsWith('http') && (
									<SiblingMark href={link.href} newTab={link.newTab} />
								)}
							</a>
						))}
					</div>
				</div>

				<aside class="hero-aside">
					<pre
						class="hero-code"
						aria-label="Current focus"
					><code><span class="code-comment"># current focus</span>
<span class="code-accent">systems</span> = rust + typescript
<span class="code-accent">platform</span> = nixos + cloudflare
<span class="code-accent">method</span> = small, explicit, reproducible

<span class="code-comment"># always</span>
ship_in_the_open = true</code></pre>
					<Availability availability={site.availability} />
				</aside>
			</div>
		</section>

		{/* Quiet Mode reads like a directory: proof, work, then writing. The
		    commercial and career detail follows once the work has made the case. */}
		{site.leadWith === 'work' ? (
			<Work projects={projects} />
		) : (
			<Facts postCount={posts.length} projects={projects} yearsBuilding={yearsBuilding()} />
		)}

		{site.leadWith === 'work' ? (
			<Facts postCount={posts.length} projects={projects} yearsBuilding={yearsBuilding()} />
		) : (
			<Work projects={projects} />
		)}

		<Writing posts={latest} total={posts.length} />

		{commercial && (
			<section class="section shell offers" aria-labelledby="offers-heading">
				<div class="section-head" data-reveal>
					<div>
						<h2 class="display display-lg" id="offers-heading">
							Work with me
						</h2>
						<p class="section-sub">Custom work, or the kit to build it yourself.</p>
					</div>
				</div>
				<div class="offer-grid">
					<article class="card offer-card" data-reveal>
						<p class="eyebrow">Services</p>
						<h3 class="offer-title">Websites and Telegram bots.</h3>
						<p class="offer-copy">
							Scoped per project and quoted by email; you work directly with the developer doing the
							work.
						</p>
						<a class="link-accent" href="/services">
							See services{' '}
							<span class="arrow" aria-hidden="true">
								&rarr;
							</span>
						</a>
					</article>
					<article class="card offer-card" data-reveal data-reveal-delay="60">
						<p class="eyebrow">Digital product</p>
						<h3 class="offer-title">
							<a href={productHref}>{PRODUCT.name}</a>
						</h3>
						<p class="offer-copy">
							A deployment-ready Astro and Cloudflare Workers starter with D1, R2, auth and
							operations guidance.{' '}
							<strong>
								${PRODUCT.price} {PRODUCT.currency}
							</strong>{' '}
							one-time.
						</p>
						<a class="link-accent" href={productHref}>
							See what&rsquo;s inside{' '}
							<span class="arrow" aria-hidden="true">
								&rarr;
							</span>
						</a>
					</article>
				</div>
			</section>
		)}

		{site.experience && <Experience experience={site.experience} />}

		{/* The home page's one ask, after the writing has shown what arriving in
		    the inbox would look like. The footer form is for every other page. */}
		<Newsletter />
	</article>
</Base>

<style>
	.front-page {
		padding-bottom: clamp(1rem, 3vw, 2rem);
	}

	.hero {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		padding-block: clamp(3.5rem, 8vw, 6.5rem);
	}
	.hero::before {
		position: absolute;
		inset: 0;
		z-index: -1;
		background-image:
			repeating-linear-gradient(90deg, transparent 0 5rem, var(--line) 5.05rem 5.1rem),
			radial-gradient(var(--line-strong) 1px, transparent 1px);
		background-size:
			5rem 5rem,
			18px 18px;
		mask-image: linear-gradient(180deg, #000 0%, transparent 92%);
		content: '';
		pointer-events: none;
	}
	.hero-inner {
		display: grid;
		gap: clamp(2rem, 5vw, 4rem);
	}
	@media (width >= 60rem) {
		.hero-inner {
			grid-template-columns: minmax(0, 1.35fr) minmax(20rem, 0.75fr);
			align-items: center;
		}
	}

	.hero-eyebrow {
		color: var(--accent);
	}
	.hero-title {
		max-width: 15ch;
		margin-top: 1rem;
		font-size: clamp(2.9rem, 5.7vw, 5.8rem);
		line-height: 0.96;
	}
	.terminal-prompt {
		margin-right: 0.45rem;
		color: var(--accent);
	}
	.hero-lead {
		max-width: 60ch;
		margin-top: clamp(1.25rem, 3vw, 1.75rem);
		font-size: clamp(1.05rem, 1.5vw, 1.2rem);
		line-height: 1.7;
		color: var(--body);
	}
	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 1.5rem;
		margin-top: clamp(1.75rem, 4vw, 2.5rem);
	}

	.hero-aside {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.hero-code {
		margin: 0;
		padding: 1.25rem;
		overflow: auto;
		border: 1px solid var(--line-strong);
		border-radius: var(--radius);
		background: var(--surface-alt);
		color: var(--text);
		font-family: var(--font-mono);
		font-size: 0.78rem;
		line-height: 1.8;
	}
	.code-comment {
		color: var(--muted);
	}
	.code-accent {
		color: var(--accent);
	}
	/* On a phone the aside stacks under the hero text, and the portrait alone
	   is tall enough to push the availability mark past the fold — measured on
	   the live page at 390x844, the mark began at y=852, eight pixels below the
	   bottom of the screen. Reversed, the status is on the first screen and the
	   portrait follows it; on wider screens the aside is a column again and the
	   portrait leads, as designed. */
	@media (width < 60rem) {
		.hero-aside {
			width: 100%;
			max-width: 34rem;
		}
	}

	.offers {
		scroll-margin-top: 5rem;
	}
	.offer-grid {
		display: grid;
		gap: 1.25rem;
		margin-top: 1.5rem;
	}
	.offer-card {
		padding: 1.75rem;
	}
	.offer-title {
		margin-top: 0.55rem;
		font-size: 1.35rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.25;
	}
	.offer-title a {
		color: var(--text);
		text-decoration: none;
	}
	.offer-title a:hover,
	.offer-title a:focus-visible {
		color: var(--accent);
	}
	.offer-copy {
		margin-top: 0.6rem;
		font-size: 0.95rem;
		line-height: 1.65;
		color: var(--body);
	}
	.offer-card .link-accent {
		display: inline-block;
		margin-top: 1rem;
	}
	@media (width >= 48rem) {
		.offer-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	/* Short phones (375x667 class): the first screen has to carry the location
	   and the full availability line, so the hero spends its space on the words
	   and not on the padding around them. */
	@media (width < 32rem) {
		.hero {
			padding-block: 0.75rem;
		}
		.hero-inner {
			gap: 0.6rem;
		}
		.hero-title {
			margin-top: 0.35rem;
		}
		.hero-lead {
			margin-top: 0.5rem;
			font-size: 1rem;
			line-height: 1.55;
		}
		.hero-actions {
			margin-top: 0.75rem;
			gap: 0.55rem 1.1rem;
		}
		.hero-aside {
			gap: 0.75rem;
		}
		.hero-code {
			padding: 1rem;
			font-size: 0.72rem;
		}
	}

	.hero-byline {
		margin-top: 0.3rem;
		font-size: 0.875rem;
		color: var(--muted);
	}
</style>

---
/**
 * Home: a clear front door.
 *
 * A two-column hero states who this is, what they build and how to reach them,
 * with the availability and one primary action beside it. The numbers, the work
 * and the writing follow in that order — or work before numbers on the variant
 * that leads with the code.
 */
import Base from '../layouts/Base.astro';
import Facts from '../components/home/Facts.astro';
import Work from '../components/home/Work.astro';
import Writing from '../components/home/Writing.astro';
import Availability from '../components/Availability.astro';
import { LinkButton } from '@cloudflare/kumo/components/button';
import { getPosts } from '../lib/posts';
import { withLiveStats } from '../lib/github';
import { featuredProjects } from '../lib/projects';
import { site, linkHref, writingHref, yearsBuilding as yearsSinceStart } from '../lib/site';

const [{ posts, cacheHint }, projects] = await Promise.all([
	getPosts({ includeBodies: false }),
	withLiveStats(featuredProjects)
]);
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const yearsBuilding = yearsSinceStart();
const intro = site.intro.replace('{years}', String(yearsBuilding));
const latest = posts.slice(0, 6);

/**
 * The lead's primary button comes from the variant's own table. Whichever
 * action is not the button stays in the quiet row below it, so "Read the
 * writing" is demoted on the hiring origin rather than lost.
 */
const primary = site.primaryAction;
const primaryIsWriting = primary.via === 'writing' && primary.href === '/posts';
const quietLinks: { label: string; href: string; external: boolean }[] = [
	...(primaryIsWriting
		? []
		: [{ label: 'Read the writing', href: writingHref('/posts'), external: false }]),
	{ label: 'GitHub', href: 'https://github.com/codebam', external: true },
	{ label: site.email, href: `mailto:${site.email}`, external: false }
];
---

<Base>
	<article class="front-page">
		<section class="hero">
			<div class="shell hero-inner">
				<div class="hero-copy">
					<p class="eyebrow hero-eyebrow">{site.eyebrow}</p>
					<h1 class="display display-xl hero-title">
						{site.headline.before}
						<em>{site.headline.emphasis}</em>
						{site.headline.after}
					</h1>
					<p class="hero-lead">{intro}</p>

					<div class="hero-actions">
						<LinkButton
							href={linkHref(primary)}
							variant="primary"
							size="lg"
							className="flat-control"
						>
							{primary.label}
						</LinkButton>
						{quietLinks.map((link) => (
							<a
								href={link.href}
								class="link-quiet"
								target={link.external ? '_blank' : undefined}
								rel={link.external ? 'noopener noreferrer' : undefined}
							>
								{link.label}
							</a>
						))}
					</div>
				</div>

				<aside class="hero-aside">
					<img
						class="hero-photo"
						src="/profile.webp"
						alt={`Portrait of ${site.name}`}
						width="460"
						height="460"
						fetchpriority="high"
					/>
					<Availability availability={site.availability} />
				</aside>
			</div>
		</section>

		{site.leadWith === 'work' ? (
			<>
				<Work projects={projects} />
				<Facts postCount={posts.length} projects={projects} yearsBuilding={yearsBuilding} />
			</>
		) : (
			<>
				<Facts postCount={posts.length} projects={projects} yearsBuilding={yearsBuilding} />
				<Work projects={projects} />
			</>
		)}

		<Writing posts={latest} total={posts.length} />
	</article>
</Base>

<style>
	.front-page {
		padding-bottom: clamp(1rem, 3vw, 2rem);
	}

	.hero {
		padding-block: clamp(3rem, 7vw, 5.5rem);
	}
	.hero-inner {
		display: grid;
		gap: clamp(2rem, 5vw, 4rem);
	}
	@media (width >= 60rem) {
		.hero-inner {
			grid-template-columns: minmax(0, 1.5fr) minmax(17rem, 1fr);
			align-items: start;
		}
	}

	.hero-eyebrow {
		color: var(--accent);
	}
	.hero-title {
		max-width: 22ch;
		margin-top: 1rem;
	}
	.hero-lead {
		max-width: 60ch;
		margin-top: clamp(1.25rem, 3vw, 1.75rem);
		font-size: clamp(1.05rem, 1.5vw, 1.2rem);
		line-height: 1.7;
		color: var(--body);
	}
	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 1.5rem;
		margin-top: clamp(1.75rem, 4vw, 2.5rem);
	}

	.hero-aside {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.hero-photo {
		width: 100%;
		max-width: 20rem;
		aspect-ratio: 1;
		object-fit: cover;
		border-radius: var(--radius-lg);
		border: 1px solid var(--line);
		box-shadow: var(--shadow-md);
	}
	@media (width < 60rem) {
		.hero-photo {
			max-width: 14rem;
		}
	}
</style>

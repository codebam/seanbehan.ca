---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { featuredProjects } from '../../lib/projects';
import { SITES } from '../../lib/site.data.js';

// The case study moved from the old product name to its descriptive title.
// Keep the old URL working rather than turning an indexed link into a 404.
if (Astro.params.slug === 'codebam-stream') return Astro.redirect('/projects/stream', 301);

const project = featuredProjects.find((candidate) => candidate.slug === Astro.params.slug);
if (!project) return Astro.rewrite('/404');

const canonical = `${SITES.codebam.url}/projects/${project.slug}`;
const source = project.repo ? `https://github.com/codebam/${project.repo}` : null;
const schema = JSON.stringify({
	'@context': 'https://schema.org',
	// Everything featured here is open source except the one row that runs a
	// paid service. Announcing a repository it does not have is the sort of
	// thing a crawler checks.
	'@type': source ? 'SoftwareSourceCode' : 'SoftwareApplication',
	'@id': `${canonical}#software`,
	name: project.title,
	description: project.description,
	url: canonical,
	...(source ? { codeRepository: source } : {}),
	programmingLanguage: project.language,
	dateCreated: project.since,
	author: { '@id': 'https://seanbehan.ca/#person' },
	keywords: project.tags.join(', ')
}).replace(/</g, '\\u003c');
---

<Base
	title={project.title}
	description={project.seoDescription}
	ogTitle={`${project.title} — codebam`}
	canonical={canonical}
	image={`/og/${project.slug}.png`}
>
	<script slot="head" type="application/ld+json" is:inline set:html={schema}></script>
	<article class="panel pt-14 pb-20 md:pt-16 md:pb-24">
		<div class="shell case-shell">
			<p class="enter eyebrow">
				{project.language} · {project.since}
			</p>
			<h1 class="display display-xl mt-5">{project.title}</h1>
			<p class="enter mt-7 max-w-[58ch] text-[1.15rem] leading-[1.7] text-[var(--body)]">
				{project.description}
			</p>

			<p class="enter mt-8 flex flex-wrap items-center gap-6" style="--enter-delay:100ms">
				{
					// The source is the point of a case study, so it keeps the primary
					// button; where there is none, the running service is.
					source ? (
						<a class="btn" href={source}>
							View source
						</a>
					) : (
						project.homepage && (
							<a class="btn" href={project.homepage}>
								{project.homepageLabel}
							</a>
						)
					)
				}
				{source && project.homepage && (
					<a class="link-quiet" href={project.homepage}>
						{project.homepageLabel}
					</a>
				)}
			</p>

			<figure class="project-mockup enter" style="--enter-delay:140ms">
				<Image
					src={project.mockup}
					alt={project.mockupAlt}
					widths={[480, 720, 960, 1200]}
					sizes="(min-width: 960px) 900px, calc(100vw - 2.5rem)"
					loading="lazy"
					decoding="async"
				/>
			</figure>

			<div class="prose enter mt-14 max-w-[68ch] text-[1.08rem]" style="--enter-delay:180ms">
				<h2>The problem</h2>
				<p>{project.challenge}</p>

				<h2>Architecture</h2>
				<ul>
					{project.architecture.map((item) => (
						<li>{item}</li>
					))}
				</ul>

				<h2>Highlights</h2>
				<ul>
					{project.highlights.map((item) => (
						<li>{item}</li>
					))}
				</ul>

				<h2>Technology</h2>
				<p>{[project.language, ...project.tags].join(' · ')}</p>
			</div>

			<p class="mt-14 border-t border-[var(--line-strong)] pt-7">
				<a class="link-accent" href="/projects">
					<span class="arrow">&larr;</span> All selected work
				</a>
			</p>

			<section class="case-cta" aria-labelledby="case-cta-heading">
				<p class="eyebrow">Need something like this?</p>
				<h2 class="display display-lg" id="case-cta-heading">
					Let&rsquo;s scope it.
				</h2>
				<p class="case-cta-copy">
					Custom websites and Telegram bots, scoped per project and quoted by email.
				</p>
				<p class="case-cta-actions">
					<a class="btn" href="/services">
						See services
					</a>
					<a class="link-quiet" href="/contact">
						Get in touch
					</a>
				</p>
			</section>
		</div>
	</article>
</Base>

<style>
	.case-shell {
		max-width: 900px;
	}
	.project-mockup {
		margin-top: clamp(2.5rem, 6vw, 4rem);
		overflow: hidden;
		border-radius: var(--radius);
		background: var(--surface-alt);
	}
	.project-mockup img {
		display: block;
		width: 100%;
		height: auto;
	}
	/* The closing ask is a ruled block on the page's own ground, not a card:
	   nothing on this site is a card any more. */
	.case-cta {
		margin-top: clamp(3rem, 7vw, 4.5rem);
		padding-top: clamp(1.5rem, 3vw, 2rem);
		border-top: 1px solid var(--line);
	}
	.case-cta h2 {
		margin-top: 0.6rem;
	}
	.case-cta-copy {
		max-width: 52ch;
		margin-top: 0.85rem;
		font-size: 1.0625rem;
		line-height: 1.65;
		color: var(--body);
	}
	.case-cta-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 1.5rem;
		margin-top: 1.5rem;
	}
</style>

---
import Base from '../../layouts/Base.astro';
import { featuredProjects } from '../../lib/projects';
import { SITES } from '../../lib/site.data.js';

const project = featuredProjects.find((candidate) => candidate.slug === Astro.params.slug);
if (!project) return Astro.rewrite('/404');

const canonical = `${SITES.codebam.url}/projects/${project.slug}`;
const source = `https://github.com/codebam/${project.repo}`;
const schema = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'SoftwareSourceCode',
	'@id': `${canonical}#software`,
	name: project.title,
	description: project.description,
	url: canonical,
	codeRepository: source,
	programmingLanguage: project.language,
	dateCreated: project.since,
	author: { '@id': 'https://seanbehan.ca/#person' },
	keywords: project.tags.join(', ')
}).replace(/</g, '\\u003c');
---

<Base
	title={project.title}
	description={project.description}
	ogTitle={`${project.title} — codebam`}
	canonical={canonical}
>
	<script slot="head" type="application/ld+json" is:inline set:html={schema} />

	<article class="panel pt-14 pb-20 md:pt-16 md:pb-24">
		<div class="shell case-shell">
			<p class="enter eyebrow">{project.language} · {project.since}</p>
			<h1 class="display mt-5 text-[clamp(2.6rem,5.6vw,4.4rem)] leading-[1.05]">{project.title}</h1>
			<p
				class="enter mt-7 max-w-[58ch] font-serif text-[1.2rem] leading-[1.65] text-[var(--body)] md:text-[1.3rem]"
			>
				{project.description}
			</p>

			<p class="enter mt-8 flex flex-wrap items-center gap-6" style="--enter-delay:100ms">
				<a class="btn" href={source}>View source</a>
				{
					project.homepage && (
						<a class="link-quiet" href={project.homepage}>
							{project.homepageLabel}
						</a>
					)
				}
			</p>

			<figure class="project-mockup enter" style="--enter-delay:140ms">
				<img
					src={project.mockup}
					alt={project.mockupAlt}
					width="1600"
					height="1000"
					decoding="async"
				/>
			</figure>

			<div class="prose enter mt-14 max-w-[68ch] text-[1.08rem]" style="--enter-delay:180ms">
				<h2>The problem</h2>
				<p>{project.challenge}</p>

				<h2>Architecture</h2>
				<ul>
					{project.architecture.map((item) => <li>{item}</li>)}
				</ul>

				<h2>Highlights</h2>
				<ul>
					{project.highlights.map((item) => <li>{item}</li>)}
				</ul>

				<h2>Technology</h2>
				<p>{[project.language, ...project.tags].join(' · ')}</p>
			</div>

			<p class="mt-14 border-t border-[var(--line-strong)] pt-7">
				<a class="link-accent" href="/projects"
					><span class="arrow">&larr;</span> All selected work</a
				>
			</p>
		</div>
	</article>
</Base>

<style>
	.case-shell {
		max-width: 900px;
	}
	.project-mockup {
		margin-top: clamp(3.5rem, 8vw, 6rem);
		overflow: hidden;
		border: 1px solid var(--line-strong);
		border-radius: 3px;
		background: var(--panel);
	}
	.project-mockup img {
		display: block;
		width: 100%;
		height: auto;
	}
</style>

---
import Base from '../../layouts/Base.astro';
import Masthead from '../../components/Masthead.astro';
import Work from '../../components/home/Work.astro';
import { withLiveStats } from '../../lib/github';
import { featuredProjects } from '../../lib/projects';
import { SITES } from '../../lib/site.data.js';

const projects = await withLiveStats(featuredProjects);
---

<Base
	title="Open-source projects"
	description="Open-source projects by codebam in Rust, TypeScript, Wayland and Cloudflare Workers."
	ogTitle="Open-source projects — codebam"
	canonical={`${SITES.codebam.url}/projects`}
>
	<Masthead label="Rust · TypeScript · Linux" meta={`${projects.length} featured`}>
		<Fragment slot="title">Open-source projects</Fragment>
		<p>Architecture notes and source for the systems I build in the open.</p>
	</Masthead>
	<div class="border-t border-[var(--line)]">
		<Work projects={projects} />
	</div>
</Base>

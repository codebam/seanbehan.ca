---
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import Availability from '../components/Availability.astro';
import { site, LEGAL_NAME, HANDLE, LINKEDIN_URL, writingHref } from '../lib/site';
import SiblingMark from '../components/SiblingMark.astro';

const notes = [
	{
		title: 'What I work on',
		copy: 'My public work sits where application code meets infrastructure: Linux graphics, serverless systems, storage, deployment and the tools around them. I prefer small systems with explicit failure modes, reproducible environments and source a reader can inspect.'
	},
	{
		title: 'Writing',
		copy: 'The articles document things I have built, repaired or had to understand closely enough to explain. Technical posts include commands and examples that worked when published; meaningful later changes are recorded with an updated date.'
	}
];

const destinations = [
	{
		label: 'GitHub projects and source code',
		href: 'https://github.com/codebam',
		external: true
	},
	{ label: 'Technical writing', href: writingHref('/posts'), external: false },
	...(site.showResume
		? [
				{ label: 'Résumé and work history', href: '/resume', external: false },
				{ label: 'LinkedIn', href: LINKEDIN_URL, external: true }
			]
		: []),
	{ label: 'Contact', href: '/contact', external: false }
];

/**
 * The identity table's About copy opens "Since 2014 …", four years before the
 * first dated entry in resume/resume.md (May 2018). H3 in the fix plan asks B
 * to reword that string in site.data.js; until it lands, drop the unsupported
 * span from the page rather than repeat a date the résumé cannot answer. A
 * reworded intro no longer matches and passes through unchanged.
 */
const aboutIntro = site.about.intro.replace('Since 2014 I have worked', 'I have worked');

/** Fixed rather than interpolated: the old line read "the developer behind
 *  ${site.name}", which said the same name twice on the hiring variant. This
 *  copy is true on both origins and names the place and the work. */
const ABOUT_DESCRIPTION = `About ${LEGAL_NAME} (@${HANDLE}) — senior full-stack developer in Ontario, Canada, building Rust, TypeScript, NixOS and Cloudflare Workers projects.`;
---

<Base title="About" description={ABOUT_DESCRIPTION} ogTitle={`About — ${site.name}`}>
	<Masthead label={site.about.eyebrow} meta="Ontario / Canada">
		<Fragment slot="title">{site.about.headline}</Fragment>
		<div class="masthead-profile">
			<img src="/profile.webp" alt={LEGAL_NAME} width="180" height="180" />
			<p>{aboutIntro}</p>
		</div>
		{/* The About page is the other door a hiring reader comes through, so
		    the status follows them here too. `availability` is null on the
		    code-first variant, and the guard keeps its empty wrapper — and the
		    margin that goes with it — out of the flow there. */}
		{site.availability && (
			<div class="masthead-availability">
				<Availability availability={site.availability} />
			</div>
		)}
	</Masthead>

	<section class="section notes panel">
		<div class="shell">
			<div class="section-heading" data-reveal>
				<h2 class="display display-lg">Working notes</h2>
				<p>Systems / writing</p>
			</div>

			<div class="notes-grid">
				{notes.map((note, i) => (
					<article data-reveal data-reveal-delay={i * 55}>
						<h3>{note.title}</h3>
						<p>{note.copy}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section elsewhere panel-alt">
		<div class="shell">
			<div class="section-heading" data-reveal>
				<h2 class="display display-lg">Elsewhere</h2>
				<p>{destinations.length} destinations</p>
			</div>

			<ul class="destination-list" role="list">
				{destinations.map((destination, i) => (
					<li data-reveal data-reveal-delay={i * 45}>
						<a
							href={destination.href}
							target={destination.external ? '_blank' : undefined}
							rel={destination.external ? 'noopener noreferrer' : undefined}
						>
							<strong>{destination.label}</strong>
							<span class="destination-arrow" aria-hidden="true">
								&rarr;
							</span>
							{destination.external && <SiblingMark href={destination.href} newTab />}
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>
</Base>

<style>
	.notes-grid {
		display: grid;
		gap: 0 2.5rem;
	}
	.notes-grid article {
		padding-block: 1.5rem;
		border-top: 1px solid var(--line);
	}
	.notes-grid h3 {
		font-size: 1.125rem;
		font-weight: 600;
		letter-spacing: -0.015em;
	}
	.notes-grid p {
		max-width: 34.25rem;
		margin-top: 0.6rem;
		font-size: 0.9375rem;
		line-height: 1.6;
		color: var(--body);
	}
	.destination-list {
		display: grid;
		gap: 0;
		list-style: none;
	}
	.destination-list a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem;
		padding-block: 1rem;
		border-top: 1px solid var(--line);
		transition: background 0.1s ease;
	}
	.destination-list a:hover,
	.destination-list a:focus-visible {
		background: var(--surface-alt);
	}
	.destination-list strong {
		font-size: 1.0625rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--text);
	}
	.destination-arrow {
		color: var(--accent);
		transition: transform 0.1s ease;
	}
	.destination-list a:hover .destination-arrow,
	.destination-list a:focus-visible .destination-arrow {
		transform: translateX(3px);
	}
	@media (width >= 48rem) {
		.notes-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>

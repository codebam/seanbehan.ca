---
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import { site, LEGAL_NAME, LINKEDIN_URL, writingHref } from '../lib/site';

const notes = [
	{
		title: 'What I work on',
		copy: 'My public work sits where application code meets infrastructure: Linux graphics, serverless systems, storage, deployment and the tools around them. I prefer small systems with explicit failure modes, reproducible environments and source a reader can inspect.'
	},
	{
		title: 'Writing',
		copy: 'The articles document things I have built, repaired or had to understand closely enough to explain. Technical posts include commands and examples that worked when published; meaningful later changes are recorded with an updated date.'
	}
];

const destinations = [
	{
		label: 'GitHub projects and source code',
		href: 'https://github.com/codebam',
		external: true
	},
	{ label: 'Technical writing', href: writingHref('/posts'), external: false },
	...(site.showResume
		? [
				{ label: 'Résumé and work history', href: '/resume', external: false },
				{ label: 'LinkedIn', href: LINKEDIN_URL, external: true }
			]
		: []),
	{ label: 'Contact', href: '/contact', external: false }
];
---

<Base
	title="About"
	description={`About ${LEGAL_NAME}, the developer behind ${site.name} and @codebam.`}
	ogTitle={`About — ${site.name}`}
>
	<Masthead label={site.about.eyebrow} meta="Ontario / Canada">
		<Fragment slot="title">{site.about.headline}</Fragment>
		<div class="masthead-profile">
			<img src="/profile.webp" alt={LEGAL_NAME} width="180" height="180" />
			<p>{site.about.intro}</p>
		</div>
	</Masthead>

	<section class="notes panel">
		<div class="shell">
			<div class="section-heading" data-reveal>
				<h2 class="display display-lg">Working notes</h2>
				<p>Systems / writing</p>
			</div>

			<div class="notes-grid">
				{
					notes.map((note, i) => (
						<article data-reveal data-reveal-delay={i * 55}>
							<h3>{note.title}</h3>
							<p>{note.copy}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="elsewhere panel-alt">
		<div class="shell">
			<div class="section-heading" data-reveal>
				<h2 class="display display-lg">Elsewhere</h2>
				<p>{destinations.length} destinations</p>
			</div>

			<ul class="destination-list">
				{
					destinations.map((destination, i) => (
						<li data-reveal data-reveal-delay={i * 45}>
							<a
								href={destination.href}
								target={destination.external ? '_blank' : undefined}
								rel={destination.external ? 'noopener noreferrer' : undefined}
							>
								<strong>{destination.label}</strong>
								<span class="destination-arrow" aria-hidden="true">
									&rarr;
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</Base>

<style>
	.masthead-profile {
		display: grid;
		grid-template-columns: 5rem 1fr;
		align-items: start;
		gap: 1.25rem;
	}
	.masthead-profile img {
		width: 5rem;
		aspect-ratio: 1;
		border: 1px solid var(--line-strong);
		border-radius: 3px;
		object-fit: cover;
	}
	.notes,
	.elsewhere {
		padding-block: clamp(4.5rem, 9vw, 8rem);
		border-top: 1px solid var(--line);
	}
	.section-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 2rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--line-strong);
	}
	.section-heading > p {
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.notes-grid {
		display: grid;
		gap: 0 3.5rem;
		margin-top: clamp(2.5rem, 5vw, 4rem);
	}
	.notes-grid article {
		min-width: 0;
		padding-left: 1.25rem;
		border-left: 1px solid var(--line-strong);
	}
	.notes-grid h3 {
		font-family: var(--font-serif);
		font-size: clamp(1.5rem, 2.5vw, 2rem);
		font-weight: 500;
		letter-spacing: -0.015em;
	}
	.notes-grid p {
		max-width: 55ch;
		margin-top: 0.9rem;
		font-family: var(--font-serif);
		font-size: 1.05rem;
		line-height: 1.7;
		color: var(--body);
	}
	.destination-list {
		margin-top: clamp(2.5rem, 5vw, 4rem);
		border-top: 1px solid var(--line-strong);
		list-style: none;
	}
	.destination-list li {
		min-width: 0;
		border-bottom: 1px solid var(--line);
	}
	.destination-list a {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 1.35rem 0.25rem;
		transition: background-color 0.2s ease;
	}
	.destination-list strong {
		font-family: var(--font-serif);
		font-size: clamp(1.25rem, 2vw, 1.6rem);
		font-weight: 500;
		letter-spacing: -0.01em;
		line-height: 1.3;
		color: var(--text);
		transition: color 0.2s ease;
	}
	.destination-arrow {
		color: var(--accent-warm);
		transition: transform 0.2s ease;
	}
	.destination-list a:hover,
	.destination-list a:focus-visible {
		background: color-mix(in srgb, var(--accent) 4%, transparent);
	}
	.destination-list a:hover strong,
	.destination-list a:focus-visible strong {
		color: var(--accent);
	}
	.destination-list a:hover .destination-arrow,
	.destination-list a:focus-visible .destination-arrow {
		transform: translateX(3px);
	}
	@media (width >= 48rem) {
		.notes-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (width < 48rem) {
		.section-heading {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.75rem;
		}
		.notes-grid {
			gap: 3rem;
		}
		.masthead-profile {
			grid-template-columns: 4.5rem 1fr;
		}
		.masthead-profile img {
			width: 4.5rem;
		}
	}
</style>

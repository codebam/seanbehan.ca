---
/** Every post carrying one tag, newest first. */
import Base from '../../../layouts/Base.astro';
import Masthead from '../../../components/Masthead.astro';
import PostList from '../../../components/PostList.astro';
import { getPosts } from '../../../lib/posts';
import { displayTag, slugifyTag } from '../../../lib/tags';
import { site } from '../../../lib/site';

const target = slugifyTag(Astro.params.tag!);
const { posts: all, cacheHint } = await getPosts();
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const posts = all.filter((post) => post.meta.tags.some((tag) => slugifyTag(tag) === target));

// A tag nothing carries is not a page. It used to be impossible to reach one —
// the build enumerated the tags that existed — but the pages are rendered per
// request now, so the URL has to answer for itself.
if (posts.length === 0) return Astro.rewrite('/404');

// Prefer a known proper-noun label, then the casing a post actually used, then
// the slug. The old frontmatter was lowercase, so first-seen casing alone
// produced headings like "nixos".
const fromPost = posts[0].meta.tags.find((tag) => slugifyTag(tag) === target) ?? target;
const display = displayTag(fromPost);
const robots = posts.length < 2 ? 'noindex, follow' : undefined;
---

<Base
	title={display}
	description={`${posts.length} ${posts.length === 1 ? 'post' : 'posts'} tagged “${display}”.`}
	ogTitle={`${display} — ${site.name}`}
	robots={robots}
>
	<!-- This topic's own feed, so a reader's extension offers it in place of the
	     whole-site one while they are on the tag page. -->
	<link
		slot="head"
		rel="alternate"
		type="application/rss+xml"
		title={`${display} — ${site.name}`}
		href={`/posts/tag/${target}/rss.xml`}
	/>

	<Masthead label="Filed under" meta={`${posts.length} ${posts.length === 1 ? 'post' : 'posts'}`}>
		<Fragment slot="title">{display}</Fragment>
		<p>Everything filed under this subject, newest first.</p>
		<p class="masthead-actions">
			<a class="link-accent" href="/posts/tags">All tags <span class="arrow">&rarr;</span></a>
			<a class="link-quiet" href={`/posts/tag/${target}/rss.xml`}>Subscribe via RSS</a>
		</p>
	</Masthead>

	<section class="panel">
		<div class="shell pb-24">
			<div data-reveal>
				<PostList posts={posts} headingLevel={2} />
			</div>
		</div>
	</section>
</Base>

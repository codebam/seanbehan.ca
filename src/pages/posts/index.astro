---
/** The archive: every published post, with search over the rendered list. */
import Base from '../../layouts/Base.astro';
import BlueprintMasthead from '../../components/BlueprintMasthead.astro';
import PostList from '../../components/PostList.astro';
import PostSearch from '../../components/PostSearch.astro';
import { getPosts } from '../../lib/posts';
import { site } from '../../lib/site';

const { posts, cacheHint } = await getPosts();
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Base
	title="Writing"
	description="Posts on Linux, NixOS, Rust, and Cloudflare Workers."
	ogTitle={`Writing — ${site.name}`}
>
	<BlueprintMasthead
		label="Writing archive"
		meta={`${String(posts.length).padStart(2, '0')} published`}
	>
		<Fragment slot="title">Writing from <em>underneath the stack.</em></Fragment>
		<p>
			Notes from whatever I am taking apart: Linux and NixOS, containers and systemd, Rust, and the
			edge.
		</p>
		<p class="masthead-actions">
			<a href="/posts/tags" class="link-accent">Browse by tag <span class="arrow">&rarr;</span></a>
		</p>
	</BlueprintMasthead>

	<section id="archive" class="archive panel">
		<div class="archive-shell shell">
			<div class="archive-heading" data-reveal>
				<h2 class="display display-lg"><span class="section-number">02 /</span> All posts</h2>
				<p>{posts.length} entries, newest first</p>
			</div>

			<div class="archive-search" data-reveal data-reveal-delay="60">
				<PostSearch />
			</div>

			<div class="archive-list" data-reveal data-reveal-delay="100">
				<PostList posts={posts} columns={2} showTags raised headingLevel={2} />
			</div>
		</div>
	</section>
</Base>

<style>
	.archive-shell {
		position: relative;
		max-width: 1240px;
		z-index: 1;
	}
	.section-number {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		color: var(--accent-warm);
		vertical-align: middle;
	}
	.archive {
		padding-block: clamp(6rem, 11vw, 10rem);
		border-top: 1px solid var(--line);
	}
	.archive-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 2rem;
	}
	.archive-heading p {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.archive-search {
		margin-top: clamp(2.5rem, 5vw, 4rem);
	}
	.archive-list {
		margin-top: 1.5rem;
	}
	@media (width < 48rem) {
		.archive-heading {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.75rem;
		}
	}
</style>

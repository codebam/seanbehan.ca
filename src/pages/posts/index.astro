---
/** The archive: every published post, with search over the rendered list. */
import Base from '../../layouts/Base.astro';
import Masthead from '../../components/Masthead.astro';
import PostList from '../../components/PostList.astro';
import PostSearch from '../../components/PostSearch.astro';
import { getPosts } from '../../lib/posts';
import { site } from '../../lib/site';

const { posts, cacheHint } = await getPosts();
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Base
	title="Writing"
	description="Posts on Linux, NixOS, Rust, and Cloudflare Workers."
	ogTitle={`Writing — ${site.name}`}
>
	<Masthead label="Writing archive" meta={`${posts.length} published`}>
		<Fragment slot="title">Writing from <em>underneath the stack.</em></Fragment>
		<p>
			Notes from whatever I am taking apart: Linux and NixOS, containers and systemd, Rust, and the
			edge. <a class="link-accent" href="/posts/tags"
				>Browse by tag <span class="arrow">&rarr;</span></a
			>
		</p>
	</Masthead>

	<section id="archive" class="archive panel">
		<div class="shell">
			<div class="archive-heading" data-reveal>
				<h2 class="display display-lg">All posts</h2>
				<p>{posts.length} entries, newest first</p>
			</div>

			<div class="archive-search" data-reveal data-reveal-delay="60">
				<PostSearch />
			</div>

			<div class="archive-list" data-reveal data-reveal-delay="100">
				<PostList posts={posts} columns={2} showTags headingLevel={2} />
			</div>
		</div>
	</section>
</Base>

<style>
	.archive {
		padding-block: clamp(4.5rem, 9vw, 8rem);
		border-top: 1px solid var(--line);
	}
	.archive-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 2rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--line-strong);
	}
	.archive-heading p {
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.archive-search {
		margin-top: clamp(2.5rem, 5vw, 4rem);
	}
	.archive-list {
		margin-top: 1.75rem;
	}
	@media (width < 48rem) {
		.archive-heading {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.75rem;
		}
	}
</style>

---
/** The tag index: every topic, with how many posts sit under it. */
import Base from '../../layouts/Base.astro';
import Masthead from '../../components/Masthead.astro';
import { getPosts, tagCounts } from '../../lib/posts';
import { displayTag } from '../../lib/tags';
import { site } from '../../lib/site';

const { posts, cacheHint } = await getPosts({ includeBodies: false });
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const tags = tagCounts(posts);
---

<Base title="Tags" description="Browse every post by topic." ogTitle={`Tags — ${site.name}`}>
	<Masthead label="Taxonomy index" meta={`${tags.length} topics`}>
		<Fragment slot="title">
			Writing, sorted <em>by subject.</em>
		</Fragment>
		<p>
			Every topic I write about, ordered by how much has been filed under it.{' '}
			<a class="link-accent" href="/posts">
				All writing <span class="arrow">&rarr;</span>
			</a>
		</p>
	</Masthead>

	<section class="section panel">
		<div class="shell">
			<div class="archive-heading" data-reveal>
				<h2 class="display display-lg">All tags</h2>
				<p>Most used first</p>
			</div>

			{tags.length > 0 ? (
				<nav aria-label="Post tags" data-reveal data-reveal-delay="60">
					<ol class="tag-grid" role="list">
						{tags.map((tag) => (
							<li>
								<a href={`/posts/tag/${tag.slug}`}>
									<strong>{displayTag(tag.slug)}</strong>
									<span class="tag-count">
										{tag.count} {tag.count === 1 ? 'post' : 'posts'}
									</span>
								</a>
							</li>
						))}
					</ol>
				</nav>
			) : (
				<p class="empty" data-reveal>
					No topics have been filed yet.
				</p>
			)}
		</div>
	</section>
</Base>

<style>
	.empty {
		padding-block: 2.5rem;
		border-top: 1px solid var(--line);
		color: var(--muted);
	}
	.tag-grid {
		display: grid;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	@media (width >= 48rem) {
		.tag-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			column-gap: 1.25rem;
		}
	}
	@media (width >= 64rem) {
		.tag-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
	.tag-grid a {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 1rem;
		border-top: 1px solid var(--line);
	}
	.tag-grid strong {
		font-size: 1rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--text);
		transition: color 120ms ease;
	}
	.tag-grid a:hover strong,
	.tag-grid a:focus-visible strong {
		color: var(--accent);
	}
	.tag-count {
		font-size: 0.8125rem;
		font-variant-numeric: tabular-nums;
		color: var(--muted);
		white-space: nowrap;
	}
</style>

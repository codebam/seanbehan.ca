---
/** The tag index: every topic, with how many posts sit under it. */
import Base from '../../layouts/Base.astro';
import Masthead from '../../components/Masthead.astro';
import { getPosts, tagCounts } from '../../lib/posts';
import { displayTag } from '../../lib/tags';
import { site } from '../../lib/site';

const { posts, cacheHint } = await getPosts();
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const tags = tagCounts(posts);
---

<Base title="Tags" description="Browse every post by topic." ogTitle={`Tags — ${site.name}`}>
	<Masthead label="Taxonomy index" meta={`${tags.length} topics`}>
		<Fragment slot="title">Writing, sorted <em>by subject.</em></Fragment>
		<p>
			Every topic I write about, ordered by how much has been filed under it. <a
				class="link-accent"
				href="/posts">All writing <span class="arrow">&rarr;</span></a
			>
		</p>
	</Masthead>

	<section class="tag-archive panel">
		<div class="shell">
			<div class="archive-heading" data-reveal>
				<h2 class="display display-lg">All tags</h2>
				<p>Most used first</p>
			</div>

			{
				tags.length > 0 ? (
					<nav class="tag-nav" aria-label="Post tags" data-reveal data-reveal-delay="60">
						<ol class="tag-grid">
							{tags.map((tag) => (
								<li>
									<a href={`/posts/tag/${tag.slug}`}>
										<strong>{displayTag(tag.slug)}</strong>
										<span class="tag-count">
											{tag.count} {tag.count === 1 ? 'post' : 'posts'}
										</span>
									</a>
								</li>
							))}
						</ol>
					</nav>
				) : (
					<p class="empty" data-reveal>
						No topics have been filed yet.
					</p>
				)
			}
		</div>
	</section>
</Base>

<style>
	.tag-archive {
		padding-block: clamp(4.5rem, 9vw, 8rem);
		border-top: 1px solid var(--line);
	}
	.archive-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 2rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--line-strong);
	}
	.archive-heading p {
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.tag-nav {
		margin-top: clamp(2.5rem, 5vw, 4rem);
	}
	.empty {
		margin-top: 4rem;
		padding-block: 3rem;
		border-block: 1px solid var(--line);
		font-family: var(--font-serif);
		font-size: 1.05rem;
		color: var(--muted);
	}
	.tag-grid {
		display: grid;
		list-style: none;
		border-top: 1px solid var(--line-strong);
	}
	.tag-grid li {
		min-width: 0;
		border-bottom: 1px solid var(--line);
	}
	.tag-grid a {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 1.15rem 0.25rem;
		transition: background-color 0.2s ease;
	}
	.tag-grid a:hover,
	.tag-grid a:focus-visible {
		background: color-mix(in srgb, var(--accent) 4%, transparent);
	}
	.tag-grid strong {
		font-family: var(--font-serif);
		font-size: clamp(1.2rem, 2vw, 1.5rem);
		font-weight: 500;
		letter-spacing: -0.01em;
		color: var(--text);
		transition: color 0.2s ease;
	}
	.tag-grid a:hover strong,
	.tag-grid a:focus-visible strong {
		color: var(--accent);
	}
	.tag-count {
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--muted);
		white-space: nowrap;
	}
	@media (width >= 48rem) {
		.tag-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			column-gap: 3.5rem;
		}
	}
	@media (width >= 64rem) {
		.tag-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
	@media (width < 48rem) {
		.archive-heading {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.75rem;
		}
	}
</style>

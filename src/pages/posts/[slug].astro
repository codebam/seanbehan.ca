---
/**
 * One post.
 *
 * Drafts render here — they are absent from every list, the feed and the
 * sitemap, but a draft URL can still be shared, and the layout marks it
 * noindex.
 */
import { getEmDashEntry, getEntryTerms } from 'emdash';
import { PortableText } from 'emdash/ui';
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import Block from '../../components/portable-text/Block.astro';
import Code from '../../components/portable-text/Code.astro';
import { getPosts, prepareBody, toSummary } from '../../lib/posts';
import { LEGAL_NAME } from '../../lib/site';
import { slugifyTag } from '../../lib/tags';
import type { PostSummary } from '../../lib/types';

/** How many "keep reading" entries a post ends with. Two fills the row. */
const RELATED_LIMIT = 2;

/**
 * The contents list, shown only where it earns the space. Four sections is the
 * point where a post stops being scannable in one screen — below that the list
 * is longer than the scroll it saves.
 */
const TOC_MIN_SECTIONS = 4;

const slug = Astro.params.slug!;
const { entry, cacheHint } = await getEmDashEntry('posts', slug);
if (!entry) return Astro.rewrite('/404');
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const tags = (await getEntryTerms('posts', entry.data.id, 'tag')).map((term) => term.slug);
const post = toSummary(entry as never, tags);
const { blocks, headings } = prepareBody(entry.data.content);

const { posts } = await getPosts({ includeBodies: false });

/**
 * The posts either side of this one in the archive's order — newest first, so
 * `newer` is the entry above it and `older` the entry below. A draft is not in
 * the list at all, which is why the lookup can miss and both come back null.
 */
const index = posts.findIndex((entry) => entry.slug === slug);
const newer = index === -1 ? null : (posts[index - 1] ?? null);
const older = index === -1 ? null : (posts[index + 1] ?? null);

/**
 * Posts sharing the most tags with this one, the newest first within a tie.
 * Sharing nothing means not being suggested — a "related" row of unrelated
 * posts is worse than no row, and the sibling links already cover "what else
 * is there".
 */
const tagSet = new Set(tags.map(slugifyTag));
const related: PostSummary[] = tagSet.size
	? posts
			.filter((other) => other.slug !== slug)
			.map((other) => ({
				post: other,
				shared: other.meta.tags.filter((tag) => tagSet.has(slugifyTag(tag))).length
			}))
			.filter((candidate) => candidate.shared > 0)
			.sort(
				(a, b) =>
					b.shared - a.shared ||
					new Date(b.post.meta.date).getTime() - new Date(a.post.meta.date).getTime()
			)
			.slice(0, RELATED_LIMIT)
			.map((candidate) => candidate.post)
	: [];

/** Only tags that some published post carries get a link; the rest are text. */
const publishedTagSlugs = new Set(posts.flatMap((other) => other.meta.tags.map(slugifyTag)));

const toc = headings.length >= TOC_MIN_SECTIONS ? headings : [];
/**
 * Indentation is relative, and prepareBody has already re-based every body so
 * its shallowest heading is an `h2` — so the top level is that, whatever the
 * post was written with, and a deeper heading is the one that gets indented.
 */
const topLevel = 2;

const dateFormat = { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' } as const;
const published = new Date(post.meta.date).toLocaleDateString('en-CA', dateFormat);
const updated = post.meta.updated
	? new Date(post.meta.updated).toLocaleDateString('en-CA', dateFormat)
	: null;
---

{/* Description, og:*, article:* and the BlogPosting JSON-LD all come from the
    layout, which reads the post it is passed. */}
<Base
	title={post.meta.title}
	post={post}
	content={{ collection: 'posts', id: entry.data.id, slug }}
>
	<!-- The same post for a machine reader, advertised into the head the way the
	     feed link is: a bot that parses the head learns the formats exist
	     without being sniffed at, and `Accept: text/markdown` on this URL is
	     answered by the suffixed route (see lib/accept.ts). -->
	<link slot="head" rel="alternate" type="text/markdown" href={`${Astro.url.pathname}.md`} />
	<link slot="head" rel="alternate" type="application/json" href={`${Astro.url.pathname}.json`} />
	<!-- Reading progress: a 2px accent strip across the top of the viewport,
	     driven entirely by a scroll timeline in app.css. No scroll listener, and
	     it is hidden outright for reduced-motion readers. -->
	<div class="read-progress" aria-hidden="true"></div>

	<article class="panel">
		<header class="post-masthead">
			<div class="shell read-column">
				<p class="post-kicker enter">
					<a href="/posts">Writing</a>
					<span>
						<time datetime={post.meta.date}>{published}</time>
						{post.readingMinutes && <> &middot; {post.readingMinutes} min read</>}
					</span>
				</p>

				<h1 class="article-title display enter" style="--enter-delay:40ms">
					{post.meta.title}
				</h1>

				<div class="post-deck enter" style="--enter-delay:100ms">
					{post.meta.description && <p class="description">{post.meta.description}</p>}

					<p class="post-meta">
						<span>
							By{' '}
							<a href="/about" rel="author">
								{LEGAL_NAME}
							</a>
						</span>
						{updated && (
							<>
								<span aria-hidden="true">&middot;</span>
								<time datetime={post.meta.updated}>Updated {updated}</time>
							</>
						)}
						{post.meta.tags.length > 0 && (
							<>
								<span aria-hidden="true">&middot;</span>
								<span class="tag-list">
									{post.meta.tags.map((tag) =>
										publishedTagSlugs.has(slugifyTag(tag)) ? (
											<a class="tag" href={`/posts/tag/${slugifyTag(tag)}`}>
												{tag}
											</a>
										) : (
											<span class="tag">{tag}</span>
										)
									)}
								</span>
							</>
						)}
					</p>
				</div>
			</div>
		</header>

		<div class="post-body shell read-column">
			{toc.length > 0 && (
				/* Only on a post long enough to need it: a contents list above three
					   sections is a second copy of what the reader can already see. On a
					   phone it is folded until tapped (see scripts/toc.ts); the summary
					   keeps the same eyebrow look the list label always had. */
				<nav class="enter toc mt-12" style="--enter-delay:40ms" aria-label="On this page">
					<details open data-toc>
						<summary class="eyebrow">On this page</summary>
						<ol class="mt-4" role="list">
							{toc.map((heading) => (
								<li class={heading.level > topLevel ? 'sub' : undefined}>
									<a href={`#${heading.id}`}>{heading.text}</a>
								</li>
							))}
						</ol>
					</details>
				</nav>
			)}

			<div
				class:list={['enter prose text-[1.08rem]', toc.length > 0 && 'mt-12']}
				style="--enter-delay:60ms"
				data-prose
			>
				<PortableText value={blocks} components={{ block: Block, type: { code: Code } }} />
			</div>

			{related.length > 0 && (
				/* Suggested by shared tags, not by recency: a reader who finished this
					   one is looking for more of the same subject, which is exactly what
					   the sibling links below cannot offer. */
				<aside class="mt-20 border-t border-[var(--line)] pt-10">
					<h2 class="display display-lg">Related reading</h2>
					<div class="mt-8">
						<PostList posts={related} columns={2} headingLevel={3} />
					</div>
				</aside>
			)}

			<footer class="mt-20 border-t border-[var(--line)] pt-10 text-sm">
				<!-- The archive is newest first, so the older post is the one further
				     down it — labelled by direction in time rather than by list order,
				     which is what a reader is actually choosing between. -->
				<nav class="sibling-grid" aria-label="More posts">
					{older && (
						<a href={older.path} class="sibling older">
							<span class="eyebrow">
								<span class="arrow">&larr;</span> Older
							</span>
							<span class="title">{older.meta.title}</span>
						</a>
					)}
					{newer && (
						<a href={newer.path} class="sibling newer">
							<span class="eyebrow">
								Newer <span class="arrow">&rarr;</span>
							</span>
							<span class="title">{newer.meta.title}</span>
						</a>
					)}
				</nav>

				<p class="mt-10">
					<a href="/posts" class="link-accent back">
						<span class="arrow">&larr;</span> All posts
					</a>
				</p>
			</footer>
		</div>
	</article>

	<script>
		import '../../scripts/copy-code';
		import '../../scripts/toc';
	</script>
</Base>

<style>
	/* The article and everything under it share one reading measure, which is
	   narrower than the site shell: headlines can run wider, paragraphs must not. */
	.read-column {
		max-width: 820px;
		margin-inline: auto;
	}
	.post-masthead {
		padding-block: clamp(2.5rem, 6vw, 4rem) clamp(2rem, 4vw, 3rem);
		border-bottom: 1px solid var(--line);
	}
	.post-kicker {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		font-size: 0.82rem;
		font-weight: 500;
		color: var(--muted);
	}
	.post-kicker a {
		color: var(--accent);
		text-decoration: none;
		font-weight: 600;
		transition: color 0.2s ease;
	}
	.post-kicker a:hover,
	.post-kicker a:focus-visible {
		color: var(--accent-hover);
	}
	.article-title {
		margin-top: clamp(1.5rem, 4vw, 2.5rem);
		font-size: clamp(2.25rem, 5vw, 3.5rem);
		line-height: 1.08;
	}
	.post-deck {
		margin-top: clamp(1.25rem, 3vw, 1.75rem);
	}
	.description {
		max-width: 62ch;
		font-size: clamp(1.1rem, 1.6vw, 1.25rem);
		line-height: 1.65;
		color: var(--body);
	}
	.post-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.65rem;
		margin-top: 1.25rem;
		font-size: 0.875rem;
		line-height: 1.5;
		color: var(--muted);
	}
	.post-meta a {
		color: inherit;
		transition: color 0.2s ease;
	}
	.post-meta a:hover,
	.post-meta a:focus-visible {
		color: var(--accent);
	}
	.tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.post-body {
		padding-block: clamp(2.5rem, 6vw, 4rem) clamp(4rem, 8vw, 6rem);
	}
	/* The contents list is a quiet block, not a sidebar: the site has one column
	   and a floating rail would fight the reading measure. */
	.toc details summary {
		list-style: none;
		cursor: pointer;
	}
	.toc details summary::-webkit-details-marker {
		display: none;
	}
	.toc ol {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
		border-left: 2px solid var(--line);
		padding-left: 1.1rem;
		font-size: 0.95rem;
	}
	.toc li.sub {
		padding-left: 1.1rem;
	}
	.toc a {
		color: var(--body);
		transition: color 0.2s ease;
	}
	.toc a:hover,
	.toc a:focus-visible {
		color: var(--accent);
	}

	.sibling-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}
	.sibling {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding: 1.25rem;
		background: var(--panel);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}
	.sibling.newer {
		grid-column: 2;
		text-align: right;
	}
	.sibling:hover,
	.sibling:focus-visible {
		border-color: var(--accent);
		box-shadow: var(--shadow-sm);
	}
	.sibling .title {
		font-size: 1.1rem;
		font-weight: 600;
		letter-spacing: -0.015em;
		line-height: 1.35;
		color: var(--text);
		transition: color 0.2s ease;
	}
	.sibling:hover .title,
	.sibling:focus-visible .title {
		color: var(--accent);
	}
	.sibling.newer:hover :global(.arrow),
	.sibling.newer:focus-visible :global(.arrow) {
		transform: translateX(3px);
	}
	.sibling.older:hover :global(.arrow),
	.sibling.older:focus-visible :global(.arrow) {
		transform: translateX(-3px);
	}
	.back:hover :global(.arrow),
	.back:focus-visible :global(.arrow) {
		transform: translateX(-3px);
	}
	@media (width < 48rem) {
		.post-masthead {
			padding-block: 2.5rem 2rem;
		}
		.sibling-grid {
			grid-template-columns: 1fr;
		}
		.sibling.newer {
			grid-column: 1;
			text-align: left;
		}
	}
	@media (width < 30rem) {
		.post-kicker {
			flex-wrap: wrap;
			gap: 0.35rem 1rem;
		}
	}
</style>

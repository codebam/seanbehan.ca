---
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import { LinkButton } from '@cloudflare/kumo/components/button';
import { LINKEDIN_URL } from '../lib/site';
import { COMMERCE, SITES } from '../lib/site.data.js';

const serviceSite = SITES.seanbehan;
const operator = COMMERCE.seanbehan;

/**
 * The commercial facts, with a number-free fallback for every field the
 * operator has not supplied. `COMMERCE` in src/lib/site.data.js is the
 * switch: a string there replaces the fallback sentence with no template
 * change, and nothing here invents a price, a duration or a booking state.
 */
const facts = [
	{
		label: 'Pricing',
		value:
			operator.startingPrice ??
			'Quoted by email. There is no fixed price list; the quote follows a short scope.'
	},
	{
		label: 'Timeline',
		value: operator.timeline ?? 'Discussed alongside the quote before anything starts.'
	},
	{
		label: 'Availability',
		value: operator.availability ?? 'Ask for the next opening by email.'
	},
	{
		label: 'Reply',
		value: operator.replyWindow ?? 'Replies by email.'
	}
];

/**
 * CLIENT PROOF SLOT — operator content only.
 *
 * Add real, permissioned outcomes here (2–3 of them, each with a quote and
 * an attributable name) and the section below renders itself. It stays
 * empty until then on purpose: a placeholder testimonial is a fabricated
 * reference, which is worse than no proof at all.
 */
const outcomes: { quote: string; name: string; detail: string }[] = [];
const canonical = `${serviceSite.url}/services`;
const contactHref = `mailto:${serviceSite.email}?subject=${encodeURIComponent('Website or Telegram bot project')}`;

const services = [
	{
		label: 'Website launch package',
		title: 'Launch a site that does a job.',
		copy: 'A custom, accessible business website built around a clear goal: explain the offer, earn trust, and turn the right visitors into customers.',
		items: [
			'Landing page or focused business site',
			'Responsive design and content structure',
			'Forms, analytics, SEO, and deployment'
		]
	},
	{
		label: 'Telegram bot package',
		title: 'Put the busywork on a bot.',
		copy: 'A purpose-built Telegram bot for your community or business, from a focused command workflow to a connected production service.',
		items: [
			'Commands, menus, and automated replies',
			'Payments, notifications, and API integrations',
			'Hosting, data storage, and admin tools'
		]
	}
];

const steps = [
	['Scope', 'Define the audience, the job to be done, and what a successful launch needs.'],
	['Design', 'Turn the scope into a clear interface and a practical technical plan.'],
	['Build', 'Implement in small reviewable stages, with progress visible throughout.'],
	['Launch', 'Test the production path, deploy it, and document what you own.']
];

const schema = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'Service',
	'@id': `${canonical}#service`,
	name: 'Website and Telegram bot development',
	description: 'Custom website and Telegram bot design, development, integration, and launch.',
	url: canonical,
	provider: {
		'@type': 'Person',
		name: 'Sean Behan',
		url: serviceSite.url,
		sameAs: ['https://github.com/codebam', LINKEDIN_URL]
	},
	areaServed: 'Worldwide',
	serviceType: ['Website development', 'Telegram bot development']
}).replace(/</g, '\\u003c');
---

<Base
	title="Website and Telegram Bot Development"
	description="Custom websites and Telegram bots designed, built, integrated, and launched by Sean Behan."
	ogTitle="Websites and Telegram bots, built to ship — Sean Behan"
	ogDescription="Custom web development and Telegram automation without the agency handoff."
	canonical={canonical}
>
	<script slot="head" type="application/ld+json" is:inline set:html={schema}></script>
	<Masthead label="Custom project packages / Direct collaboration" meta="Quoted by email">
		<Fragment slot="title">
			Your idea, built to <em>work.</em>
		</Fragment>
		<p>
			Custom websites and Telegram bots, taken from a clear scope to a production launch. You work
			directly with <a href="/about">Sean Behan</a>, the developer doing the work.
		</p>
		<p class="masthead-actions">
			<LinkButton href={contactHref} variant="primary" size="lg" className="flat-control site-cta">
				Request a project quote
			</LinkButton>
			<span class="eyebrow response-note">No checkout / scoped by email</span>
		</p>
	</Masthead>

	<section class="section services panel-alt">
		<div class="shell">
			<div class="section-heading" data-reveal>
				<h2 class="display display-lg">Choose a starting point</h2>
				<p>Two custom packages</p>
			</div>

			<div class="service-grid">
				{services.map((service, i) => (
					<article data-reveal data-reveal-delay={i * 70}>
						<p class="eyebrow service-label">{service.label}</p>
						<h3>{service.title}</h3>
						<p>{service.copy}</p>
						<ul>
							{service.items.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section quote panel">
		<div class="shell">
			<div class="section-head" data-reveal>
				<div>
					<h2 class="display display-lg">Price and timing</h2>
					<p class="section-sub">What is known before work starts</p>
				</div>
			</div>

			<dl class="quote-grid">
				{facts.map((fact, i) => (
					<div data-reveal data-reveal-delay={i * 45}>
						<dt>{fact.label}</dt>
						<dd>{fact.value}</dd>
					</div>
				))}
			</dl>
		</div>
	</section>

	<section class="section process panel-alt">
		<div class="shell">
			<div class="section-heading" data-reveal>
				<h2 class="display display-lg">One clear path</h2>
				<p>Scope to launch</p>
			</div>

			<ol class="process-list">
				{steps.map(([title, copy], i) => (
					<li data-reveal data-reveal-delay={i * 50}>
						<span class="step-index">{String(i + 1).padStart(2, '0')}</span>
						<h3>{title}</h3>
						<p>{copy}</p>
					</li>
				))}
			</ol>
		</div>
	</section>

	<section class="section project-brief panel">
		<div class="shell brief-grid">
			<div data-reveal>
				<p class="eyebrow">Have something in mind?</p>
				<h2 class="display display-lg mt-4">Start with the problem.</h2>
			</div>
			<div class="brief-copy" data-reveal data-reveal-delay="60">
				<p>
					Send a short note with what you want to make, who it is for, and when you want it live. I
					will reply with questions and a practical next step.
				</p>
				<LinkButton
					href={contactHref}
					variant="primary"
					size="lg"
					className="flat-control site-cta"
				>
					Email {serviceSite.email}
				</LinkButton>
				<p class="brief-links">
					<a class="link-accent" href="/projects">
						Read a case study{' '}
						<span class="arrow" aria-hidden="true">
							&rarr;
						</span>
					</a>
					<a class="link-quiet" href="/about">
						About Sean
					</a>
				</p>
				<a class="kit-link link-accent" href="/products/cloudflare-workers-production-kit">
					Building it yourself? See the production kit{' '}
					<span class="arrow" aria-hidden="true">
						&rarr;
					</span>
				</a>
			</div>
		</div>
	</section>

	{outcomes.length > 0 && (
		<section class="section outcomes panel-alt">
			<div class="shell">
				<div class="section-head" data-reveal>
					<div>
						<h2 class="display display-lg">Client outcomes</h2>
						<p class="section-sub">Published with permission</p>
					</div>
				</div>
				<div class="outcome-grid">
					{outcomes.map((outcome, i) => (
						<figure class="card" data-reveal data-reveal-delay={i * 55}>
							<blockquote>{outcome.quote}</blockquote>
							<figcaption>
								{outcome.name}
								<span>{outcome.detail}</span>
							</figcaption>
						</figure>
					))}
				</div>
			</div>
		</section>
	)}
</Base>

<style>
	.response-note {
		align-self: center;
	}
	.service-grid {
		display: grid;
		gap: 1.25rem;
	}
	.service-grid article {
		padding: 1.75rem;
		background: var(--panel);
		border: 1px solid var(--line);
		border-radius: var(--radius);
	}
	.service-grid h3 {
		margin-top: 0.6rem;
		font-size: 1.15rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		line-height: 1.3;
	}
	.service-grid article > p {
		margin-top: 0.75rem;
		font-size: 0.98rem;
		line-height: 1.65;
		color: var(--body);
	}
	.service-grid ul {
		display: grid;
		gap: 0.55rem;
		margin-top: 1.25rem;
		list-style: none;
		font-size: 0.92rem;
		color: var(--body);
	}
	.service-grid li::before {
		content: '—';
		margin-right: 0.65rem;
		color: var(--accent-warm);
	}
	.process-list {
		display: grid;
		gap: 1.25rem;
		list-style: none;
	}
	.process-list li {
		padding: 1.5rem;
		background: var(--panel);
		border: 1px solid var(--line);
		border-radius: var(--radius);
	}
	.step-index {
		display: block;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: var(--accent-warm);
	}
	.process-list h3 {
		margin-top: 0.5rem;
		font-size: 1.0625rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		line-height: 1.35;
	}
	.process-list p {
		margin-top: 0.5rem;
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--body);
	}
	.brief-grid {
		display: grid;
		align-items: start;
		gap: 2rem;
	}
	.brief-grid h2 {
		max-width: 14ch;
	}
	.brief-copy {
		padding-top: 1.5rem;
		border-top: 1px solid var(--line);
	}
	.brief-copy > p {
		font-size: 1.05rem;
		line-height: 1.7;
		color: var(--body);
	}
	.brief-copy :global(a[role='button']) {
		margin-top: 1.5rem;
	}
	.kit-link {
		display: block;
		width: fit-content;
		margin-top: 1.25rem;
	}
	@media (width >= 48rem) {
		.service-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.process-list {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
		.brief-grid {
			grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.8fr);
			gap: 4rem;
		}
	}
	.quote-grid {
		display: grid;
		gap: 1.25rem;
		margin-top: 1.5rem;
	}
	.quote-grid > div {
		padding: 1.5rem;
		background: var(--panel);
		border: 1px solid var(--line);
		border-radius: var(--radius);
	}
	.quote-grid dt {
		font-family: var(--font-sans);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent-warm);
	}
	.quote-grid dd {
		margin-top: 0.6rem;
		font-size: 0.95rem;
		line-height: 1.65;
		color: var(--body);
	}
	.brief-links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 1.5rem;
		margin-top: 1.5rem;
	}
	.outcome-grid {
		display: grid;
		gap: 1.25rem;
		margin-top: 1.5rem;
	}
	.outcome-grid figure {
		padding: 1.75rem;
	}
	.outcome-grid blockquote {
		font-family: var(--font-serif);
		font-size: 1.1rem;
		line-height: 1.65;
		color: var(--text);
	}
	.outcome-grid figcaption {
		margin-top: 1rem;
		font-family: var(--font-sans);
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--text);
	}
	.outcome-grid figcaption span {
		display: block;
		margin-top: 0.15rem;
		font-weight: 400;
		color: var(--muted);
	}
	@media (width >= 48rem) {
		.quote-grid,
		.outcome-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>

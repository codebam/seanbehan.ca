---
/**
 * Elsewhere: pages and writing worth finding again, newest first.
 *
 * The collection is the only moving part, so the page is a thin loop over it
 * and owns its own list styling — the rows are external links with a domain,
 * which PostList's rows are not.
 */
import Base from '../layouts/Base.astro';
import BlueprintMasthead from '../components/BlueprintMasthead.astro';
import { getEmDashCollection } from 'emdash';

interface LinkEntry {
	id: string;
	data: {
		title: string;
		url: string;
		note?: string | null;
		createdAt?: Date | null;
	};
}

/**
 * Swallowed rather than fatal: the collection arrives on a running database
 * through the schema CLI, so a code deploy can beat it on a given environment.
 * An empty page is the state that describes a database without the table; a
 * 500 is not.
 */
let links: LinkEntry[] = [];
try {
	const result = await getEmDashCollection('links', {
		status: 'published',
		orderBy: { created_at: 'desc' },
		limit: 100
	});
	links = result.entries as unknown as LinkEntry[];
	if (Astro.cache?.enabled) Astro.cache.set(result.cacheHint);
} catch {
	links = [];
}

/** The hostname is the fact a reader files under "which site was this". */
const domainOf = (url: string) => {
	try {
		return new URL(url).hostname.replace(/^www\./, '');
	} catch {
		return '';
	}
};

// Same month-year the post lists use — "when" in a list is the season.
const added = (date: Date | null | undefined) =>
	date
		? new Date(date).toLocaleDateString('en-CA', {
				month: 'short',
				year: 'numeric',
				timeZone: 'UTC'
			})
		: '';
---

<Base title="Links" description="Pages and writing worth finding again." ogTitle="Links">
	<BlueprintMasthead
		label="Elsewhere index"
		meta={`${String(links.length).padStart(2, '0')} saved`}
	>
		<Fragment slot="title">Good things, <em>filed for later.</em></Fragment>
		<p>Places and writing worth finding again: the ones I have actually come back to.</p>
	</BlueprintMasthead>

	<section class="link-archive panel">
		<div class="archive-shell shell">
			<div class="archive-heading" data-reveal>
				<h2 class="display display-lg"><span class="section-number">02 /</span> Filed links</h2>
				<p>Newest additions first</p>
			</div>

			{
				links.length === 0 ? (
					<p class="empty" data-reveal>
						Nothing has been filed here yet.
					</p>
				) : (
					<ol class="link-grid" data-reveal data-reveal-delay="60">
						{links.map((entry, i) => (
							<li>
								<a class="link-entry" href={entry.data.url} target="_blank" rel="noopener">
									<span class="entry-number" aria-hidden="true">
										{String(i + 1).padStart(2, '0')}
									</span>
									<p class="facts">
										{added(entry.data.createdAt) && (
											<time datetime={entry.data.createdAt?.toISOString()}>
												{added(entry.data.createdAt)}
											</time>
										)}
										<span class="domain">{domainOf(entry.data.url)}</span>
									</p>
									<h3>{entry.data.title}</h3>
									{entry.data.note && <p class="note">{entry.data.note}</p>}
									<span class="external" aria-hidden="true">
										Open &nearr;
									</span>
								</a>
							</li>
						))}
					</ol>
				)
			}
		</div>
	</section>
</Base>

<style>
	.link-archive {
		padding-block: clamp(6rem, 11vw, 10rem);
		border-top: 1px solid var(--line);
	}
	.archive-shell {
		max-width: 1240px;
	}
	.archive-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 2rem;
	}
	.section-number,
	.entry-number {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		color: var(--accent-warm);
		vertical-align: middle;
	}
	.archive-heading > p,
	.external {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.link-grid {
		display: grid;
		margin-top: clamp(2.5rem, 5vw, 4rem);
		border-bottom: 1px solid var(--line);
		list-style: none;
	}
	.link-grid li {
		min-width: 0;
		border-top: 1px solid var(--line);
	}
	.link-entry {
		display: flex;
		flex-direction: column;
		height: 100%;
		min-height: 18rem;
		padding: 1.75rem;
		transition:
			background-color 0.25s ease,
			color 0.25s ease;
	}
	.link-entry:hover,
	.link-entry:focus-visible {
		background: color-mix(in srgb, var(--accent) 4%, transparent);
	}
	.entry-number {
		display: block;
		margin-bottom: 3rem;
	}
	.facts {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		font-size: 0.78rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.domain {
		color: var(--muted);
		word-break: break-all;
	}
	.link-entry h3 {
		margin-top: 0.5rem;
		font-size: clamp(1.35rem, 2vw, 1.8rem);
		line-height: 1.15;
		font-weight: 500;
		letter-spacing: -0.025em;
		transition: color 0.2s ease;
	}
	.link-entry:hover h3,
	.link-entry:focus-visible h3 {
		color: var(--accent);
	}
	.note {
		margin-top: 0.6rem;
		max-width: 62ch;
		color: var(--body);
		font-size: 0.95rem;
		line-height: 1.6;
	}
	.external {
		margin-top: auto;
		padding-top: 2rem;
	}
	.empty {
		margin-top: 4rem;
		padding-block: 3rem;
		border-block: 1px solid var(--line);
		color: var(--muted);
	}
	@media (width >= 48rem) {
		.link-grid {
			grid-template-columns: 1fr 1fr;
		}
		.link-grid li:nth-child(even) {
			border-left: 1px solid var(--line);
		}
	}
	@media (width < 48rem) {
		.archive-heading {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.75rem;
		}
	}
</style>

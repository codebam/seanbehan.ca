---
/**
 * Elsewhere: pages and writing worth finding again, newest first.
 *
 * The collection is the only moving part, so the page is a thin loop over it
 * and owns its own list styling — the rows are external links with a domain,
 * which PostList's rows are not.
 */
import Base from '../layouts/Base.astro';
import { getEmDashCollection } from 'emdash';

interface LinkEntry {
	id: string;
	data: {
		title: string;
		url: string;
		note?: string | null;
		createdAt?: Date | null;
	};
}

/**
 * Swallowed rather than fatal: the collection arrives on a running database
 * through the schema CLI, so a code deploy can beat it on a given environment.
 * An empty page is the state that describes a database without the table; a
 * 500 is not.
 */
let links: LinkEntry[] = [];
try {
	const result = await getEmDashCollection('links', {
		status: 'published',
		orderBy: { created_at: 'desc' },
		limit: 100
	});
	links = result.entries as unknown as LinkEntry[];
	if (Astro.cache?.enabled) Astro.cache.set(result.cacheHint);
} catch {
	links = [];
}

/** The hostname is the fact a reader files under "which site was this". */
const domainOf = (url: string) => {
	try {
		return new URL(url).hostname.replace(/^www\./, '');
	} catch {
		return '';
	}
};

// Same month-year the post lists use — "when" in a list is the season.
const added = (date: Date | null | undefined) =>
	date
		? new Date(date).toLocaleDateString('en-CA', {
				month: 'short',
				year: 'numeric',
				timeZone: 'UTC'
			})
		: '';
---

<Base title="Links" description="Pages and writing worth finding again." ogTitle="Links">
	<section class="panel pt-14 pb-20 md:pt-16 md:pb-24">
		<div class="shell">
			<p class="enter eyebrow">Elsewhere</p>
			<h1 class="display display-xl mt-5">Links</h1>
			<p
				class="enter mt-6 max-w-[52ch] text-[1.15rem] leading-[1.55] text-[var(--body)] md:text-[1.3rem]"
				style="--enter-delay:80ms"
			>
				Places and writing worth finding again — the ones I have actually come back to.
			</p>

			{
				links.length === 0 ? (
					<p class="mt-12 border-t border-[var(--line)] pt-10 text-[var(--muted)]">
						Nothing has been filed here yet.
					</p>
				) : (
					<ol class="list mt-12">
						{links.map((entry) => (
							<li class="item">
								<p class="facts">
									{added(entry.data.createdAt) && (
										<time datetime={entry.data.createdAt?.toISOString()}>
											{added(entry.data.createdAt)}
										</time>
									)}
									<span class="domain" data-domain={domainOf(entry.data.url)}>
										{domainOf(entry.data.url)}
									</span>
								</p>
								<a class="title" href={entry.data.url} target="_blank" rel="noopener">
									{entry.data.title}
								</a>
								{entry.data.note && <p class="note">{entry.data.note}</p>}
							</li>
						))}
					</ol>
				)
			}
		</div>
	</section>
</Base>

<style>
	.list {
		list-style: none;
	}

	.item .facts {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		font-size: 0.78rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--muted);
	}

	/* The domain is metadata, not a second headline: same voice as the date. */
	.item .domain {
		color: var(--muted);
		word-break: break-all;
	}

	.item .title {
		display: inline;
		margin-top: 0.35rem;
		font-size: 1.2rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		color: var(--text);
		text-decoration: underline;
		text-decoration-color: var(--line-strong);
		text-underline-offset: 4px;
		transition:
			color 0.2s ease,
			text-decoration-color 0.2s ease;
	}

	.item .title:hover,
	.item .title:focus-visible {
		color: var(--accent);
		text-decoration-color: var(--accent);
	}

	.item .note {
		margin-top: 0.3rem;
		max-width: 62ch;
		color: var(--body);
		font-size: 0.95rem;
		line-height: 1.6;
	}
</style>

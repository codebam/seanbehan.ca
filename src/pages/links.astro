---
/**
 * Elsewhere: pages and writing worth finding again, newest first.
 *
 * The collection is the only moving part, so the page is a thin loop over it
 * and owns its own list styling — the rows are external links with a domain,
 * which PostList's rows are not.
 */
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import { getEmDashCollection } from 'emdash';

interface LinkEntry {
	id: string;
	data: {
		title: string;
		url: string;
		note?: string | null;
		createdAt?: Date | null;
	};
}

/**
 * Swallowed rather than fatal: the collection arrives on a running database
 * through the schema CLI, so a code deploy can beat it on a given environment.
 * An empty page is the state that describes a database without the table; a
 * 500 is not.
 */
let links: LinkEntry[] = [];
try {
	const result = await getEmDashCollection('links', {
		status: 'published',
		orderBy: { created_at: 'desc' },
		limit: 100
	});
	links = result.entries as unknown as LinkEntry[];
	if (Astro.cache?.enabled) Astro.cache.set(result.cacheHint);
} catch {
	links = [];
}

/** The hostname is the fact a reader files under "which site was this". */
const domainOf = (url: string) => {
	try {
		return new URL(url).hostname.replace(/^www\./, '');
	} catch {
		return '';
	}
};

// Same month-year the post lists use — "when" in a list is the season.
const added = (date: Date | null | undefined) =>
	date
		? new Date(date).toLocaleDateString('en-CA', {
				month: 'short',
				year: 'numeric',
				timeZone: 'UTC'
			})
		: '';
---

<Base title="Links" description="Pages and writing worth finding again." ogTitle="Links">
	<Masthead label="Elsewhere index" meta={`${links.length} saved`}>
		<Fragment slot="title">Good things, <em>filed for later.</em></Fragment>
		<p>Places and writing worth finding again: the ones I have actually come back to.</p>
	</Masthead>

	<section class="link-archive panel">
		<div class="shell">
			<div class="archive-heading" data-reveal>
				<h2 class="display display-lg">Filed links</h2>
				<p>Newest additions first</p>
			</div>

			{
				links.length === 0 ? (
					<p class="empty" data-reveal>
						Nothing has been filed here yet.
					</p>
				) : (
					<ol class="link-list" data-reveal data-reveal-delay="60">
						{links.map((entry) => (
							<li>
								<a class="link-entry" href={entry.data.url} target="_blank" rel="noopener">
									<p class="facts">
										{added(entry.data.createdAt) && (
											<time datetime={entry.data.createdAt?.toISOString()}>
												{added(entry.data.createdAt)}
											</time>
										)}
										<span class="domain">{domainOf(entry.data.url)}</span>
									</p>
									<div class="title-row">
										<h3>{entry.data.title}</h3>
										<span class="external" aria-hidden="true">
											&nearr;
										</span>
									</div>
									{entry.data.note && <p class="note">{entry.data.note}</p>}
								</a>
							</li>
						))}
					</ol>
				)
			}
		</div>
	</section>
</Base>

<style>
	.link-archive {
		padding-block: clamp(4.5rem, 9vw, 8rem);
		border-top: 1px solid var(--line);
	}
	.archive-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 2rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--line-strong);
	}
	.archive-heading > p {
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.link-list {
		margin-top: clamp(2.5rem, 5vw, 4rem);
		border-top: 1px solid var(--line-strong);
		list-style: none;
	}
	.link-list li {
		min-width: 0;
		border-bottom: 1px solid var(--line);
	}
	.link-entry {
		display: block;
		padding: 1.75rem 0.25rem;
		transition: background-color 0.2s ease;
	}
	.link-entry:hover,
	.link-entry:focus-visible {
		background: color-mix(in srgb, var(--accent) 4%, transparent);
	}
	.facts {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 1.25rem;
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.domain {
		word-break: break-all;
	}
	.title-row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.5rem;
		margin-top: 0.6rem;
	}
	.link-entry h3 {
		font-family: var(--font-serif);
		font-size: clamp(1.4rem, 2.2vw, 1.8rem);
		line-height: 1.2;
		font-weight: 500;
		letter-spacing: -0.01em;
		color: var(--text);
		transition: color 0.2s ease;
	}
	.link-entry:hover h3,
	.link-entry:focus-visible h3 {
		color: var(--accent);
	}
	.external {
		color: var(--accent-warm);
		transition: transform 0.2s ease;
	}
	.link-entry:hover .external,
	.link-entry:focus-visible .external {
		transform: translate(2px, -2px);
	}
	.note {
		max-width: 68ch;
		margin-top: 0.5rem;
		font-family: var(--font-serif);
		color: var(--body);
		font-size: 1rem;
		line-height: 1.6;
	}
	.empty {
		margin-top: 4rem;
		padding-block: 3rem;
		border-block: 1px solid var(--line);
		font-family: var(--font-serif);
		font-size: 1.05rem;
		color: var(--muted);
	}
	@media (width < 48rem) {
		.archive-heading {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.75rem;
		}
	}
</style>

---
/**
 * The résumé.
 *
 * The document is inline, in this site's own type, rather than a PDF in a box:
 * an embedded PDF is unreadable on a phone, invisible to a text browser and to
 * anything that indexes the page, and it styles the career in a face the rest
 * of the site never uses. The fragment comes out of R2 — built by CI from
 * resume/resume.md by the same pandoc pass that typesets the PDF, so the two
 * cannot disagree about what 2021 looked like. They differ in exactly two
 * places: the fragment carries classes where the PDF carries LaTeX macros, and
 * its headings start two levels lower so the résumé's sections sit underneath
 * this page's own. The PDF stays one click away for anyone who means to print
 * it or forward it as an attachment.
 *
 * The codebam variant does not pitch a résumé: it is omitted from the nav and
 * the sitemap, and the route answers 404 there rather than serving a page
 * titled "Résumé — codebam" that nothing links to.
 */
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import Availability from '../components/Availability.astro';
import { LinkButton } from '@cloudflare/kumo/components/button';
import { getResumeFragment, resumePdfFilename, resumeTxtFilename } from '../lib/resume';
import { featuredProjects } from '../lib/projects';
import { site, yearsBuilding, LINKEDIN_URL } from '../lib/site';
import SiblingMark from '../components/SiblingMark.astro';

if (!site.showResume) return Astro.rewrite('/404');

const RESUME_PDF = '/resume.pdf';
const resume = await getResumeFragment();

if (resume && Astro.cache?.enabled) {
	// The object's own upload time is the only truthful last-modified here: this
	// page reads no content out of D1, so EmDash's tags have nothing to say about
	// it. See docs/edge-caching.md.
	Astro.cache.set({ tags: ['resume'], lastModified: resume.updatedAt });
}

const intro = site.intro.replace('{years}', String(yearsBuilding()));

/**
 * The three things a hiring reader is actually trying to settle before they
 * read a single dated entry: what the stack is, whether any of it has met
 * production, and what working with this person is like. The section used to
 * answer a different question — systems, open source, writing — which is the
 * question a reader who has already decided to hire asks.
 *
 * Every claim here is one the résumé below or the project pages make at
 * length; this is the summary, not a second set of facts. The star count is
 * read from projects.ts rather than retyped, because a number written down
 * twice eventually disagrees with itself and the home page's project row is
 * the copy a reader will check this against.
 */
const botStars = featuredProjects.find((p) => p.slug === 'cloudflare-telegram-bot')?.stars ?? 0;

const profile = [
	{
		label: 'What I build',
		copy: 'Web applications from database to frontend in TypeScript and Rust, and services on Cloudflare Workers, Durable Objects, D1 and R2. NixOS on every machine I own, so an environment is a file rather than a memory.'
	},
	{
		label: 'What has shipped',
		copy: `A paid streaming control plane that takes money and relays live video to five providers. A Telegram bot framework with ${botStars} stars and 120 npm releases. A Wayland compositor that composites a web page zero-copy beside native clients.`
	},
	{
		label: 'How I work',
		copy: 'Small systems with explicit failure modes, and write-ups of what broke. The published posts are the clearest evidence I have that I can explain a decision to someone who has to live with it.'
	}
];

/** R2's upload time, phrased for a reader rather than for a log line. */
const updated = resume
	? new Intl.DateTimeFormat('en-CA', { year: 'numeric', month: 'long', day: 'numeric' }).format(
			resume.updatedAt
		)
	: null;
---

<Base
	title="Résumé"
	description={`Résumé for ${site.name}, senior full-stack developer. ${site.availability?.detail ?? ''}`}
	ogTitle={`Résumé — ${site.name}`}
>
	<!-- The source document, the way a post advertises its markdown: /resume.md
	     is what the fragment and the PDF were built from, so the two can never
	     disagree about what they say. -->
	<link slot="head" rel="alternate" type="text/markdown" href="/resume.md" />
	<!-- The plain-text rendering, advertised the same way: it is a format
	     /resume serves, not a page of its own. -->
	<link slot="head" rel="alternate" type="text/plain" href="/resume.txt" />
	<Masthead label="Résumé · Sean Behan" meta="Remote / Greater Toronto Area">
		<Fragment slot="title">
			Senior full-stack developer, <em>open to work.</em>
		</Fragment>
		<p class="masthead-blurb">{intro}</p>
		<div class="masthead-availability">
			<Availability availability={site.availability} />
		</div>
		<!-- The PDF leads rather than the mailto, for the reason the comment at
		     the top of this file gives: the document is already inline, so what
		     this page adds is the portable copy a reader forwards. A mailto is
		     also the one control here that can silently do nothing — no mail
		     handler, a shared inbox, webmail — and a page whose whole job is to
		     be handed to someone else should not make that its first ask. The
		     address is still prominent beside it, and /contact carries a copy
		     button for the readers mailto fails. -->
		<p class="masthead-actions">
			<LinkButton
				href={RESUME_PDF}
				download={resumePdfFilename()}
				variant="primary"
				size="lg"
				className="flat-control site-cta"
			>
				Download PDF
			</LinkButton>
			<LinkButton
				href={`mailto:${site.email}?subject=${encodeURIComponent('A role for Sean')}`}
				variant="secondary"
				size="lg"
			>
				Email {site.email}
			</LinkButton>
			<!-- The ATS copy of the document, beside the PDF. Quiet because the
			     PDF is still what a reader forwards; this is what an application
			     form or a parser would rather have. -->
			<a class="link-quiet" href="/resume.txt" download={resumeTxtFilename()}>
				Plain text (.txt)
			</a>
			<a class="link-quiet" href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer">
				LinkedIn
				<SiblingMark href={LINKEDIN_URL} newTab />
			</a>
			<a
				class="link-quiet"
				href="https://github.com/codebam"
				target="_blank"
				rel="noopener noreferrer"
			>
				GitHub
				<SiblingMark href="https://github.com/codebam" newTab />
			</a>
		</p>
	</Masthead>

	<section class="section profile panel">
		<div class="shell">
			<div class="section-heading" data-reveal>
				<h2 class="display display-lg">Working profile</h2>
				<p>Stack / shipped / method</p>
			</div>
			<div class="profile-grid">
				{profile.map((item, i) => (
					<article data-reveal data-reveal-delay={i * 55}>
						<h3>{item.label}</h3>
						<p>{item.copy}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section document panel-alt">
		<div class="shell">
			<div class="section-heading" data-reveal>
				<h2 class="display display-lg">The document</h2>
				<a class="link-accent" href={RESUME_PDF} download={resumePdfFilename()}>
					Download the PDF <span class="arrow">&rarr;</span>
				</a>
			</div>
			{updated && (
				<p class="document-note">Typeset from the same source as the PDF · updated {updated}</p>
			)}

			{resume ? (
				<Fragment set:html={resume.html} />
			) : (
				/* The bucket has no fragment in it: a fresh clone with an empty dev
					   store, or a build that uploaded nothing. Said out loud rather than
					   left as a hole where the résumé should be. */
				<div class="document-missing">
					<p>
						The inline copy is not available on this build of the site. The PDF is, and it is the
						same document.
					</p>
					<p>
						Locally: <code>npm run resume</code> then <code>npm run resume:seed</code>.
					</p>
					<p>
						<a class="link-accent" href={RESUME_PDF} download={resumePdfFilename()}>
							Download the PDF &rarr;
						</a>
					</p>
				</div>
			)}
		</div>
	</section>
</Base>

<style>
	.document-note {
		max-width: 46rem;
		margin: -1.5rem auto 1.5rem;
		font-size: 0.85rem;
		color: var(--muted);
	}
	.profile-grid {
		display: grid;
		gap: 1.25rem;
	}
	.profile-grid article {
		padding: 1.5rem;
		background: var(--panel);
		border: 1px solid var(--line);
		border-radius: var(--radius);
	}
	.profile-grid h3 {
		font-size: 1.2rem;
		font-weight: 600;
		letter-spacing: -0.015em;
	}
	.profile-grid p {
		margin-top: 0.6rem;
		font-size: 0.98rem;
		line-height: 1.65;
		color: var(--body);
	}
	.document-missing {
		max-width: 46rem;
		margin: clamp(2rem, 4vw, 3rem) auto 0;
		padding: 1.5rem;
		background: var(--panel);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		color: var(--body);
	}
	.document-missing p + p {
		margin-top: 0.85rem;
	}
	.document-missing code {
		font-family: var(--font-mono);
		font-size: 0.86em;
		color: var(--text);
	}
	@media (width >= 48rem) {
		.profile-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
	/* Paper. The fragment carries its own identity block, contacts included, so a
	   print of this page should hand back the résumé rather than the pitch around
	   it. */
	@media print {
		.profile,
		.masthead-blurb,
		.masthead-availability,
		.masthead-actions,
		.document .section-heading,
		.document-note,
		.document-missing {
			display: none;
		}
		.document {
			padding-block: 0;
			border-top: 0;
		}
	}
</style>

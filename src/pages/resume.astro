---
/**
 * The codebam variant does not pitch a résumé: it is omitted from the nav and
 * the sitemap, and the route answers 404 there rather than serving a page
 * titled "Résumé — codebam" that nothing links to.
 */
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import { LinkButton } from '@cloudflare/kumo/components/button';
import { site, yearsBuilding } from '../lib/site';

if (!site.showResume) return Astro.rewrite('/404');

const RESUME_URL = 'https://pub-b1fc9705d9cd4b50885284c3ede52d27.r2.dev/resume.pdf';

const intro = site.intro.replace('{years}', String(yearsBuilding()));
const profile = [
	{
		label: 'Systems',
		copy: 'Rust, TypeScript, NixOS. Daily-driver Linux, Cloudflare Workers at the edge.'
	},
	{
		label: 'Open source',
		copy: 'A Wayland compositor, a Telegram bot framework on Workers, and a pastebin on R2.'
	},
	{
		label: 'Writing',
		copy: 'Linux, containers, NixOS, and the engineering decisions behind software that ships.'
	}
];
---

<Base
	title="Résumé"
	description={`Résumé for ${site.name}, full-stack developer.`}
	ogTitle={`Résumé — ${site.name}`}
>
	<Masthead label="Professional profile" meta="Ontario / Canada">
		<Fragment slot="title">A résumé for <em>building in the open.</em></Fragment>
		<p>Full-stack developer in Ontario. {intro}</p>
		<p class="masthead-actions">
			<LinkButton href={RESUME_URL} variant="primary" size="lg" className="flat-control">
				Download PDF
			</LinkButton>
			<a class="link-quiet" href={`mailto:${site.email}`}>{site.email}</a>
			<a
				class="link-quiet"
				href="https://github.com/codebam"
				target="_blank"
				rel="noopener noreferrer">GitHub</a
			>
		</p>
	</Masthead>

	<section class="profile panel">
		<div class="shell">
			<div class="section-heading" data-reveal>
				<h2 class="display display-lg">Working profile</h2>
				<p>Full-stack / systems / edge</p>
			</div>
			<div class="profile-grid">
				{
					profile.map((item, i) => (
						<article data-reveal data-reveal-delay={i * 55}>
							<h3>{item.label}</h3>
							<p>{item.copy}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="document panel-alt">
		<div class="shell">
			<div class="section-heading" data-reveal>
				<h2 class="display display-lg">Formatted résumé</h2>
				<a class="link-accent" href={RESUME_URL}>Open PDF <span class="arrow">&rarr;</span></a>
			</div>

			<!-- Fixed 8.5×11 ratio so the embed never letterboxes, and it is a plain
			     <object> rather than <embed> so the fallback link actually renders on
			     browsers with no PDF viewer (iOS Safari, most in-app browsers). -->
			<object
				data={RESUME_URL}
				type="application/pdf"
				title={`${site.name} résumé`}
				class="resume-object"
				data-reveal
			>
				<div class="p-8 font-serif text-[var(--body)]">
					<p>Your browser cannot display the PDF inline.</p>
					<p class="mt-2">
						<a class="link-accent" href={RESUME_URL}>Open the résumé &rarr;</a>
					</p>
				</div>
			</object>
		</div>
	</section>
</Base>

<style>
	.profile,
	.document {
		padding-block: clamp(4.5rem, 9vw, 8rem);
		border-top: 1px solid var(--line);
	}
	.section-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 2rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--line-strong);
	}
	.section-heading > p {
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.profile-grid {
		display: grid;
		gap: 2.5rem 0;
		margin-top: clamp(2.5rem, 5vw, 4rem);
	}
	.profile-grid article {
		padding-left: 1.25rem;
		border-left: 1px solid var(--line-strong);
	}
	.profile-grid h3 {
		font-family: var(--font-serif);
		font-size: clamp(1.5rem, 2.5vw, 2rem);
		font-weight: 500;
		letter-spacing: -0.015em;
	}
	.profile-grid p {
		max-width: 48ch;
		margin-top: 0.75rem;
		font-family: var(--font-serif);
		font-size: 1.02rem;
		line-height: 1.65;
		color: var(--body);
	}
	.resume-object {
		display: block;
		width: min(100%, 980px);
		aspect-ratio: 8.5 / 11;
		margin: clamp(2.5rem, 5vw, 4rem) auto 0;
		border: 1px solid var(--line-strong);
		border-radius: 3px;
		background: var(--panel);
	}
	@media (width >= 48rem) {
		.profile-grid {
			grid-template-columns: repeat(3, 1fr);
			gap: 0 3rem;
		}
	}
	@media (width < 48rem) {
		.section-heading {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.75rem;
		}
	}
</style>

---
/**
 * The résumé.
 *
 * The document is inline, in this site's own type, rather than a PDF in a box:
 * an embedded PDF is unreadable on a phone, invisible to a text browser and to
 * anything that indexes the page, and it styles the career in a face the rest
 * of the site never uses. The fragment comes out of R2 — built by CI from
 * resume/resume.md by the same pandoc pass that typesets the PDF, so the two
 * cannot disagree about what 2021 looked like. They differ in exactly two
 * places: the fragment carries classes where the PDF carries LaTeX macros, and
 * its headings start two levels lower so the résumé's sections sit underneath
 * this page's own. The PDF stays one click away for anyone who means to print
 * it or forward it as an attachment.
 *
 * The codebam variant does not pitch a résumé: it is omitted from the nav and
 * the sitemap, and the route answers 404 there rather than serving a page
 * titled "Résumé — codebam" that nothing links to.
 */
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import { LinkButton } from '@cloudflare/kumo/components/button';
import { getResumeFragment, resumePdfFilename } from '../lib/resume';
import { site, yearsBuilding } from '../lib/site';

if (!site.showResume) return Astro.rewrite('/404');

const RESUME_PDF = '/resume.pdf';
const resume = await getResumeFragment();

if (resume && Astro.cache?.enabled) {
	// The object's own upload time is the only truthful last-modified here: this
	// page reads no content out of D1, so EmDash's tags have nothing to say about
	// it. See docs/edge-caching.md.
	Astro.cache.set({ tags: ['resume'], lastModified: resume.updatedAt });
}

const intro = site.intro.replace('{years}', String(yearsBuilding()));
const profile = [
	{
		label: 'Systems',
		copy: 'Rust, TypeScript, NixOS. Daily-driver Linux, Cloudflare Workers at the edge.'
	},
	{
		label: 'Open source',
		copy: 'A Wayland compositor, a Telegram bot framework on Workers, and a pastebin on R2.'
	},
	{
		label: 'Writing',
		copy: 'Linux, containers, NixOS, and the engineering decisions behind software that ships.'
	}
];

/** R2's upload time, phrased for a reader rather than for a log line. */
const updated = resume
	? new Intl.DateTimeFormat('en-CA', { year: 'numeric', month: 'long', day: 'numeric' }).format(
			resume.updatedAt
		)
	: null;
---

<Base
	title="Résumé"
	description={`Résumé for ${site.name}, full-stack developer.`}
	ogTitle={`Résumé — ${site.name}`}
>
	<Masthead label="Professional profile" meta="Ontario / Canada">
		<Fragment slot="title">A résumé for <em>building in the open.</em></Fragment>
		<p class="masthead-blurb">Full-stack developer in Ontario. {intro}</p>
		<p class="masthead-actions">
			<LinkButton
				href={RESUME_PDF}
				download={resumePdfFilename()}
				variant="primary"
				size="lg"
				className="flat-control"
			>
				Download PDF
			</LinkButton>
			<a class="link-quiet" href={`mailto:${site.email}`}>{site.email}</a>
			<a
				class="link-quiet"
				href="https://github.com/codebam"
				target="_blank"
				rel="noopener noreferrer">GitHub</a
			>
		</p>
	</Masthead>

	<section class="profile panel">
		<div class="shell">
			<div class="section-heading" data-reveal>
				<h2 class="display display-lg">Working profile</h2>
				<p>Full-stack / systems / edge</p>
			</div>
			<div class="profile-grid">
				{
					profile.map((item, i) => (
						<article data-reveal data-reveal-delay={i * 55}>
							<h3>{item.label}</h3>
							<p>{item.copy}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="document panel-alt">
		<div class="shell">
			<div class="section-heading" data-reveal>
				<h2 class="display display-lg">The document</h2>
				<a class="link-accent" href={RESUME_PDF} download={resumePdfFilename()}>
					Download the PDF <span class="arrow">&rarr;</span>
				</a>
			</div>
			{
				updated && (
					<p class="document-note">Typeset from the same source as the PDF · updated {updated}</p>
				)
			}

			{
				resume ? (
					<Fragment set:html={resume.html} />
				) : (
					/* The bucket has no fragment in it: a fresh clone with an empty dev
					   store, or a build that uploaded nothing. Said out loud rather than
					   left as a hole where the résumé should be. */
					<div class="document-missing">
						<p>
							The inline copy is not available on this build of the site. The PDF is, and it is the
							same document.
						</p>
						<p>
							Locally: <code>npm run resume</code> then <code>npm run resume:seed</code>.
						</p>
						<p>
							<a class="link-accent" href={RESUME_PDF} download={resumePdfFilename()}>
								Download the PDF &rarr;
							</a>
						</p>
					</div>
				)
			}
		</div>
	</section>
</Base>

<style>
	.profile,
	.document {
		padding-block: clamp(4.5rem, 9vw, 8rem);
		border-top: 1px solid var(--line);
	}
	.section-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 2rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--line-strong);
	}
	.section-heading > p {
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
	}
	/* The one line under a heading that is a sentence rather than an eyebrow: it
	   sits below the rule, in the body's own voice, at the width of the column it
	   describes. */
	.document-note {
		max-width: 46rem;
		margin: 1rem auto 0;
		font-family: var(--font-sans);
		font-size: 0.78rem;
		letter-spacing: 0.04em;
		color: var(--muted);
	}
	.profile-grid {
		display: grid;
		gap: 2.5rem 0;
		margin-top: clamp(2.5rem, 5vw, 4rem);
	}
	.profile-grid article {
		padding-left: 1.25rem;
		border-left: 1px solid var(--line-strong);
	}
	.profile-grid h3 {
		font-family: var(--font-serif);
		font-size: clamp(1.5rem, 2.5vw, 2rem);
		font-weight: 500;
		letter-spacing: -0.015em;
	}
	.profile-grid p {
		max-width: 48ch;
		margin-top: 0.75rem;
		font-family: var(--font-serif);
		font-size: 1.02rem;
		line-height: 1.65;
		color: var(--body);
	}
	.document-missing {
		max-width: 46rem;
		margin: clamp(2.5rem, 5vw, 4rem) auto 0;
		padding: 1.5rem 1.75rem;
		border: 1px solid var(--line-strong);
		border-radius: 3px;
		background: var(--panel);
		font-family: var(--font-serif);
		color: var(--body);
	}
	.document-missing p + p {
		margin-top: 0.85rem;
	}
	.document-missing code {
		font-family: var(--font-mono);
		font-size: 0.86em;
		color: var(--text);
	}
	@media (width >= 48rem) {
		.profile-grid {
			grid-template-columns: repeat(3, 1fr);
			gap: 0 3rem;
		}
	}
	@media (width < 48rem) {
		.section-heading {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.75rem;
		}
	}
	/* Paper. The fragment carries its own identity block, contacts included, so a
	   print of this page should hand back the résumé rather than the pitch around
	   it. The PDF is still the better artifact; this is for the reader who hits
	   ⌘P anyway. */
	@media print {
		.profile,
		.masthead-blurb,
		.masthead-actions,
		.document .section-heading,
		.document-note,
		.document-missing {
			display: none;
		}
		.document {
			padding-block: 0;
			border-top: 0;
		}
	}
</style>

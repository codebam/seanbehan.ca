---
/**
 * The frame every page renders into: head metadata, header, footer.
 *
 * EmDash owns canonical, social and structured metadata so plugin contributions
 * and the site's defaults are deduplicated before they reach the document. The
 * EmDash pieces — EmDashHead, EmDashBodyStart, EmDashBodyEnd — carry the admin
 * bar, visual editing and whatever the installed plugins contribute.
 *
 * The header is a compact sticky bar: the name on the left, the section links
 * and one call to action on the right. It replaces the oversized centred
 * nameplate the site used to carry, which pushed the first screen of every
 * page below the fold and left the nav as the smallest type on the page.
 */
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from 'emdash/ui';
import { createPublicPageContext } from 'emdash/page';
import {
	site,
	absolute,
	canonicalUrl,
	codebamHref,
	linkHref,
	writingHref,
	LINKEDIN_URL
} from '../lib/site';
import SiblingMark from '../components/SiblingMark.astro';
import type { PostSummary } from '../lib/types';
import '../styles/app.css';

interface Props {
	/** Page <title>. The site name is appended unless it is already there. */
	title?: string;
	description?: string;
	/** og:title / twitter:title, where it differs from the page title. */
	ogTitle?: string;
	ogDescription?: string;
	/** Set on a post page; drives the article metadata and the canonical rule. */
	post?: PostSummary;
	image?: string;
	robots?: string;
	canonical?: string;
	/** Content reference, so plugins and visual editing can find the entry. */
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	description,
	ogTitle,
	ogDescription,
	post,
	image,
	robots,
	canonical: canonicalOverride,
	content
} = Astro.props;

const path = Astro.url.pathname;
const currentYear = new Date().getFullYear();
const isHome = path === '/';

const fullTitle = title
	? title.includes(site.name)
		? title
		: `${title} — ${site.name}`
	: site.title;

const canonical =
	canonicalOverride ?? canonicalUrl(path, { post: Boolean(post), draft: post?.meta.draft });
const metaDescription =
	post?.meta.description ?? post?.meta.title ?? description ?? site.description;
const socialTitle = post ? post.meta.title : (ogTitle ?? title ?? site.ogTitle);
const socialDescription = post
	? metaDescription
	: (ogDescription ?? description ?? site.ogDescription);

/**
 * A post gets the card generated for it by tools/og, unless it names an image
 * of its own. Everything else uses the site card, not the author photo: a
 * 460px headshot is the wrong aspect for a large-image preview.
 */
const ogImage = image
	? absolute(image)
	: absolute(post ? (post.meta.image ?? `/og/${post.slug}.png`) : '/og/site.png');

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? 'content' : 'custom',
	pageType: post ? 'article' : 'website',
	title: fullTitle,
	pageTitle: socialTitle,
	description: metaDescription,
	canonical,
	image: ogImage,
	content,
	seo: {
		ogTitle: socialTitle,
		ogDescription: socialDescription,
		ogImage,
		robots: robots ?? (post?.meta.draft ? 'noindex, nofollow' : undefined)
	},
	articleMeta: post
		? {
				publishedTime: post.meta.date,
				modifiedTime: post.meta.updated ?? null,
				author: site.name
			}
		: undefined,
	siteName: site.name,
	siteUrl: site.url
});

/** The nav is the variant's own list, resolved against origins here. */
const nav = site.nav.map((item) => ({ ...item, href: linkHref(item) }));

/** A cross-origin nav item cannot be current on this page. */
const isCurrent = (href: string) =>
	href.startsWith('/') && !href.startsWith('/#') && (path === href || path.startsWith(`${href}/`));

/**
 * "Where am I" for the header. The nav's `/#work` entry used to be marked
 * current on the home page as well, which gave a screen reader two current
 * items — the brand's `page` and this one's `true` — and claimed the reader
 * was at the Work section while they were still at the top of the page, since
 * nothing here tracks the scroll position. A section anchor is not a location.
 */
const navItems = nav.map((item) => ({
	...item,
	current: isCurrent(item.href) ? ('page' as const) : undefined
}));
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>

		<link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
		<link
			rel="preload"
			href="/fonts/newsreader-latin.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>

		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b1220" />

		<meta property="og:locale" content="en_CA" />
		<meta property="og:image:alt" content={post ? post.meta.title : site.name} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:site" content="@seanwbehan" />
		{post && <meta name="twitter:creator" content="@seanwbehan" />}
		{post?.meta.tags.map((tag) => (
			<meta property="article:tag" content={tag} />
		))}
		<link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />
		<link rel="describedby" href="/llms.txt" />
		<link
			rel="alternate"
			type="application/rss+xml"
			title="RSS Feed"
			href={writingHref('/rss.xml')}
		/>
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />

		<slot name="head" />

		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />

		<a href="#main" class="skip-link">
			Skip to content
		</a>

		<header class="site-header">
			<div class="shell header-inner">
				<a href="/" class="brand" aria-current={isHome ? 'page' : undefined}>
					{site.name}
					<span class="brand-dot" aria-hidden="true">
						.
					</span>
				</a>

				<nav class="site-nav" aria-label="Primary">
					{navItems.map((item) => (
						<a href={item.href} class="nav-link" aria-current={item.current}>
							{item.label}
							<SiblingMark href={item.href} />
						</a>
					))}
				</nav>

				<a
					href="/contact"
					class="btn header-cta"
					aria-current={isCurrent('/contact') ? 'page' : undefined}
				>
					Get in touch
				</a>

				<details class="nav-menu">
					<summary class="nav-toggle">
						<span class="sr-only">Menu</span>
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							aria-hidden="true"
						>
							<path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
						</svg>
					</summary>
					<div class="nav-menu-panel">
						<nav aria-label="Mobile" class="nav-menu-links">
							{navItems.map((item) => (
								<a href={item.href} class="nav-link" aria-current={item.current}>
									{item.label}
									<SiblingMark href={item.href} />
								</a>
							))}
						</nav>
						<a href="/contact" class="btn nav-menu-cta">
							Get in touch
						</a>
					</div>
				</details>
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="panel-invert site-footer">
			<div class="shell footer-grid">
				<div class="footer-brand">
					<p class="footer-wordmark">
						{site.name}
						<span aria-hidden="true">.</span>
					</p>
					<p class="footer-copy">{site.ogDescription}</p>
				</div>

				<nav aria-label="Site">
					<p class="eyebrow footer-label">Site</p>
					<ul class="footer-links" role="list">
						<li>
							<a class="footer-link" href="/about">
								About
							</a>
						</li>
						<li>
							<a class="footer-link" href="/#work">
								Work
							</a>
						</li>
						{site.showResume && (
							<li>
								<a class="footer-link" href="/resume">
									Résumé
								</a>
							</li>
						)}
						<li>
							<a class="footer-link" href={writingHref('/posts')}>
								Writing
								<SiblingMark href={writingHref('/posts')} />
							</a>
						</li>
						<li>
							<a class="footer-link" href={codebamHref('/services')}>
								Services
								<SiblingMark href={codebamHref('/services')} />
							</a>
						</li>
						<li>
							<a class="footer-link" href="/links">
								Links
							</a>
						</li>
					</ul>
				</nav>

				<nav aria-label="Legal">
					<p class="eyebrow footer-label">Legal</p>
					<ul class="footer-links" role="list">
						<li>
							<a class="footer-link" href={codebamHref('/legal/privacy')}>
								Privacy
								<SiblingMark href={codebamHref('/legal/privacy')} />
							</a>
						</li>
						<li>
							<a class="footer-link" href={codebamHref('/legal/terms-of-sale')}>
								Terms
								<SiblingMark href={codebamHref('/legal/terms-of-sale')} />
							</a>
						</li>
						<li>
							<a class="footer-link" href={codebamHref('/legal/refund-policy')}>
								Refunds
								<SiblingMark href={codebamHref('/legal/refund-policy')} />
							</a>
						</li>
						<li>
							<a class="footer-link" href={codebamHref('/legal/product-license')}>
								License
								<SiblingMark href={codebamHref('/legal/product-license')} />
							</a>
						</li>
					</ul>
				</nav>

				<nav aria-label="Elsewhere">
					<p class="eyebrow footer-label">Elsewhere</p>
					<ul class="footer-links" role="list">
						<li>
							<a
								class="footer-link"
								href="https://github.com/codebam"
								target="_blank"
								rel="me noopener noreferrer"
							>
								GitHub
								<SiblingMark href="https://github.com/codebam" newTab />
							</a>
						</li>
						{site.showResume && (
							<li>
								<a
									class="footer-link"
									href={LINKEDIN_URL}
									target="_blank"
									rel="me noopener noreferrer"
								>
									LinkedIn
									<SiblingMark href={LINKEDIN_URL} newTab />
								</a>
							</li>
						)}
						<li>
							<a
								class="footer-link"
								href="https://mstdn.ca/@codebam"
								target="_blank"
								rel="me noopener noreferrer"
							>
								Mastodon
								<SiblingMark href="https://mstdn.ca/@codebam" newTab />
							</a>
						</li>
						<li>
							<a class="footer-link" href={writingHref('/rss.xml')}>
								RSS
								<SiblingMark href={writingHref('/rss.xml')} />
							</a>
						</li>
						<li>
							<a class="footer-link" href={`mailto:${site.email}`}>
								{site.email}
							</a>
						</li>
					</ul>
				</nav>
			</div>

			<div class="shell footer-base">
				<span>
					&copy; {currentYear} {site.name}
				</span>
				<span>Built with EmDash, hosted on Cloudflare</span>
			</div>
		</footer>

		<EmDashBodyEnd page={pageCtx} />

		<script>
			import '../scripts/reveal';
		</script>
	</body>
</html>

<style>
	/* ── Header ──
	   Sticky, translucent, and one row tall. The name is the only brand mark;
	   the nav is a plain row of links with a single accent button, so the way
	   in is obvious from any page. */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: color-mix(in srgb, var(--bg) 88%, transparent);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--line);
	}
	.header-inner {
		display: flex;
		align-items: center;
		gap: 1rem;
		min-height: 4rem;
	}
	.brand {
		display: inline-flex;
		align-items: baseline;
		margin-right: auto;
		font-size: 1.125rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--text);
		transition: color 0.2s ease;
	}
	.brand:hover {
		color: var(--accent);
	}
	.brand-dot {
		color: var(--accent-warm);
	}

	.site-nav {
		display: none;
		align-items: center;
		gap: 0.125rem;
	}
	.nav-link {
		display: inline-flex;
		align-items: center;
		gap: 0.2rem;
		padding: 0.5rem 0.75rem;
		border-radius: var(--radius-sm);
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--body);
		transition:
			background 0.2s ease,
			color 0.2s ease;
	}
	.nav-link:hover {
		background: var(--surface-alt);
		color: var(--text);
	}
	.nav-link[aria-current='page'],
	.nav-link[aria-current='true'] {
		color: var(--text);
		background: var(--surface-alt);
	}
	.header-cta {
		display: none;
	}

	.nav-menu {
		position: relative;
	}
	.nav-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		border: 1px solid var(--line-strong);
		border-radius: var(--radius-sm);
		color: var(--text);
		cursor: pointer;
		list-style: none;
	}
	.nav-toggle::-webkit-details-marker {
		display: none;
	}
	.nav-toggle svg {
		width: 1.25rem;
		height: 1.25rem;
	}
	.nav-menu[open] .nav-toggle {
		border-color: var(--accent);
		color: var(--accent);
	}
	.nav-menu-panel {
		position: absolute;
		top: calc(100% + 0.75rem);
		right: 0;
		width: min(18rem, calc(100vw - 2.5rem));
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding: 0.75rem;
		background: var(--panel);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		box-shadow: var(--shadow-md);
	}
	.nav-menu-links {
		display: flex;
		flex-direction: column;
	}
	.nav-menu .nav-link {
		width: 100%;
		padding: 0.6rem 0.75rem;
		font-size: 1rem;
	}
	.nav-menu-cta {
		width: 100%;
		margin-top: 0.25rem;
	}

	@media (width >= 56rem) {
		.site-nav {
			display: flex;
		}
		.header-cta {
			display: inline-flex;
		}
		.nav-menu {
			display: none;
		}
	}

	/* ── Footer ── */
	.site-footer {
		margin-top: auto;
	}
	.footer-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2.5rem 2rem;
		padding-block: clamp(3rem, 6vw, 4.5rem) 2.5rem;
	}
	@media (width >= 48rem) {
		.footer-grid {
			grid-template-columns: minmax(0, 1.5fr) repeat(3, minmax(0, 1fr));
		}
	}
	.footer-brand {
		grid-column: 1 / -1;
	}
	@media (width >= 48rem) {
		.footer-brand {
			grid-column: auto;
		}
	}
	.footer-wordmark {
		font-size: 1.2rem;
		font-weight: 700;
		letter-spacing: -0.02em;
	}
	.footer-wordmark span {
		color: var(--accent-warm);
	}
	.footer-copy {
		max-width: 34ch;
		margin-top: 0.75rem;
		font-size: 0.9rem;
		line-height: 1.6;
		color: var(--footer-muted);
	}
	/* The footer's own eyebrow: .eyebrow carries the type, and --muted resolves
	   to --footer-muted inside .panel-invert, so only the spacing is local. */
	.footer-label {
		margin-bottom: 0.9rem;
	}
	/* Lists, not a column of loose anchors: a screen reader gets "list, 6 items"
	   and can jump list to list, and none of the layout changes for it. */
	.footer-links {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.55rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.footer-link {
		font-size: 0.9rem;
		color: var(--footer-text);
		transition: color 0.2s ease;
	}
	.footer-link:hover {
		color: var(--accent);
	}
	.footer-base {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem 2rem;
		padding-block: 1.25rem;
		border-top: 1px solid var(--footer-line);
		font-size: 0.82rem;
		color: var(--footer-muted);
	}

	/* Clipped rather than parked off-left: some screen readers still announce
	   content at left: -9999px, and overflow:hidden parents can clip the focus
	   target. Visible only once focused. */
	.skip-link {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		clip-path: inset(50%);
		white-space: nowrap;
		border: 0;
	}
	.skip-link:focus {
		left: 1rem;
		top: 1rem;
		z-index: 100;
		width: auto;
		height: auto;
		margin: 0;
		overflow: visible;
		clip: auto;
		clip-path: none;
		white-space: normal;
		background: var(--panel);
		color: var(--text);
		border: 1px solid var(--line-strong);
		border-radius: var(--radius-sm);
		padding: 0.6rem 1rem;
		font-size: 0.9rem;
		box-shadow: var(--shadow-md);
	}
</style>

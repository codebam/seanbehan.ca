---
/**
 * The frame every page renders into: head metadata, header, footer.
 *
 * Ported from the SvelteKit layout, and it keeps that file's decisions. EmDash
 * owns canonical, social and structured metadata so plugin contributions and
 * the site's defaults are deduplicated before they reach the document.
 *
 * The EmDash pieces — EmDashHead, EmDashBodyStart, EmDashBodyEnd — carry the
 * admin bar, visual editing and whatever the installed plugins contribute.
 * They stay, and the site's own <meta> tags are written alongside them.
 */
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from 'emdash/ui';
import { createPublicPageContext } from 'emdash/page';
import { LinkButton } from '@cloudflare/kumo/components/button';
import { site, absolute, canonicalUrl, writingHref } from '../lib/site';
import type { PostSummary } from '../lib/types';
import '../styles/app.css';

interface Props {
	/** Page <title>. The site name is appended unless it is already there. */
	title?: string;
	description?: string;
	/** og:title / twitter:title, where it differs from the page title. */
	ogTitle?: string;
	ogDescription?: string;
	/** Set on a post page; drives the article metadata and the canonical rule. */
	post?: PostSummary;
	image?: string;
	robots?: string;
	canonical?: string;
	/** Content reference, so plugins and visual editing can find the entry. */
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	description,
	ogTitle,
	ogDescription,
	post,
	image,
	robots,
	canonical: canonicalOverride,
	content
} = Astro.props;

const path = Astro.url.pathname;
const currentYear = new Date().getFullYear();

const fullTitle = title
	? title.includes(site.name)
		? title
		: `${title} — ${site.name}`
	: site.title;

const canonical =
	canonicalOverride ?? canonicalUrl(path, { post: Boolean(post), draft: post?.meta.draft });
const metaDescription =
	post?.meta.description ?? post?.meta.title ?? description ?? site.description;
const socialTitle = post ? post.meta.title : (ogTitle ?? title ?? site.ogTitle);
const socialDescription = post
	? metaDescription
	: (ogDescription ?? description ?? site.ogDescription);

/**
 * A post gets the card generated for it by tools/og, unless it names an image
 * of its own. Everything else uses the site card, not the author photo: a
 * 460px headshot is the wrong aspect for a large-image preview.
 */
const ogImage = image
	? absolute(image)
	: absolute(post ? (post.meta.image ?? `/og/${post.slug}.png`) : '/og/site.png');

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? 'content' : 'custom',
	pageType: post ? 'article' : 'website',
	title: fullTitle,
	pageTitle: socialTitle,
	description: metaDescription,
	canonical,
	image: ogImage,
	content,
	seo: {
		ogTitle: socialTitle,
		ogDescription: socialDescription,
		ogImage,
		robots: robots ?? (post?.meta.draft ? 'noindex, nofollow' : undefined)
	},
	articleMeta: post
		? {
				publishedTime: post.meta.date,
				modifiedTime: post.meta.updated ?? null,
				author: site.name
			}
		: undefined,
	siteName: site.name,
	siteUrl: site.url
});

/** The two variants share a frame but send writing to its canonical origin. */
const nav = site.showResume
	? [
			{ href: writingHref('/posts'), label: 'Writing' },
			{ href: '/links', label: 'Links' },
			{ href: '/resume', label: 'Résumé' }
		]
	: [
			{ href: writingHref('/posts'), label: 'Writing' },
			{ href: '/links', label: 'Links' }
		];

/** A cross-origin nav item cannot be current on this page. */
const isCurrent = (href: string) =>
	href.startsWith('/') && (path === href || path.startsWith(`${href}/`));
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>

		<!-- The three faces the page can paint with, ahead of the stylesheet that
		     names them: app.css is inlined into the document, but a preload still
		     starts the fetch before the parser reaches the @font-face rules. -->
		<link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
		<link
			rel="preload"
			href="/fonts/newsreader-latin.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>

		<!-- EmDashHead owns canonical, description, social metadata and the
		     primary JSON-LD graph. The fields below supplement rather than repeat it. -->
		<meta property="og:locale" content="en_CA" />
		<meta property="og:image:alt" content={post ? post.meta.title : site.name} />
		<!-- Generated cards are all 1200×630, including the site card. -->
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:site" content="@seanwbehan" />
		{post && <meta name="twitter:creator" content="@seanwbehan" />}
		{post?.meta.tags.map((tag) => <meta property="article:tag" content={tag} />)}
		<link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />
		<link
			rel="alternate"
			type="application/rss+xml"
			title="RSS Feed"
			href={writingHref('/rss.xml')}
		/>
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />

		<!-- A page with head markup of its own — a tag's feed link, say — puts it here. -->
		<slot name="head" />

		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />

		<a href="#main" class="skip-link">Skip to content</a>

		<header class="border-b border-[var(--line)]">
			<div class="site-header shell flex items-center gap-6 py-5 md:py-6">
				<a
					href="/"
					class="wordmark display mr-auto text-[1.2rem] whitespace-nowrap"
					aria-current={path === '/' ? 'page' : undefined}
				>
					{site.name}
				</a>

				<nav aria-label="Primary" class="primary-nav flex items-center gap-5 md:gap-6">
					<!-- Hash link into the home page. aria-current is "true" rather than
					     "page": the destination is a section of the current page, not the
					     page itself. -->
					<a
						href="/#work"
						class="nav-link text-sm md:text-[0.95rem]"
						aria-current={path === '/' ? 'true' : undefined}>Work</a
					>
					{
						nav.map((item) => (
							<a
								href={item.href}
								class="nav-link text-sm md:text-[0.95rem]"
								aria-current={isCurrent(item.href) ? 'page' : undefined}
							>
								{item.label}
							</a>
						))
					}
					<LinkButton
						href="/contact"
						variant="outline"
						size="sm"
						className="blueprint-control shrink-0 max-sm:hidden"
					>
						Get in touch
					</LinkButton>
					<a href="/contact" class="nav-link text-sm sm:hidden">Contact</a>
				</nav>
			</div>
		</header>

		<!-- Full-bleed: each page owns its own panels and .shell columns, so a
		     section can run edge to edge on its own background. -->
		<main id="main">
			<slot />
		</main>

		<footer class="panel-invert">
			<div
				class="shell flex flex-wrap items-center gap-x-6 gap-y-3 py-10 text-sm text-[var(--muted)] md:py-12"
			>
				<span>&copy; {currentYear} {site.name}</span>
				<a class="footer-link" href="/about">About</a>
				<a class="footer-link" href={writingHref('/rss.xml')}>RSS</a>
				<a
					class="footer-link"
					href="https://github.com/codebam"
					target="_blank"
					rel="me noopener noreferrer">GitHub</a
				>
				<a
					class="footer-link"
					href="https://mstdn.ca/@codebam"
					target="_blank"
					rel="me noopener noreferrer">Mastodon</a
				>
				<a class="footer-link" href={`mailto:${site.email}`}>{site.email}</a>
				<!-- Colour inherited from the row: --dim failed AA here (3.3:1 against
				     the inverted panel) and is no longer used for type. -->
				<span class="ml-auto">Built with EmDash, hosted on Cloudflare</span>
			</div>
		</footer>

		<EmDashBodyEnd page={pageCtx} />

		<script>
			import '../scripts/interactions';
			import '../scripts/reveal';
			import '../scripts/spotlight';
		</script>
	</body>
</html>

<style>
	@media (width < 40rem) {
		.site-header {
			flex-wrap: wrap;
			row-gap: 1rem;
		}
		.primary-nav {
			width: 100%;
			justify-content: space-between;
			gap: 0.5rem;
		}
	}

	/* Nav and footer links carry the same underline wipe as `.link-quiet`: it
	   grows from the left on hover and retracts to the left on the way out, so
	   the label itself never shifts and the row height never changes. */
	.nav-link {
		position: relative;
		color: var(--muted);
		transition: color 0.2s ease;
	}
	.nav-link::after,
	.footer-link::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -4px;
		height: 1px;
		background: currentColor;
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.28s var(--ease-out-soft);
	}
	.nav-link:hover,
	.footer-link:hover {
		color: var(--accent);
	}
	.nav-link:hover::after,
	.nav-link:focus-visible::after,
	.footer-link:hover::after,
	.footer-link:focus-visible::after {
		transform: scaleX(1);
	}
	/* Current section stays legible without a heavier weight shifting layout */
	.nav-link[aria-current='page'],
	.nav-link[aria-current='true'] {
		color: var(--text);
	}
	/* The current page keeps its rule up permanently, in the accent, so hover
	   state and location state never look like the same thing. */
	.nav-link[aria-current='page']::after,
	.nav-link[aria-current='true']::after {
		background: var(--accent);
		transform: scaleX(1);
	}

	.footer-link {
		position: relative;
		color: var(--muted);
		transition: color 0.2s ease;
	}

	/* The wordmark's own small flourish: the accent dot after the name grows in
	   on hover. Cheap, and it makes the home link feel like a target. */
	.wordmark {
		position: relative;
		transition: color 0.2s ease;
	}
	.wordmark::after {
		content: '';
		display: inline-block;
		width: 5px;
		height: 5px;
		margin-left: 4px;
		border-radius: 999px;
		background: var(--accent);
		transform: scale(0);
		transition: transform 0.3s var(--ease-out-soft);
	}
	.wordmark:hover::after,
	.wordmark:focus-visible::after,
	.wordmark[aria-current='page']::after {
		transform: scale(1);
	}

	/* Clipped rather than parked off-left: some screen readers still announce
	   content at left: -9999px, and overflow:hidden parents can clip the focus
	   target. Visible only once focused. */
	.skip-link {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		clip-path: inset(50%);
		white-space: nowrap;
		border: 0;
	}
	.skip-link:focus {
		left: 0;
		top: 0;
		z-index: 50;
		width: auto;
		height: auto;
		margin: 0;
		overflow: visible;
		clip: auto;
		clip-path: none;
		white-space: normal;
		background: var(--panel);
		color: var(--text);
		border: 1px solid var(--line-strong);
		border-radius: 0 0 8px 0;
		padding: 0.6rem 1rem;
		font-size: 0.9rem;
	}
</style>

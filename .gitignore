node_modules

# Build output
dist
.astro
/build

# OS
.DS_Store
Thumbs.db

# Env / secrets
.env
.env.*
!.env.example
!.env.test
.dev.vars
.dev.vars.*
!.dev.vars.example

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Local CMS state: the SQLite file the CLI's local commands use, the miniflare
# stores `astro dev` binds D1/R2/KV to, and anything uploaded through the admin
# while developing. Production content lives in D1, not here.
data.db
data.db-*
uploads
.wrangler

# The EmDash CLI's local install (its node_modules); not content or config.
.emdash/

# Generated by scripts/import-markdown.mjs; the ids in it are per-database.
scripts/out

# direnv
.direnv/

# Local git worktrees. One was once committed as a bare gitlink with no
# .gitmodules entry, which made every fresh clone fail on `git submodule`.
.worktrees/

# Paid release artifacts stay local and are uploaded directly to the storefront.
/releases/

# Favicon build intermediates: the rendered pages and the raster set the script
# assembles before it is copied into public/.
tools/favicon/_icon-*.html
tools/favicon/out/

# search index
.zvec-grep/

# Pi agent session artifacts (per-run task state and logs)
.pi/

{
  "name": "seanbehan-ca-emdash",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "emdash": {
    "label": "Blog",
    "seed": "seed/seed.json"
  },
  "scripts": {
    "dev": "emdash dev",
    "build": "astro build",
    "build:codebam": "PUBLIC_SITE=codebam astro build",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "deploy:codebam": "PUBLIC_SITE=codebam astro build && wrangler deploy --name codebam-ca",
    "check": "astro check",
    "test": "vitest",
    "test:run": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "types": "emdash types",
    "import:markdown": "node scripts/import-markdown.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.0.0",
    "@astrojs/react": "^6.0.0",
    "@astrojs/svelte": "^9.0.1",
    "@cf-wasm/og": "^0.5.0",
    "@emdash-cms/cloudflare": "^0.30.0",
    "@emdash-cms/plugin-forms": "^0.2.4",
    "@emdash-cms/plugin-webhook-notifier": "^0.2.0",
    "@portabletext/to-html": "^6.0.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.0.0",
    "emdash": "^0.30.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shiki": "^4.4.3",
    "svelte": "^5.56.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.7",
    "@cloudflare/workers-types": "^5.20260820.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.99.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260820.1": true,
    "better-sqlite3@12.11.1": true
  }
}

---
/** The archive: every published post, with search over the rendered list. */
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import PostSearch from '../../components/PostSearch.astro';
import { getPosts } from '../../lib/posts';
import { site } from '../../lib/site';

const { posts, cacheHint } = await getPosts();
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Base
	title="Writing"
	description="Posts on Linux, NixOS, Rust, and Cloudflare Workers."
	ogTitle={`Writing — ${site.name}`}
>
	<section class="panel pt-14 pb-20 md:pt-16 md:pb-24">
		<div class="shell">
			<p class="enter eyebrow">{posts.length} posts</p>
			<h1 class="display display-xl mt-5">Writing</h1>
			<p
				class="enter mt-6 max-w-[52ch] text-[1.15rem] leading-[1.55] text-[var(--body)] md:text-[1.3rem]"
			>
				Notes from whatever I am taking apart — Linux and NixOS, containers and systemd, Rust, and
				the edge.
			</p>

			<!-- The tag index used to be reachable only from an individual tag page,
			     which left it orphaned from the one page a reader starts on. -->
			<p class="enter link-accent mt-6" style="--enter-delay:120ms">
				<a href="/posts/tags" class="hover:underline">Browse by tag &rarr;</a>
			</p>

			<div class="mt-12" data-reveal>
				<PostSearch />
				<!-- Paired columns on desktop, like the home page's list: a single
				     column hugging the left of the shell leaves the right half of a wide
				     window dead, and the component already collapses to one column under
				     48rem. -->
				<PostList posts={posts} columns={2} showTags headingLevel={2} />
			</div>
		</div>
	</section>
</Base>

---
/**
 * A CMS page: anything written in the admin that is not a post.
 *
 * The site's own pages — home, contact, the résumé — are templates, because
 * they are layout more than they are prose. This route is what makes it
 * possible to add a page without a deploy, and it renders in the same reading
 * column a post does.
 */
import { getEmDashEntry, decodeSlug } from 'emdash';
import { PortableText } from 'emdash/ui';
import Base from '../../layouts/Base.astro';
import Block from '../../components/portable-text/Block.astro';
import Code from '../../components/portable-text/Code.astro';
import { prepareBody } from '../../lib/posts';

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite('/404');

const { entry: page, cacheHint } = await getEmDashEntry('pages', slug);
if (!page) return Astro.rewrite('/404');
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const { blocks } = prepareBody(page.data.content);
---

<Base title={page.data.title} content={{ collection: 'pages', id: page.data.id, slug }}>
	<article class="panel pt-14 pb-20 md:pt-16">
		<div class="shell">
			<header class="enter border-b border-[var(--line)] pb-10">
				<h1 class="display mt-5 max-w-[24ch] text-[2.4rem] md:text-[3.4rem]" {...page.edit.title}>
					{page.data.title}
				</h1>
			</header>

			<div
				class="enter prose mt-12 max-w-[68ch] text-[1.05rem]"
				style="--enter-delay:60ms"
				data-prose
			>
				<PortableText value={blocks} components={{ block: Block, type: { code: Code } }} />
			</div>
		</div>
	</article>

	<script>
		import '../../scripts/copy-code';
	</script>
</Base>

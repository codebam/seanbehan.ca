---
import Base from '../layouts/Base.astro';
---

<Base title="404" description="That page is not here.">
	<section class="panel shell flex min-h-[55vh] flex-col justify-center py-20">
		<p class="eyebrow">Error 404</p>
		<h1 class="display display-xl mt-5 max-w-[18ch]">That page is not here.</h1>
		<p class="mt-4 max-w-[50ch] text-[1.05rem] text-[var(--body)]">
			The link may be old, or the page may never have existed.
		</p>
		<p class="mt-8 flex flex-wrap gap-x-6 gap-y-3">
			<a href="/" class="btn">Back home</a>
			<a href="/posts" class="link-quiet self-center">Read the writing</a>
		</p>
	</section>
</Base>

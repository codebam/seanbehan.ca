#!/bin/sh
# Runs ESLint and Prettier over staged files before they're committed.
#
# CI runs `prettier --check . && eslint .` on every push and it went red for
# five commits straight before anyone noticed. Doing the same work at commit
# time keeps it green without anyone having to remember `npm run lint`.
#
# lint-staged does the work: it stashes unstaged changes first, so the tools
# only ever rewrite what's in the index, then re-stages the results. Your
# half-finished working-tree edits are restored untouched afterward.
#
# It also touches staged files only, so pre-existing drift in files you didn't
# touch stays out of your commit. The globs and commands live under
# "lint-staged" in package.json, split into two non-overlapping groups:
# lint-staged runs globs concurrently, so letting two of them write the same
# file would race. Code files get `eslint --fix` then `prettier --write` in
# sequence; everything else gets Prettier alone.
#
# Note that the commit records the fixed version, which is not byte-for-byte
# what you staged. Run `git diff HEAD` after committing to see what changed.
#
# Installed by the `prepare` npm script, which points core.hooksPath here.
# Bypass a single commit with `git commit --no-verify`.

if ! npx lint-staged; then
	echo
	echo "ESLint or Prettier could not fix the staged files automatically —"
	echo "usually a syntax error or a lint rule with no autofix."
	echo "Fix what it reported above and commit again."
	echo
	echo "To bypass this check: git commit --no-verify"
	exit 1
fi

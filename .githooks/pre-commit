#!/bin/sh
# Blocks a commit whose staged files aren't Prettier-clean.
#
# CI runs `prettier --check .` on every push and it went red for five commits
# straight before anyone noticed. Catch it at commit time instead.
#
# lint-staged does the work: it stashes unstaged changes first, so Prettier
# judges exactly what's in the index. A plain `prettier --check <staged paths>`
# reads the working tree instead, which gives a stale verdict whenever you
# stage a hunk with `git add -p` and keep editing.
#
# It also checks staged files only, so pre-existing drift in files you didn't
# touch won't block unrelated work. The file globs and command live under
# "lint-staged" in package.json.
#
# Installed by the `prepare` npm script, which points core.hooksPath here.
# Bypass a single commit with `git commit --no-verify`.

if ! npx lint-staged; then
	echo
	echo "Prettier check failed. Fix with:"
	echo "    npm run format"
	echo "then re-stage the files and commit again."
	echo
	echo "To bypass this check: git commit --no-verify"
	exit 1
fi
